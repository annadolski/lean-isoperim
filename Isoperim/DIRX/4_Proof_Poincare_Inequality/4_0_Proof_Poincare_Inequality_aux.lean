/-! ### The function $\mathrm J=\mathrm J_{w_1}$ -/

/-- $w_1=\frac{29}{32}>0$. -/
theorem poincareX_w₁_eq : w₁ = 29 / 32 := rfl

/-- $J_{w_1}(\frac12)>0$. -/
theorem poincareX_H_pos : 0 < gJw w₁ 2⁻¹ :=
  gJw_pos (by rw [poincareX_w₁_eq]; norm_num) ⟨by rw [poincareX_w₁_eq]; norm_num, by norm_num⟩

/-- $\mathrm J(x)=J_{w_1}(x)/(2J_{w_1}(\frac12))$ (with $J_w$ = `gJw w` of [DIR], §3). -/
theorem poincareX_JX_eq (x : ℝ) : JX x = gJw w₁ x / (2 * gJw w₁ 2⁻¹) := by
  have hI : I = gProf := rfl
  have hw : (0 : ℝ) < w₁ := by rw [poincareX_w₁_eq]; norm_num
  have hp : 0 < gProf (w₁⁻¹ * (1 - 2⁻¹)) := by
    have := poincareX_H_pos
    rw [gJw] at this
    exact pos_of_mul_pos_right this (by positivity)
  simp only [JX, JXw, gJw, hI]
  rw [show (2 * w₁)⁻¹ = w₁⁻¹ * (1 - 2⁻¹) by field_simp; norm_num, div_eq_inv_mul (1 - x)]
  have : (0 : ℝ) < √2 := by positivity
  field_simp

/-- The derivative $\mathrm J'(y)=\sqrt2\,\Phi^{-1}(w_1^{-1}(1-y))/(2J_{w_1}(\frac12))$. -/
noncomputable def DJX (y : ℝ) : ℝ := √2 * gInv (w₁⁻¹ * (1 - y)) / (2 * gJw w₁ 2⁻¹)

/-- $\mathrm J'=$ `DJX` on $(1-w_1,1)$. -/
theorem poincareX_hasDerivAt_JX {y : ℝ} (hy : y ∈ Ioo (1 - w₁) 1) : HasDerivAt JX (DJX y) y := by
  have hw : (0 : ℝ) < w₁ := by rw [poincareX_w₁_eq]; norm_num
  have h : JX = fun y ↦ gJw w₁ y / (2 * gJw w₁ 2⁻¹) := funext poincareX_JX_eq
  rw [h]
  exact (hasDerivAt_gJw hw hy).div_const _

/-- $x\mapsto\mathrm J(1-x)$ is increasing on $[0,\frac14]$ (since $x_1<\frac34$). -/
theorem poincareX_JX_one_sub_mono {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 4⁻¹) :
    JX (1 - x) ≤ JX (1 - y) := by
  have hw : (0 : ℝ) < w₁ := by rw [poincareX_w₁_eq]; norm_num
  rw [poincareX_JX_eq, poincareX_JX_eq]
  refine div_le_div_of_nonneg_right ?_ (by linarith [poincareX_H_pos])
  unfold gJw
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  have hmem : ∀ t, 0 ≤ t → t ≤ 4⁻¹ → w₁⁻¹ * (1 - (1 - t)) ∈ Icc (0 : ℝ) 2⁻¹ := fun t h0 h1 ↦
    ⟨by rw [poincareX_w₁_eq]; norm_num; linarith, by rw [poincareX_w₁_eq]; norm_num; linarith⟩
  exact gProf_strictMonoOn.monotoneOn (hmem x hx (by linarith)) (hmem y (by linarith) hy)
    (mul_le_mul_of_nonneg_left (by linarith) (by positivity))

/-- $\mathrm J(1-x)\ge0$. -/
theorem poincareX_JX_nonneg (x : ℝ) : 0 ≤ JX x := by
  rw [poincareX_JX_eq, gJw]
  have hw : (0 : ℝ) < w₁ := by rw [poincareX_w₁_eq]; norm_num
  have := gProf_nonneg (w₁⁻¹ * (1 - x))
  have := poincareX_H_pos
  positivity

/-- $x\mapsto\mathrm J'(1-x)$ is increasing on $(0,w_1)$. -/
theorem poincareX_DJX_mono {x y : ℝ} (hx : 0 < x) (hxy : x ≤ y) (hy : y < w₁) :
    DJX (1 - x) ≤ DJX (1 - y) := by
  have hw : (0 : ℝ) < w₁ := by rw [poincareX_w₁_eq]; norm_num
  unfold DJX
  refine div_le_div_of_nonneg_right ?_ (by linarith [poincareX_H_pos])
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  have hmem : ∀ t, 0 < t → t < w₁ → w₁⁻¹ * (1 - (1 - t)) ∈ Ioo (0 : ℝ) 1 := fun t h0 h1 ↦
    ⟨by rw [sub_sub_cancel]; positivity, by
      rw [sub_sub_cancel, ← div_eq_inv_mul, div_lt_one hw]; exact h1⟩
  exact gInv_strictMonoOn.monotoneOn (hmem x hx (by linarith)) (hmem y (by linarith) hy)
    (mul_le_mul_of_nonneg_left (by linarith) (by positivity))

/-! ### The function $G_P$ and the lower bounds of (4.2) and (4.3) -/

/-- The formula $G_P(x)=\frac12(B_{w_1}(x)+B_{w_1}(1-x))-2x(1-x)$ of (4.1); definitionally
`Auto.DIRX.G_PX` of the main file. -/
noncomputable def GPXf (x : ℝ) : ℝ := 2⁻¹ * (BX w₁ x + BX w₁ (1 - x)) - 2 * x * (1 - x)

/-- [DIRX], §4, Cases I and II: $G_P(x)=\frac12(L(x)+\mathrm J(1-x))-2x(1-x)$ for
$x\le\frac14$. -/
theorem poincareX_GPXf_eq {x : ℝ} (hx : x ≤ 4⁻¹) :
    GPXf x = 2⁻¹ * (Auto.DIR.L 2⁻¹ x + JX (1 - x)) - 2 * x * (1 - x) := by
  rw [GPXf, BX, if_pos hx, BX, if_neg (by norm_num; linarith), if_neg (by norm_num; linarith)]
  rfl

/-- The tight lower bound of (4.2):
$\underline{h_{P,1}}(\underline x,\overline x)=\frac12(L(\underline x)+\mathrm J(1-\underline x))
-2\overline x(1-\underline x)$. -/
noncomputable def hP1lo (xl xu : ℝ) : ℝ :=
  2⁻¹ * (Auto.DIR.L 2⁻¹ xl + JX (1 - xl)) - 2 * xu * (1 - xl)

/-- [DIRX], §4, Case II: $\underline{h_{P,1}}$ is a lower bound of $G_P$ on
$[\frac1{64},\frac14]$ ($L$ and $x\mapsto\mathrm J(1-x)$ are increasing there). -/
theorem hP1lo_le {xl xu x : ℝ} (h1 : 64⁻¹ ≤ xl) (hxl : xl ≤ x) (hxu : x ≤ xu) (h2 : xu ≤ 4⁻¹) :
    hP1lo xl xu ≤ GPXf x := by
  rw [poincareX_GPXf_eq (by linarith)]
  have hLm := poincare_L_half_monotoneOn ⟨by linarith, by linarith⟩ ⟨by linarith, by linarith⟩
    hxl
  have hJm := poincareX_JX_one_sub_mono (by linarith) hxl (by linarith)
  unfold hP1lo
  nlinarith [mul_le_mul hxu (by linarith : 1 - x ≤ 1 - xl) (by linarith) (by linarith)]

/-- The function $\frac12(Q(t)+\mathrm J(1-t))-2t(1-t)$ of [DIRX], §4, Case III. -/
noncomputable def GPXg (t : ℝ) : ℝ := 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)

/-- The derivative of `GPXg` on $(0,w_1)$. -/
theorem poincareX_hasDerivAt_GPXg {t : ℝ} (ht : t ∈ Ioo 0 w₁) :
    HasDerivAt GPXg (2⁻¹ * (Q1f 2⁻¹ t - DJX (1 - t)) - (2 - 4 * t)) t := by
  have hJ := (poincareX_hasDerivAt_JX (y := 1 - t) ⟨by linarith [ht.2], by linarith [ht.1]⟩).comp
    t ((hasDerivAt_id t).const_sub 1)
  have h := (((hasDerivAt_Q 2⁻¹ t).add hJ).const_mul 2⁻¹).sub
    (((hasDerivAt_id t).const_mul 2).mul ((hasDerivAt_id t).const_sub 1))
  refine h.congr_deriv ?_
  simp only [id]
  ring

/-- $h_{P,2}(x)=-\frac12Q'(x)+\frac12\mathrm J'(1-x)-4x+2$ for $x\in(0,w_1)$. -/
theorem poincareX_h_P₂_eq {x : ℝ} (hx : x ∈ Ioo 0 w₁) :
    -deriv (fun t ↦ 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)) x =
      -(2⁻¹ * Q1f 2⁻¹ x) + 2⁻¹ * DJX (1 - x) + (2 - 4 * x) := by
  have := (poincareX_hasDerivAt_GPXg hx).deriv
  rw [show (fun t ↦ 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)) = GPXg from rfl, this]
  ring

/-- The tight lower bound of (4.3):
$\underline{h_{P,2}}(\underline x,\overline x)=-\frac12Q'(\underline x)+\frac12\mathrm J'(1-
\underline x)-4\overline x+2$. -/
noncomputable def hP2lo (xl xu : ℝ) : ℝ :=
  -(2⁻¹ * Q1f 2⁻¹ xl) + 2⁻¹ * DJX (1 - xl) + (2 - 4 * xu)

/-- [DIRX], §4, Case III: $\underline{h_{P,2}}$ is a lower bound of $h_{P,2}$ on
$[\frac14,\frac12]$ ($x\mapsto\mathrm J'(1-x)$ is increasing and $Q'$ is decreasing). -/
theorem hP2lo_le {xl xu x : ℝ} (h1 : 4⁻¹ ≤ xl) (hxl : xl ≤ x) (hxu : x ≤ xu) (h2 : xu ≤ 2⁻¹) :
    hP2lo xl xu ≤ -deriv (fun t ↦ 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)) x := by
  have hw : w₁ = 29 / 32 := rfl
  rw [poincareX_h_P₂_eq ⟨by linarith, by rw [hw]; linarith⟩]
  obtain ⟨-, -, hQ⟩ := poincare_Q1f_bounds (β := 2⁻¹) ⟨le_rfl, by rw [β₀]; norm_num⟩ h1 hxl
    (by linarith)
  have hD := poincareX_DJX_mono (by linarith) hxl (by rw [hw]; linarith)
  unfold hP2lo
  linarith

/-! ### Certified values for the checker -/

/-- $J_{w_1}(\frac12)$ as a certified value (node `JwHalf`). -/
noncomputable def poincareXCertH : Cert where
  l := 0.506993329773636
  u := 0.506993329775637
  v := gJw w₁ 2⁻¹
  h := by
    have := checkMem_sound P11 hw11 [] (.JwHalf (29 / 32) 0.0919370219368074 0.0919370219366073)
      0.506993329773636 0.506993329775637 (by decide +kernel)
    simp only [denote] at this
    have e : ((29 / 32 : ℚ) : ℝ) = 29 / 32 := by norm_num
    rw [poincareX_w₁_eq, ← e]
    exact this

/-- Boolean check of an enclosure $[a,b]$ of $J_w(x)$ (rational $w$, $x$) from witnesses
$s_l,s_u$ (by `gJwIv`). -/
def poincareXCheckGJw (w x sl su a b : ℚ) : Bool :=
  match gJwIv P11 w w x sl su with
  | some I => decide (a ≤ I.1 ∧ I.2 ≤ b)
  | none => false

/-- Soundness of `poincareXCheckGJw`. -/
theorem poincareX_gJw_mem {w x sl su a b : ℚ} (h : poincareXCheckGJw w x sl su a b = true) :
    (a : ℝ) ≤ gJw w x ∧ gJw w x ≤ b := by
  unfold poincareXCheckGJw at h
  rcases hI : gJwIv P11 w w x sl su with _ | I <;> rw [hI] at h
  · cases h
  obtain ⟨h1, h2⟩ := of_decide_eq_true h
  have hm := gJwIv_sound P11 hI (w := w) ⟨le_rfl, le_rfl⟩
  exact ⟨(by exact_mod_cast h1 : (a : ℝ) ≤ I.1).trans hm.1,
    hm.2.trans (by exact_mod_cast h2 : (I.2 : ℝ) ≤ b)⟩

/-- $J_{w_1}(1-c)$ for rational $c$ as a certified value. -/
noncomputable def poincareXCertG (c a b sl su : ℚ)
    (h : poincareXCheckGJw (29 / 32) (1 - c) sl su a b = true) : Cert where
  l := a
  u := b
  v := gJw w₁ (1 - (c : ℝ))
  h := by
    have := poincareX_gJw_mem h
    rw [poincareX_w₁_eq]
    push_cast at this
    exact this

/-- Boolean check of an enclosure $[2z_l,2z_u]$ of $\sqrt2\,\Phi^{-1}(c/w_1)$ ($=J_{w_1}'(1-c)$):
$0<c<w_1$, $\Phi(\sqrt2z_l)\le c/w_1\le\Phi(\sqrt2z_u)$. -/
def poincareXCheckD (c zl zu : ℚ) : Bool :=
  decide (0 < c ∧ c / (29 / 32) < 1 ∧ phiHi P11 zl ≤ c / (29 / 32) ∧
    c / (29 / 32) ≤ phiLo P11 zu)

/-- Soundness of `poincareXCheckD`. -/
theorem poincareX_D_mem {c zl zu : ℚ} (h : poincareXCheckD c zl zu = true) :
    ((2 * zl : ℚ) : ℝ) ≤ √2 * gInv (w₁⁻¹ * (1 - (1 - (c : ℝ)))) ∧
      √2 * gInv (w₁⁻¹ * (1 - (1 - (c : ℝ)))) ≤ ((2 * zu : ℚ) : ℝ) := by
  obtain ⟨hc, hc1, h1, h2⟩ := of_decide_eq_true h
  have ht : (1 - (1 - (c : ℝ))) * w₁⁻¹ = ((c / (29 / 32) : ℚ) : ℝ) := by
    rw [poincareX_w₁_eq]; push_cast; ring
  rw [mul_comm w₁⁻¹, ht]
  have hc' : ((c / (29 / 32) : ℚ) : ℝ) ∈ Ioo 0 1 :=
    ⟨by have : (0 : ℚ) < c / (29 / 32) := by positivity
        exact_mod_cast this, by exact_mod_cast hc1⟩
  have h1' : ((phiHi P11 zl : ℚ) : ℝ) ≤ ((c / (29 / 32) : ℚ) : ℝ) := by exact_mod_cast h1
  have h2' : ((c / (29 / 32) : ℚ) : ℝ) ≤ ((phiLo P11 zu : ℚ) : ℝ) := by exact_mod_cast h2
  have hs2 : (0 : ℝ) < √2 := by positivity
  have h22 : √2 * √2 = (2 : ℝ) := Real.mul_self_sqrt (by norm_num)
  constructor
  · have e : √2 * zl ≤ gInv ((c / (29 / 32) : ℚ) : ℝ) :=
      (le_gInv_iff hc').2 ((gCDF_le_phiHi P11 zl).trans h1')
    have := mul_le_mul_of_nonneg_left e hs2.le
    rw [← mul_assoc, h22] at this
    rw [Rat.cast_mul, Rat.cast_ofNat]
    exact this
  · have e : gInv ((c / (29 / 32) : ℚ) : ℝ) ≤ √2 * zu :=
      (gInv_le_iff hc').2 (h2'.trans (phiLo_le_gCDF P11 zu))
    have := mul_le_mul_of_nonneg_left e hs2.le
    rw [← mul_assoc, h22] at this
    rw [Rat.cast_mul, Rat.cast_ofNat]
    exact this

/-- $J_{w_1}'(1-c)=\sqrt2\,\Phi^{-1}(c/w_1)$ for rational $c\in(0,w_1)$ as a certified value. -/
noncomputable def poincareXCertD (c zl zu : ℚ) (h : poincareXCheckD c zl zu = true) : Cert where
  l := 2 * zl
  u := 2 * zu
  v := √2 * gInv (w₁⁻¹ * (1 - (1 - (c : ℝ))))
  h := poincareX_D_mem h

/-! ### Checker expressions of the tight lower bounds and soundness of one box -/

/-- $\underline{h_{P,1}}(\underline x,\overline x)$ as a checker expression in the variables
`var 0` $=L(\underline x)$, `var 1` $=J_{w_1}(1-\underline x)$, `var 2` $=J_{w_1}(\frac12)$
($\mathrm J=J_{w_1}/(2J_{w_1}(\frac12))$). -/
def hP1Ex (xl xu : ℚ) : Ex :=
  .sub (.mul (.const 2⁻¹) (.add (.var 0) (.div (.var 1) (.mul (.const 2) (.var 2)))))
    (.const (2 * xu * (1 - xl)))

/-- One box of (4.2): a successful check gives $\underline{h_{P,1}}(\underline x,\overline x)>
10^{-4}$ (`hP1Ex` denotes $\underline{h_{P,1}}$). -/
theorem hP1_box (xl xu : ℚ) (e g : Cert) (he : e.v = Auto.DIR.L 2⁻¹ xl)
    (hg : g.v = gJw w₁ (1 - xl))
    (h : check P11 (Cert.env [e, g, poincareXCertH]) (hP1Ex xl xu) (1 / 10000) = true) :
    (1 / 10000 : ℝ) < hP1lo xl xu := by
  have := check_sound P11 hw11 _ _ _ h
  simp only [hP1Ex, denote, poincare_val_zero, poincare_val_succ, he, hg] at this
  rw [hP1lo, poincareX_JX_eq]
  have hH : poincareXCertH.v = gJw w₁ 2⁻¹ := rfl
  rw [hH] at this
  push_cast at this ⊢
  linarith

/-- $\underline{h_{P,2}}(\underline x,\overline x)$ as a checker expression in the variables
`var 0` $=\sqrt2$, `var 1` $=\sqrt2\,\Phi^{-1}(\underline x/w_1)$, `var 2` $=J_{w_1}(\frac12)$;
$Q'(\underline x)$ is written affinely in $\sqrt2$ (`Q1f_eq_affine`). -/
def hP2Ex (xl xu : ℚ) : Ex :=
  .add (.add
    (.neg (.mul (.const 2⁻¹) (.add (.const (-2 + 20 * xl - 24 * xl ^ 2))
      (.mul (.const (8 / 3 - 16 * xl + 16 * xl ^ 2)) (.var 0)))))
    (.mul (.const 2⁻¹) (.div (.var 1) (.mul (.const 2) (.var 2)))))
    (.const (2 - 4 * xu))

/-- One box of (4.3): a successful check gives $\underline{h_{P,2}}(\underline x,\overline x)>
10^{-4}$ (`hP2Ex` denotes $\underline{h_{P,2}}$). -/
theorem hP2_box (xl xu : ℚ) (d : Cert) (hd : d.v = √2 * gInv (w₁⁻¹ * (1 - (1 - (xl : ℝ)))))
    (h : check P11 (Cert.env [poincareCertS, d, poincareXCertH]) (hP2Ex xl xu) (1 / 10000)
      = true) :
    (1 / 10000 : ℝ) < hP2lo xl xu := by
  have := check_sound P11 hw11 _ _ _ h
  simp only [hP2Ex, denote, poincare_val_zero, poincare_val_succ, hd] at this
  have hS : poincareCertS.v = 2 ^ (2⁻¹ : ℝ) := rfl
  have hH : poincareXCertH.v = gJw w₁ 2⁻¹ := rfl
  rw [hS, hH] at this
  rw [hP2lo, Q1f_eq_affine, DJX]
  push_cast at this ⊢
  linarith

/-! ### Reduction of (4.2) and (4.3) to the boxes of the paper's partitions -/

/-- The admissible partition of $[\frac1{64},\frac14]$ for $\underline{h_{P,1}}$ from [DIRX],
`partitions.py` (`h_P_1`, 24 intervals). -/
def hP1bp : List ℚ :=
  [1/64, 47/2048, 31/1024, 77/2048, 23/512, 107/2048, 61/1024, 19/256, 91/1024, 53/512,
    121/1024, 17/128, 151/1024, 83/512, 181/1024, 377/2048, 49/256, 407/2048, 211/1024,
    437/2048, 113/512, 467/2048, 241/1024, 497/2048, 1/4]

/-- The admissible partition of $[\frac14,\frac12]$ for $\underline{h_{P,2}}$ from [DIRX],
`partitions.py` (`h_P_2`, 27 intervals). -/
def hP2bp : List ℚ :=
  [1/4, 17/64, 9/32, 19/64, 5/16, 21/64, 43/128, 11/32, 45/128, 23/64, 47/128, 3/8,
    49/128, 25/64, 51/128, 13/32, 53/128, 27/64, 55/128, 7/16, 57/128, 29/64, 59/128,
    15/32, 61/128, 31/64, 63/128, 1/2]

/-- (4.2) from the boxes of the partition `hP1bp`: $G_P>10^{-4}$ on $[\frac1{64},\frac14]$. -/
theorem poincareX_eqn_4_2_of_boxes
    (hbox : poincareBoxesOK (fun p q ↦ (1 / 10000 : ℝ) < hP1lo p q) hP1bp)
    (x : ℝ) (hx : x ∈ Icc (64⁻¹ : ℝ) 4⁻¹) : GPXf x > 1e-4 := by
  have h := poincare_pos_of_breakpoints GPXf hP1lo (1 / 10000) hP1bp (1 / 64) (1 / 4)
    (by decide +kernel) rfl rfl (by decide)
    (fun xl xu h1 h2 y hy ↦ hP1lo_le (by norm_num at h1 ⊢; linarith) hy.1 hy.2
      (by norm_num at h2 ⊢; linarith)) hbox x ⟨by norm_num; linarith [hx.1], by
        norm_num; linarith [hx.2]⟩
  norm_num at h ⊢
  linarith

/-- (4.3) from the boxes of the partition `hP2bp`: $h_{P,2}>10^{-4}$ on $[\frac14,\frac12]$. -/
theorem poincareX_eqn_4_3_of_boxes
    (hbox : poincareBoxesOK (fun p q ↦ (1 / 10000 : ℝ) < hP2lo p q) hP2bp)
    (x : ℝ) (hx : x ∈ Icc (4⁻¹ : ℝ) 2⁻¹) :
    -deriv (fun t ↦ 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)) x > 1e-4 := by
  have h := poincare_pos_of_breakpoints
    (fun y ↦ -deriv (fun t ↦ 2⁻¹ * (Q 2⁻¹ t + JX (1 - t)) - 2 * t * (1 - t)) y) hP2lo
    (1 / 10000) hP2bp (1 / 4) (1 / 2) (by decide +kernel) rfl rfl (by decide)
    (fun xl xu h1 h2 y hy ↦ hP2lo_le (by norm_num at h1 ⊢; linarith) hy.1 hy.2
      (by norm_num at h2 ⊢; linarith)) hbox x
