/-!
## Auxiliary lemmas for [DIR] §2: the Kahn–Park reduction

Proof of [DIR] Proposition 2.1 (cited from Kahn–Park [KP20]) for $\frac12\le\beta\le1$, following
the induction on the dimension in `sources/two_point_general_beta.tex`:

* slicing $\{0,1\}^{n+1}$ along the first coordinate (`Fin.cons`), the expectation splits as
  $\mathbf{E}_{n+1}f=\frac12(\mathbf{E}_nf(0,\cdot)+\mathbf{E}_nf(1,\cdot))$, and
  $h_A(i,z)=h_{A_i}(z)+\mathbf{1}_{A_i\setminus A_{1-i}}(z)$;
* the $\ell^q$ triangle inequality ($q=1/\beta\ge1$) for averages gives
  $\mathbf{E}(h+\mathbf{1}_D)^\beta\ge N(d,H)$, and $(k+1)^\beta\ge1+(2^\beta-1)k^\beta$ gives
  $\mathbf{E}(h+\mathbf{1}_D)^\beta\ge d+(2^\beta-1)H$;
* the induction step combines these with the two-point inequality $G_\beta[B]\ge0$.
-/

namespace Auto.DIR

open Real Finset

/-! ### Slicing the cube -/

/-- The slice $A_i=\{z\in\{0,1\}^n : (i,z)\in A\}$ of $A\subset\{0,1\}^{n+1}$ along the first
coordinate. -/
def slice {n : ℕ} (A : Set ({0,1}^(n + 1))) (i : ZMod 2) : Set ({0,1}^n) :=
  {z | (Fin.cons i z : Fin (n + 1) → ZMod 2) ∈ A}

/-- Sums over $\{0,1\}^{n+1}$ split along the first coordinate. -/
theorem sum_cube_succ {n : ℕ} {M : Type*} [AddCommMonoid M] (f : ({0,1}^(n + 1)) → M) :
    ∑ x, f x = ∑ z : {0,1}^n, (f (Fin.cons 0 z) + f (Fin.cons 1 z)) := by
  rw [← (Fin.consEquiv fun _ : Fin (n + 1) ↦ ZMod 2).sum_comp, Fintype.sum_prod_type,
    Finset.sum_comm]
  refine Finset.sum_congr rfl fun z _ ↦ ?_
  exact Fin.sum_univ_two (fun i : ZMod 2 ↦ f (Fin.cons i z))

/-- $\mathbf{E}_{n+1}f=\frac12(\mathbf{E}_nf(0,\cdot)+\mathbf{E}_nf(1,\cdot))$. -/
theorem expect_succ {n : ℕ} (f : ({0,1}^(n + 1)) → ℝ) :
    𝐄 f = 2⁻¹ * (𝐄 (fun z : {0,1}^n ↦ f (Fin.cons 0 z)) + 𝐄 (fun z ↦ f (Fin.cons 1 z))) := by
  simp only [expect, smul_eq_mul, sum_cube_succ f, Finset.sum_add_distrib, pow_succ]
  ring

/-- Flipping the first coordinate. -/
theorem cons_add_e_zero {n : ℕ} (i : ZMod 2) (z : {0,1}^n) :
    (Fin.cons i z : {0,1}^(n + 1)) + e 0 = Fin.cons (i + 1) z := by
  funext k
  refine Fin.cases ?_ (fun j ↦ ?_) k
  · simp [e]
  · simp [e, Fin.succ_ne_zero]

/-- Flipping a later coordinate. -/
theorem cons_add_e_succ {n : ℕ} (i : ZMod 2) (z : {0,1}^n) (j : Fin n) :
    (Fin.cons i z : {0,1}^(n + 1)) + e j.succ = Fin.cons i (z + e j) := by
  funext k
  refine Fin.cases ?_ (fun l ↦ ?_) k
  · simp [e, (Fin.succ_ne_zero j).symm]
  · simp [e, Pi.single_apply, Fin.succ_inj]

open Classical in
/-- $h_A(i,z)=h_{A_i}(z)+\mathbf{1}_{A_i\setminus A_{i+1}}(z)$. -/
theorem h_cons {n : ℕ} (A : Set ({0,1}^(n + 1))) (i : ZMod 2) (z : {0,1}^n) :
    h A (Fin.cons i z) = h (slice A i) z +
      (if z ∈ slice A i ∧ z ∉ slice A (i + 1) then 1 else 0) := by
  by_cases hz : z ∈ slice A i
  · have hA : (Fin.cons i z : {0,1}^(n + 1)) ∈ A := hz
    simp only [h, hA, hz, true_and, ite_true]
    rw [Finset.card_filter, Finset.card_filter, Fin.sum_univ_succ, cons_add_e_zero]
    simp only [cons_add_e_succ]
    by_cases h1 : z ∈ slice A (i + 1)
    · have h1' : (Fin.cons (i + 1) z : {0,1}^(n + 1)) ∈ A := h1
      simp [h1', slice]
      refine Finset.sum_congr rfl fun x _ ↦ ?_
      split_ifs <;> simp_all
    · have h1' : (Fin.cons (i + 1) z : {0,1}^(n + 1)) ∉ A := h1
      simp [h1', slice]
      rw [add_comm]
      congr 1
      refine Finset.sum_congr rfl fun x _ ↦ ?_
      split_ifs <;> simp_all
  · have hA : (Fin.cons i z : {0,1}^(n + 1)) ∉ A := hz
    simp [h, hA, hz]

/-! ### Expectations -/

/-- Monotonicity of $\mathbf{E}$. -/
theorem expect_le_expect {n : ℕ} {f g : ({0,1}^n) → ℝ} (hfg : ∀ z, f z ≤ g z) :
    𝐄 f ≤ 𝐄 g := by
  simp only [expect, smul_eq_mul]
  exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun z _ ↦ hfg z) (by positivity)

/-- Additivity of $\mathbf{E}$. -/
theorem expect_add' {n : ℕ} (f g : ({0,1}^n) → ℝ) :
    𝐄 (fun z ↦ f z + g z) = 𝐄 f + 𝐄 g := by
  simp only [expect, smul_eq_mul, Finset.sum_add_distrib, mul_add]

/-- $\mathbf{E}(f-g)=\mathbf{E}f-\mathbf{E}g$. -/
theorem expect_sub' {n : ℕ} (f g : ({0,1}^n) → ℝ) :
    𝐄 (fun z ↦ f z - g z) = 𝐄 f - 𝐄 g := by
  simp only [expect, smul_eq_mul, Finset.sum_sub_distrib, mul_sub]

/-- Homogeneity of $\mathbf{E}$. -/
theorem expect_const_mul' {n : ℕ} (c : ℝ) (f : ({0,1}^n) → ℝ) :
    𝐄 (fun z ↦ c * f z) = c * 𝐄 f := by
  simp only [expect, smul_eq_mul, ← Finset.mul_sum]
  ring

/-- $\mathbf{E}1=1$. -/
theorem expect_one' (n : ℕ) : 𝐄 (fun _ : {0,1}^n ↦ (1 : ℝ)) = 1 := by
  simp only [expect, smul_eq_mul, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
  have : (Fintype.card ({0,1}^n) : ℝ) = 2 ^ n := by simp
  rw [this, ← mul_pow]
  norm_num

/-- $0\le\mathbf{1}_A\le1$. -/
theorem ind_mem_Icc {n : ℕ} (A : Set ({0,1}^n)) (z : {0,1}^n) :
    0 ≤ 𝟏 A z ∧ 𝟏 A z ≤ 1 := by
  by_cases hz : z ∈ A <;> simp [ind, hz]

/-- $|A|\in[0,1]$. -/
theorem dens_mem_Icc {n : ℕ} (A : Set ({0,1}^n)) : ｜A｜ ∈ Set.Icc (0 : ℝ) 1 := by
  refine ⟨?_, ?_⟩
  · have := expect_le_expect (f := fun _ ↦ (0 : ℝ)) (g := 𝟏 A) fun z ↦ (ind_mem_Icc A z).1
    simpa [dens, expect] using this
  · have := expect_le_expect (f := 𝟏 A) (g := fun _ ↦ (1 : ℝ)) fun z ↦ (ind_mem_Icc A z).2
    rwa [expect_one'] at this

open Classical in
/-- $|S|=2^{-n}\#S$ for a finite set $S$. -/
theorem dens_coe_finset {n : ℕ} (S : Finset ({0,1}^n)) : ｜(S : Set ({0,1}^n))｜ =
    (2⁻¹ : ℝ) ^ n * S.card := by
  simp only [dens, expect, ind, smul_eq_mul, Set.indicator_apply, Finset.mem_coe, Pi.one_apply]
  rw [Finset.sum_boole, Finset.filter_mem_eq_inter, Finset.univ_inter]

/-- Every dyadic value $k2^{-m}$ ($k\le2^m$) is the measure of a subset of $\{0,1\}^{m+1}$. -/
theorem exists_set_dens (m k : ℕ) (hk : k ≤ 2 ^ m) :
    ∃ A : Set ({0,1}^(m + 1)), ｜A｜ = (k : ℝ) / 2 ^ m := by
  have hcard : 2 * k ≤ (Finset.univ : Finset ({0,1}^(m + 1))).card := by
    simp only [Finset.card_univ]
    have : Fintype.card ({0,1}^(m + 1)) = 2 ^ (m + 1) := by simp
    rw [this, pow_succ]
    omega
  obtain ⟨S, -, hS⟩ := Finset.exists_subset_card_eq hcard
  refine ⟨S, ?_⟩
  rw [dens_coe_finset, hS, inv_pow, pow_succ]
  push_cast
  field_simp

/-! ### The $\ell^q$ triangle inequality, $q=1/\beta$ -/

/-- $N_\beta(s,t)=(s^{1/\beta}+t^{1/\beta})^\beta$, the $\ell^{1/\beta}$ norm of $(s,t)$. -/
noncomputable def Nq (β s t : ℝ) : ℝ := (s ^ β⁻¹ + t ^ β⁻¹) ^ β

/-- Minkowski's inequality for $N_\beta$ ($0<\beta\le1$). -/
theorem Nq_add {β : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1) {a b c d : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hc : 0 ≤ c) (hd : 0 ≤ d) : Nq β (a + c) (b + d) ≤ Nq β a b + Nq β c d := by
  have hp : 1 ≤ β⁻¹ := (one_le_inv₀ hβ).2 hβ1
  have := Real.Lp_add_le (s := Finset.univ) (f := ![a, b]) (g := ![c, d]) hp
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, one_div,
    inv_inv] at this
  rwa [abs_of_nonneg (add_nonneg ha hc), abs_of_nonneg (add_nonneg hb hd), abs_of_nonneg ha,
    abs_of_nonneg hb, abs_of_nonneg hc, abs_of_nonneg hd] at this

/-- $N_\beta(0,0)=0$. -/
theorem Nq_zero {β : ℝ} (hβ : 0 < β) : Nq β 0 0 = 0 := by
  simp [Nq, Real.zero_rpow (inv_ne_zero hβ.ne'), Real.zero_rpow hβ.ne']

/-- The triangle inequality for finite sums: $N(\sum s_i,\sum t_i)\le\sum N(s_i,t_i)$. -/
theorem Nq_sum {β : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1) {ι : Type*} (s : Finset ι) (f g : ι → ℝ)
    (hf : ∀ i, 0 ≤ f i) (hg : ∀ i, 0 ≤ g i) :
    Nq β (∑ i ∈ s, f i) (∑ i ∈ s, g i) ≤ ∑ i ∈ s, Nq β (f i) (g i) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp only [Finset.sum_empty]
    rw [Nq_zero hβ]
  · intro i s hi ih
    rw [Finset.sum_insert hi, Finset.sum_insert hi, Finset.sum_insert hi]
    exact (Nq_add hβ hβ1 (hf i) (hg i) (Finset.sum_nonneg fun j _ ↦ hf j)
      (Finset.sum_nonneg fun j _ ↦ hg j)).trans (by linarith)

/-- Homogeneity: $N(ca,cb)=cN(a,b)$ for $c\ge0$. -/
theorem Nq_mul {β : ℝ} (hβ : 0 < β) {c a b : ℝ} (hc : 0 ≤ c) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    Nq β (c * a) (c * b) = c * Nq β a b := by
  simp only [Nq]
  rw [Real.mul_rpow hc ha, Real.mul_rpow hc hb, ← mul_add,
    Real.mul_rpow (Real.rpow_nonneg hc _)
      (add_nonneg (Real.rpow_nonneg ha _) (Real.rpow_nonneg hb _)),
    Real.rpow_inv_rpow hc hβ.ne']

/-- Monotonicity of $N_\beta$ in both variables. -/
theorem Nq_mono {β : ℝ} (hβ : 0 < β) {a b a' b' : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (haa : a ≤ a')
    (hbb : b ≤ b') : Nq β a b ≤ Nq β a' b' := by
  have hq : 0 ≤ β⁻¹ := inv_nonneg.2 hβ.le
  exact Real.rpow_le_rpow (add_nonneg (Real.rpow_nonneg ha _) (Real.rpow_nonneg hb _))
    (add_le_add (Real.rpow_le_rpow ha haa hq) (Real.rpow_le_rpow hb hbb hq)) hβ.le

/-- $N_\beta(\delta,k^\beta)=(k+\delta)^\beta$ for $\delta\in\{0,1\}$, $k\ge0$. -/
theorem Nq_ind {β : ℝ} (hβ : 0 < β) {k δ : ℝ} (hk : 0 ≤ k) (hδ : δ = 0 ∨ δ = 1) :
    Nq β δ (k ^ β) = (k + δ) ^ β := by
  simp only [Nq]
  rw [Real.rpow_rpow_inv hk hβ.ne', add_comm]
  rcases hδ with rfl | rfl
  · rw [Real.zero_rpow (inv_ne_zero hβ.ne')]
  · rw [Real.one_rpow]

/-- $(k+1)^\beta\ge1+(2^\beta-1)k^\beta$ for $k=0,1,2,\dots$ ($0<\beta\le1$), from the triangle
inequality for $(t,t)=(1,t)+(t-1,0)$, $t=k^\beta$. -/
theorem scalar_ineq {β : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1) (k : ℕ) :
    1 + (2 ^ β - 1) * (k : ℝ) ^ β ≤ ((k : ℝ) + 1) ^ β := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · simp [Real.zero_rpow hβ.ne']
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : (0 : ℝ) ≤ k := by positivity
  set t : ℝ := (k : ℝ) ^ β with ht
  have ht1 : 1 ≤ t := Real.one_le_rpow hk1 hβ.le
  have key := Nq_add hβ hβ1 (a := 1) (b := t) (c := t - 1) (d := 0) zero_le_one (by linarith)
    (by linarith) le_rfl
  have htq : t ^ β⁻¹ = k := by rw [ht, Real.rpow_rpow_inv hk0 hβ.ne']
  have e1 : Nq β (1 + (t - 1)) (t + 0) = 2 ^ β * t := by
    rw [show 1 + (t - 1) = t by ring, add_zero]
    simp only [Nq]
    rw [htq, show (k : ℝ) + k = 2 * k by ring, Real.mul_rpow (by norm_num) hk0]
  have e2 : Nq β 1 t = ((k : ℝ) + 1) ^ β := by
    simp only [Nq]
    rw [htq, Real.one_rpow, add_comm]
  have e3 : Nq β (t - 1) 0 = t - 1 := by
    simp only [Nq]
    rw [Real.zero_rpow (inv_ne_zero hβ.ne'), add_zero,
      Real.rpow_inv_rpow (by linarith) hβ.ne']
  rw [e1, e2, e3] at key
  linarith

/-- Pointwise: $(k+\delta)^\beta\ge\delta+(2^\beta-1)k^\beta$ for $k\in\mathbb{N}$,
$\delta\in\{0,1\}$. -/
theorem pointwise_ineq {β : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1) (k : ℕ) {δ : ℝ}
    (hδ : δ = 0 ∨ δ = 1) : δ + (2 ^ β - 1) * (k : ℝ) ^ β ≤ ((k : ℝ) + δ) ^ β := by
  rcases hδ with rfl | rfl
  · have h2 : (2 : ℝ) ^ β ≤ 2 := by
      simpa using Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hβ1
    have hk : 0 ≤ (k : ℝ) ^ β := Real.rpow_nonneg (Nat.cast_nonneg k) β
    simp only [add_zero, zero_add]
    nlinarith
  · exact scalar_ineq hβ hβ1 k

/-- The increment estimate: for $k:\{0,1\}^n\to\mathbb{N}$ and $D\subset\{0,1\}^n$, with
$H=\mathbf{E}k^\beta$, $d=|D|$:
$\mathbf{E}(k+\mathbf{1}_D)^\beta\ge\max\{N_\beta(d,H),\,d+(2^\beta-1)H\}$. -/
theorem expect_incr {β : ℝ} (hβ : 0 < β) (hβ1 : β ≤ 1) {n : ℕ} (k : ({0,1}^n) → ℕ)
    (D : Set ({0,1}^n)) :
    max (Nq β (𝐄 𝟏 D) (𝐄 fun z ↦ (k z : ℝ) ^ β))
        (𝐄 𝟏 D + (2 ^ β - 1) * 𝐄 fun z ↦ (k z : ℝ) ^ β) ≤
      𝐄 fun z ↦ ((k z : ℝ) + 𝟏 D z) ^ β := by
  have hδ : ∀ z, 𝟏 D z = 0 ∨ 𝟏 D z = 1 := by
    intro z; by_cases hz : z ∈ D <;> simp [ind, hz]
  have hw : (0 : ℝ) ≤ (2⁻¹ : ℝ) ^ n := by positivity
  refine max_le ?_ ?_
  · simp only [expect, smul_eq_mul]
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
    refine (Nq_sum hβ hβ1 _ _ _ (fun z ↦ mul_nonneg hw (ind_mem_Icc D z).1)
      (fun z ↦ mul_nonneg hw (Real.rpow_nonneg (Nat.cast_nonneg _) _))).trans
      (le_of_eq (Finset.sum_congr rfl fun z _ ↦ ?_))
    rw [Nq_mul hβ hw (ind_mem_Icc D z).1 (Real.rpow_nonneg (Nat.cast_nonneg _) _),
      Nq_ind hβ (Nat.cast_nonneg _) (hδ z)]
  · rw [← expect_const_mul', ← expect_add']
    exact expect_le_expect fun z ↦ pointwise_ineq hβ hβ1 (k z) (hδ z)

/-! ### The induction -/

open Classical in
/-- $h_A$ as a natural number. -/
noncomputable def hN {n : ℕ} (A : Set ({0,1}^n)) (z : {0,1}^n) : ℕ :=
  if z ∈ A then #{i : Fin n | z + e i ∉ A} else 0

/-- $h_A=$ `hN A` (cast to $\mathbb{R}$). -/
theorem h_eq_hN {n : ℕ} (A : Set ({0,1}^n)) (z : {0,1}^n) : h A z = hN A z := by
  simp only [h, hN]
  split_ifs <;> simp

/-- The induction step of the Kahn–Park argument for two slices $P$, $R$ with $|P|\le|R|$. -/
theorem kp_step {β : ℝ} (hβ : 2⁻¹ ≤ β) (hβ1 : β ≤ 1) (B : ℝ → ℝ)
    (hB : ∀ x ∈ Set.Icc (0 : ℝ) 1, 0 ≤ B x)
    (h22 : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β B x y ≥ 0) {n : ℕ}
    (P R : Set ({0,1}^n)) (hPR : ｜P｜ ≤ ｜R｜) (hP : B ｜P｜ ≤ 𝐄 (h P ^ β))
    (hR : B ｜R｜ ≤ 𝐄 (h R ^ β)) :
    2 * B ((｜P｜ + ｜R｜) / 2) ≤
      𝐄 (fun z ↦ (h P z + 𝟏 (P \ R) z) ^ β) + 𝐄 (fun z ↦ (h R z + 𝟏 (R \ P) z) ^ β) := by
  have hβ0 : 0 < β := lt_of_lt_of_le (by norm_num) hβ
  have tP : 𝐄 (h P ^ β) ≤ 𝐄 (fun z ↦ (h P z + 𝟏 (P \ R) z) ^ β) := by
    refine expect_le_expect fun z ↦ ?_
    rw [Pi.pow_apply, h_eq_hN]
    exact Real.rpow_le_rpow (Nat.cast_nonneg _) (le_add_of_nonneg_right (ind_mem_Icc _ z).1)
      hβ0.le
  have tR := expect_incr hβ0 hβ1 (hN R) (R \ P)
  have eR : (𝐄 fun z ↦ ((hN R z : ℕ) : ℝ) ^ β) = 𝐄 (h R ^ β) := by
    congr 1; funext z; rw [Pi.pow_apply, h_eq_hN]
  have eR' : (𝐄 fun z ↦ (((hN R z : ℕ) : ℝ) + 𝟏 (R \ P) z) ^ β) =
      𝐄 (fun z ↦ (h R z + 𝟏 (R \ P) z) ^ β) := by
    congr 1; funext z; rw [h_eq_hN]
  rw [eR, eR'] at tR
  have hd : ｜R｜ - ｜P｜ ≤ 𝐄 𝟏 (R \ P) := by
    have hpt : ∀ z, 𝟏 R z - 𝟏 P z ≤ 𝟏 (R \ P) z := by
      intro z; by_cases hz : z ∈ R <;> by_cases hz' : z ∈ P <;> simp [ind, hz, hz']
    have := expect_le_expect hpt
    rwa [expect_sub'] at this
  have hP01 := dens_mem_Icc P
  have hR01 := dens_mem_Icc R
  have hBR : 0 ≤ B ｜R｜ := hB _ hR01
  have hc : 0 ≤ (2 : ℝ) ^ β - 1 := by
    have := Real.one_le_rpow (by norm_num : (1 : ℝ) ≤ 2) hβ0.le
    linarith
  have n1 : Nq β (｜R｜ - ｜P｜) (B ｜R｜) ≤ Nq β (𝐄 𝟏 (R \ P)) (𝐄 (h R ^ β)) :=
    Nq_mono hβ0 (by linarith) hBR hd hR
  have n2 : ｜R｜ - ｜P｜ + (2 ^ β - 1) * B ｜R｜ ≤
      𝐄 𝟏 (R \ P) + (2 ^ β - 1) * 𝐄 (h R ^ β) := by
    nlinarith
  have hG := h22 ｜P｜ ｜R｜ hP01.1 hPR hR01.2
  simp only [G, G₁, G₂, ge_iff_le, le_max_iff] at hG
  have m1 := le_max_left (Nq β (𝐄 𝟏 (R \ P)) (𝐄 (h R ^ β)))
    (𝐄 𝟏 (R \ P) + (2 ^ β - 1) * 𝐄 (h R ^ β))
  have m2 := le_max_right (Nq β (𝐄 𝟏 (R \ P)) (𝐄 (h R ^ β)))
    (𝐄 𝟏 (R \ P) + (2 ^ β - 1) * 𝐄 (h R ^ β))
  simp only [Nq] at n1 m1 m2 tR
  rcases hG with hG | hG <;> linarith

/-- **Kahn–Park inequality** ([DIR], Proposition 2.1, for $\frac12\le\beta\le1$): if $B\ge0$ on
$[0,1]$, $B(0)=B(1)=0$ and $G_\beta[B](x,y)\ge0$ for $0\le x\le y\le1$, then
$\mathbf{E}h_A^\beta\ge B(|A|)$ for every $n\ge0$ and $A\subset\{0,1\}^n$. -/
theorem kp_ineq {β : ℝ} (hβ : 2⁻¹ ≤ β) (hβ1 : β ≤ 1) (B : ℝ → ℝ)
    (hB : ∀ x ∈ Set.Icc (0 : ℝ) 1, 0 ≤ B x) (hB0 : B 0 = 0) (hB1 : B 1 = 0)
    (h22 : ∀ x y : ℝ, 0 ≤ x → x ≤ y → y ≤ 1 → G β B x y ≥ 0) :
    ∀ (n : ℕ) (A : Set ({0,1}^n)), B ｜A｜ ≤ 𝐄 (h A ^ β) := by
  have hβ0 : 0 < β := lt_of_lt_of_le (by norm_num) hβ
  intro n
  induction n with
  | zero =>
    intro A
    have hh : h A ^ β = 0 := by
      funext x
      simp [h, Real.zero_rpow hβ0.ne']
    have hA : ｜A｜ = 0 ∨ ｜A｜ = 1 := by
      by_cases hx : (default : {0,1}^0) ∈ A
      · right
        have : A = Set.univ := Set.eq_univ_of_forall fun y ↦ by
          rwa [Subsingleton.elim y default]
        subst this
        have : 𝟏 (Set.univ : Set ({0,1}^0)) = fun _ ↦ 1 := by funext y; simp [ind]
        rw [dens, this, expect_one']
      · left
        have : A = ∅ := Set.eq_empty_of_forall_notMem fun y ↦ by
          rwa [Subsingleton.elim y default]
        subst this
        simp [dens, ind, expect]
    rw [hh]
    rcases hA with hA0 | hA1
    · simp [hA0, hB0, expect]
    · simp [hA1, hB1, expect]
  | succ n ih =>
    intro A
    have h10 : (1 : ZMod 2) + 1 = 0 := by decide
    have hE : 𝐄 (h A ^ β) =
        2⁻¹ * (𝐄 (fun z ↦ (h (slice A 0) z + 𝟏 (slice A 0 \ slice A 1) z) ^ β) +
          𝐄 (fun z ↦ (h (slice A 1) z + 𝟏 (slice A 1 \ slice A 0) z) ^ β)) := by
      rw [expect_succ]
      congr 2
      · congr 1; funext z
        rw [Pi.pow_apply, h_cons, zero_add]
        congr 2
        by_cases h0 : z ∈ slice A 0 <;> by_cases h1 : z ∈ slice A 1 <;> simp [ind, h0, h1]
      · congr 1; funext z
        rw [Pi.pow_apply, h_cons, h10]
        congr 2
        by_cases h0 : z ∈ slice A 0 <;> by_cases h1 : z ∈ slice A 1 <;> simp [ind, h0, h1]
    have hd : ｜A｜ = (｜slice A 0｜ + ｜slice A 1｜) / 2 := by
      rw [dens, expect_succ, dens, dens]
      have e : ∀ i : ZMod 2, (fun z : {0,1}^n ↦ 𝟏 A (Fin.cons i z)) = 𝟏 (slice A i) := by
        intro i; funext z
        by_cases hz : z ∈ slice A i
        · have : (Fin.cons i z : {0,1}^(n + 1)) ∈ A := hz
          simp [ind, hz, this]
        · have : (Fin.cons i z : {0,1}^(n + 1)) ∉ A := hz
          simp [ind, hz, this]
      rw [e 0, e 1]
      ring
    rcases le_total (｜slice A 0｜) (｜slice A 1｜) with h01 | h01
    · have := kp_step hβ hβ1 B hB h22 (slice A 0) (slice A 1) h01 (ih _) (ih _)
      rw [hE, hd]
      linarith
    · have := kp_step hβ hβ1 B hB h22 (slice A 1) (slice A 0) h01 (ih _) (ih _)
      rw [add_comm (｜slice A 1｜)] at this
      rw [hE, hd]
      linarith

end Auto.DIR

/-!
## Auxiliary lemmas for [DIR] (1.3): Hart's formula for $\mathcal{B}_1$

[DIR] cites (1.3) from Hart [Hart76]. We prove it by the classical argument:

* with $f(K)=\sum_{j<K}s(j)$ ($s$ = binary digit sum), $f(2K)=2f(K)+K$,
  $f(2K+1)=2f(K)+K+s(K)$, and $f(a)+f(b)+\min(a,b)\le f(a+b)$ (strong induction on $a+b$, by
  parity);
* for $A\subset\{0,1\}^m$ with $K=\#A$: $\sum_xh_A(x)\ge mK-2f(K)$ (induction on $m$ by slicing
  along the first coordinate), with equality for the "initial segments" `segS m K`;
* the value $x(m-\frac2K f(K))$ only depends on $x=K2^{-m}$.
-/

namespace Auto.DIR

open Real Finset

/-! ### Binary digit sums -/

/-- $s(2j)=s(j)$. -/
theorem s_two_mul (j : ℕ) : s (2 * j) = s j := by
  rcases Nat.eq_zero_or_pos j with rfl | hj
  · simp [s]
  · simp only [s]
    rw [Nat.digits_def' (by norm_num) (by omega), Nat.mul_mod_right,
      Nat.mul_div_cancel_left j (by norm_num : 0 < 2), List.sum_cons, zero_add]

/-- $s(2j+1)=s(j)+1$. -/
theorem s_two_mul_add_one (j : ℕ) : s (2 * j + 1) = s j + 1 := by
  simp only [s]
  have h1 : (2 * j + 1) % 2 = 1 := by omega
  have h2 : (2 * j + 1) / 2 = j := by omega
  rw [Nat.digits_def' (by norm_num) (by omega), h1, h2, List.sum_cons, add_comm]

/-- $f(K)=\sum_{j<K}s(j)$, the number of edges of the subgraph of the cube spanned by the
first $K$ vertices in binary order. -/
def fH (K : ℕ) : ℕ := ∑ j ∈ Finset.range K, s j

/-- $f(K+1)=f(K)+s(K)$. -/
theorem fH_succ (K : ℕ) : fH (K + 1) = fH K + s K := by
  simp only [fH, Finset.sum_range_succ]

/-- $f(2K)=2f(K)+K$. -/
theorem fH_two_mul (K : ℕ) : fH (2 * K) = 2 * fH K + K := by
  induction K with
  | zero => simp [fH]
  | succ K ih =>
    rw [show 2 * (K + 1) = 2 * K + 1 + 1 by ring, fH_succ, fH_succ, ih, fH_succ,
      s_two_mul, s_two_mul_add_one]
    ring

/-- $f(2K+1)=2f(K)+K+s(K)$. -/
theorem fH_two_mul_add_one (K : ℕ) : fH (2 * K + 1) = 2 * fH K + K + s K := by
  rw [fH_succ, fH_two_mul, s_two_mul]

/-- $f(0)=f(1)=0$. -/
theorem fH_le_one {K : ℕ} (hK : K ≤ 1) : fH K = 0 := by
  interval_cases K <;> simp [fH, s]

/-- The key inequality $f(a)+f(b)+\min(a,b)\le f(a+b)$. -/
theorem fH_add_ge (a b : ℕ) : fH a + fH b + min a b ≤ fH (a + b) := by
  suffices H : ∀ N a b, a + b = N → fH a + fH b + min a b ≤ fH (a + b) from H _ a b rfl
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro a b hab
  rcases Nat.eq_zero_or_pos a with rfl | ha
  · simp [fH]
  rcases Nat.eq_zero_or_pos b with rfl | hb
  · simp [fH]
  obtain ⟨a', rfl | rfl⟩ := Nat.even_or_odd' a <;> obtain ⟨b', rfl | rfl⟩ := Nat.even_or_odd' b
  · -- even, even
    have h1 := ih (a' + b') (by omega) a' b' rfl
    rw [show 2 * a' + 2 * b' = 2 * (a' + b') by ring, fH_two_mul, fH_two_mul, fH_two_mul]
    omega
  · -- even, odd
    have h1 := ih (a' + b') (by omega) a' b' rfl
    have h2 := ih (a' + (b' + 1)) (by omega) a' (b' + 1) rfl
    rw [show 2 * a' + (2 * b' + 1) = 2 * (a' + b') + 1 by ring, fH_two_mul,
      fH_two_mul_add_one, fH_two_mul_add_one]
    rw [show a' + (b' + 1) = a' + b' + 1 by ring, fH_succ, fH_succ] at h2
    omega
  · -- odd, even
    have h1 := ih (a' + b') (by omega) a' b' rfl
    have h2 := ih (a' + 1 + b') (by omega) (a' + 1) b' rfl
    rw [show 2 * a' + 1 + 2 * b' = 2 * (a' + b') + 1 by ring, fH_two_mul,
      fH_two_mul_add_one, fH_two_mul_add_one]
    rw [show a' + 1 + b' = a' + b' + 1 by ring, fH_succ, fH_succ] at h2
    omega
  · -- odd, odd
    have h1 := ih (a' + (b' + 1)) (by omega) a' (b' + 1) rfl
    have h2 := ih (a' + 1 + b') (by omega) (a' + 1) b' rfl
    rw [show 2 * a' + 1 + (2 * b' + 1) = 2 * (a' + b' + 1) by ring, fH_two_mul,
      fH_two_mul_add_one, fH_two_mul_add_one]
    rw [show a' + (b' + 1) = a' + b' + 1 by ring, fH_succ] at h1
    rw [show a' + 1 + b' = a' + b' + 1 by ring, fH_succ] at h2
    omega

/-- $2f(k2^t)=2^t(2f(k)+tk)$. -/
theorem fH_mul_two_pow (k t : ℕ) : 2 * fH (k * 2 ^ t) = 2 ^ t * (2 * fH k + t * k) := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [pow_succ, show k * (2 ^ t * 2) = 2 * (k * 2 ^ t) by ring, fH_two_mul]
    nlinarith [ih]

/-! ### Counting on the cube -/

open Classical in
/-- $\#A$ for $A\subset\{0,1\}^m$. -/
noncomputable def cardN {m : ℕ} (A : Set ({0,1}^m)) : ℕ := #{x : {0,1}^m | x ∈ A}

open Classical in
/-- $\#A=\#A_0+\#A_1$. -/
theorem cardN_succ {m : ℕ} (A : Set ({0,1}^(m + 1))) :
    cardN A = cardN (slice A 0) + cardN (slice A 1) := by
  simp only [cardN, Finset.card_filter]
  rw [sum_cube_succ, Finset.sum_add_distrib]
  rfl

open Classical in
/-- $\sum_xh_A(x)=\sum_zh_{A_0}(z)+\sum_zh_{A_1}(z)+\#(A_0\setminus A_1)+\#(A_1\setminus A_0)$. -/
theorem sum_h_succ {m : ℕ} (A : Set ({0,1}^(m + 1))) :
    ∑ x, h A x = ∑ z, h (slice A 0) z + ∑ z, h (slice A 1) z +
      #{z : {0,1}^m | z ∈ slice A 0 ∧ z ∉ slice A 1} +
      #{z : {0,1}^m | z ∈ slice A 1 ∧ z ∉ slice A 0} := by
  have h10 : (1 : ZMod 2) + 1 = 0 := by decide
  rw [sum_cube_succ]
  simp only [h_cons, zero_add, h10, Finset.sum_add_distrib, Finset.sum_boole]
  ring

open Classical in
/-- $\#(A\setminus B)+\#(A\cap B)=\#A$. -/
theorem card_diff_add_inter {m : ℕ} (A B : Set ({0,1}^m)) :
    #{z : {0,1}^m | z ∈ A ∧ z ∉ B} + #{z : {0,1}^m | z ∈ A ∧ z ∈ B} = cardN A := by
  rw [cardN, ← Finset.card_filter_add_card_filter_not (s := Finset.univ.filter (· ∈ A))
    (fun z ↦ z ∈ B), add_comm]
  congr 1 <;> congr 1 <;> ext z <;> simp

open Classical in
/-- $\#(A\cap B)\le\#B$. -/
theorem card_inter_le_right {m : ℕ} (A B : Set ({0,1}^m)) :
    #{z : {0,1}^m | z ∈ A ∧ z ∈ B} ≤ cardN B := by
  refine Finset.card_le_card fun z hz ↦ ?_
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hz ⊢
  exact hz.2

/-- $h_A\ge0$. -/
theorem h_nonneg {m : ℕ} (A : Set ({0,1}^m)) (x : {0,1}^m) : 0 ≤ h A x := by
  unfold h; split_ifs <;> positivity

/-- The edge-isoperimetric inequality: $\sum_xh_A(x)\ge mK-2f(K)$, $K=\#A$. -/
theorem sum_h_ge (m : ℕ) (A : Set ({0,1}^m)) :
    (m : ℝ) * cardN A - 2 * fH (cardN A) ≤ ∑ x, h A x := by
  induction m with
  | zero =>
    classical
    have hK : cardN A ≤ 1 := by
      calc cardN A ≤ (Finset.univ : Finset ({0,1}^0)).card := Finset.card_filter_le _ _
        _ = 1 := by simp
    rw [fH_le_one hK]
    simp only [CharP.cast_eq_zero, zero_mul, mul_zero, sub_zero]
    exact Finset.sum_nonneg fun x _ ↦ h_nonneg A x
  | succ m ih =>
    classical
    rw [sum_h_succ, cardN_succ]
    have i0 := ih (slice A 0)
    have i1 := ih (slice A 1)
    have c0 := card_diff_add_inter (slice A 0) (slice A 1)
    have c1 := card_diff_add_inter (slice A 1) (slice A 0)
    have hc : #{z : {0,1}^m | z ∈ slice A 1 ∧ z ∈ slice A 0} =
        #{z : {0,1}^m | z ∈ slice A 0 ∧ z ∈ slice A 1} := by
      congr 1; ext z; simp [and_comm]
    have hle0 := card_inter_le_right (slice A 1) (slice A 0)
    have hle1 := card_inter_le_right (slice A 0) (slice A 1)
    have key := fH_add_ge (cardN (slice A 0)) (cardN (slice A 1))
    set a := cardN (slice A 0)
    set b := cardN (slice A 1)
    set c := #{z : {0,1}^m | z ∈ slice A 0 ∧ z ∈ slice A 1}
    set d0 := #{z : {0,1}^m | z ∈ slice A 0 ∧ z ∉ slice A 1}
    set d1 := #{z : {0,1}^m | z ∈ slice A 1 ∧ z ∉ slice A 0}
    rw [hc] at c1 hle0
    have hcm : c ≤ min a b := le_min hle0 hle1
    have key' : fH a + fH b + c ≤ fH (a + b) := by
      have := Nat.add_le_add_left hcm (fH a + fH b); omega
    have key'' : (fH a : ℝ) + fH b + c ≤ fH (a + b) := by exact_mod_cast key'
    have c0' : (d0 : ℝ) + c = a := by exact_mod_cast c0
    have c1' : (d1 : ℝ) + c = b := by exact_mod_cast c1
    push_cast
    nlinarith

/-! ### Initial segments -/

/-- The initial segment of the first $K$ vertices of $\{0,1\}^m$ in binary order (first
coordinate = least significant bit), defined recursively. -/
def segS : (m : ℕ) → ℕ → Set ({0,1}^m)
  | 0, K => {_x | 1 ≤ K}
  | m + 1, K => {x | (x 0 = 0 ∧ Fin.tail x ∈ segS m ((K + 1) / 2)) ∨
      (x 0 = 1 ∧ Fin.tail x ∈ segS m (K / 2))}

/-- Slices of initial segments. -/
theorem slice_segS (m K : ℕ) :
    slice (segS (m + 1) K) 0 = segS m ((K + 1) / 2) ∧
      slice (segS (m + 1) K) 1 = segS m (K / 2) := by
  have h01 : (0 : ZMod 2) ≠ 1 := by decide
  constructor <;> ext z <;> simp [slice, segS, h01, h01.symm]

/-- Initial segments are increasing in $K$. -/
theorem segS_mono (m : ℕ) {K K' : ℕ} (hK : K ≤ K') : segS m K ⊆ segS m K' := by
  induction m generalizing K K' with
  | zero => intro x hx; simp only [segS, Set.mem_ofPred_eq] at hx ⊢; omega
  | succ m ih =>
    intro x hx
    simp only [segS, Set.mem_ofPred_eq] at hx ⊢
    rcases hx with ⟨h0, h1⟩ | ⟨h0, h1⟩
    · exact Or.inl ⟨h0, ih (by omega) h1⟩
    · exact Or.inr ⟨h0, ih (by omega) h1⟩

/-- $\#\mathrm{segS}(m,K)=K$ for $K\le2^m$. -/
theorem cardN_segS (m K : ℕ) (hK : K ≤ 2 ^ m) : cardN (segS m K) = K := by
  induction m generalizing K with
  | zero =>
    classical
    have hK1 : K ≤ 1 := by simpa using hK
    rcases Nat.lt_or_ge K 1 with h | h
    · have : K = 0 := by omega
      subst this; simp [cardN, segS]
    · have : K = 1 := by omega
      subst this; simp [cardN, segS]
  | succ m ih =>
    rw [cardN_succ, (slice_segS m K).1, (slice_segS m K).2, ih _ (by rw [pow_succ] at hK; omega),
      ih _ (by rw [pow_succ] at hK; omega)]
    omega

/-- Equality for initial segments: $\sum_xh_S(x)=mK-2f(K)$, $S=\mathrm{segS}(m,K)$, $K\le2^m$. -/
theorem sum_h_segS (m K : ℕ) (hK : K ≤ 2 ^ m) :
    ∑ x, h (segS m K) x = (m : ℝ) * K - 2 * fH K := by
  induction m generalizing K with
  | zero =>
    have hK1 : K ≤ 1 := by simpa using hK
    rw [fH_le_one hK1]
    simp [h]
  | succ m ih =>
    classical
    have hK0 : (K + 1) / 2 ≤ 2 ^ m := by rw [pow_succ] at hK; omega
    have hK1 : K / 2 ≤ 2 ^ m := by rw [pow_succ] at hK; omega
    have hsub : segS m (K / 2) ⊆ segS m ((K + 1) / 2) := segS_mono m (by omega)
    rw [sum_h_succ, (slice_segS m K).1, (slice_segS m K).2, ih _ hK0, ih _ hK1]
    have e1 : #{z : {0,1}^m | z ∈ segS m (K / 2) ∧ z ∉ segS m ((K + 1) / 2)} = 0 := by
      rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      exact fun z _ hz ↦ hz.2 (hsub hz.1)
    have e2 := card_diff_add_inter (segS m ((K + 1) / 2)) (segS m (K / 2))
    have e3 : #{z : {0,1}^m | z ∈ segS m ((K + 1) / 2) ∧ z ∈ segS m (K / 2)} = K / 2 := by
      refine Eq.trans ?_ (cardN_segS m (K / 2) hK1)
      rw [cardN]
      congr 1; ext z; simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨fun h ↦ h.2, fun h ↦ ⟨hsub h, h⟩⟩
    rw [cardN_segS m _ hK0, e3] at e2
    rw [e1]
    have hf : fH K = fH ((K + 1) / 2) + fH (K / 2) + K / 2 := by
      obtain ⟨k, rfl | rfl⟩ := Nat.even_or_odd' K
      · rw [show (2 * k + 1) / 2 = k by omega, show 2 * k / 2 = k by omega, fH_two_mul]; ring
      · rw [show (2 * k + 1 + 1) / 2 = k + 1 by omega, show (2 * k + 1) / 2 = k by omega,
          fH_two_mul_add_one, fH_succ]; ring
    have hKs : (K + 1) / 2 + K / 2 = K := by omega
    have e2' : ((#{z : {0,1}^m | z ∈ segS m ((K + 1) / 2) ∧ z ∉ segS m (K / 2)} : ℕ) : ℝ) =
        ((K + 1) / 2 : ℕ) - (K / 2 : ℕ) := by
      have : (#{z : {0,1}^m | z ∈ segS m ((K + 1) / 2) ∧ z ∉ segS m (K / 2)} : ℕ) =
          (K + 1) / 2 - K / 2 := by omega
      rw [this, Nat.cast_sub (by omega)]
    rw [e2', hf]
    have hKr : (K : ℝ) = ((K + 1) / 2 : ℕ) + (K / 2 : ℕ) := by exact_mod_cast hKs.symm
    rw [hKr]
    push_cast
    ring

/-- The value $m-\frac2Kf(K)$ only depends on $K2^{-m}$: if $K2^n=k2^m$ ($k,K\ge1$), then
$m-\frac{2f(K)}K=n-\frac{2f(k)}k$. -/
theorem hart_value_eq {m n K k : ℕ} (hk : 1 ≤ k) (hK : 1 ≤ K) (h : K * 2 ^ n = k * 2 ^ m) :
    (m : ℝ) - 2 * fH K / K = n - 2 * fH k / k := by
  have key : ∀ {m n K k : ℕ}, 1 ≤ k → n ≤ m → K * 2 ^ n = k * 2 ^ m →
      (m : ℝ) - 2 * fH K / K = n - 2 * fH k / k := by
    intro m n K k hk hnm h
    obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hnm
    have hKk : K = k * 2 ^ t := by
      rw [pow_add] at h
      have h2 : 0 < 2 ^ n := by positivity
      nlinarith [Nat.eq_of_mul_eq_mul_right h2 (show K * 2 ^ n = k * 2 ^ t * 2 ^ n by
        rw [h]; ring)]
    subst hKk
    have hf := fH_mul_two_pow k t
    have hf' : (2 : ℝ) * fH (k * 2 ^ t) = 2 ^ t * (2 * fH k + t * k) := by exact_mod_cast hf
    have hk0 : (0 : ℝ) < k := by exact_mod_cast hk
    have ht0 : (0 : ℝ) < 2 ^ t := by positivity
    push_cast
    rw [hf']
    field_simp
    ring
  rcases le_total n m with hnm | hmn
  · exact key hk hnm h
  · exact (key hK hmn h.symm).symm

end Auto.DIR

/-!
## Auxiliary lemmas for [DIR] §3 Variants of Bobkov's inequality

Auxiliary material for `3_0_Variants_Bobkov_Inequality.lean`:

* calculus helpers for functions that are $C^2$ on an open set;
* a maximum principle for $h''$ positive where $h$ is positive;
* an API for the standard Gaussian density `gDens`, distribution function `gCDF`, its inverse
  `gInv` and the Gaussian isoperimetric profile `gProf`. These are definitionally equal to
  `Auto.DIR.φ`, `Auto.DIR.Φ`, `Function.invFun Auto.DIR.Φ` and `Auto.DIR.I` of the main file
  (e.g. `(rfl : I = gProf)`), so the lemmas here apply to those;
* the function $G_c$ of the proof of Proposition 3.3 and its derivatives;
* the tensorization argument of Lemma 3.1 (`tensor_two_point`, with $Mf$ written out as
  `gradPlus`);
* [BIM23] (Beltran–Ivanisvili–Madrid, arXiv:2303.06738), Lemmas 2.2 and 2.3 for
  $L_\beta(x)=x(\log_2(1/x))^\beta$ (`bim_lemma_2_2`, `bim_lemma_2_3`).
-/

namespace Auto.DIR

open Real Set MeasureTheory Filter Topology

open scoped ContDiff

/-! ### Calculus helpers -/

/-- A function that is $C^2$ on an open set is differentiable at each point of it, and so is its
derivative. -/
theorem contDiffOn_two_differentiableAt {f : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) {x : ℝ} (hx : x ∈ s) :
    DifferentiableAt ℝ f x ∧ DifferentiableAt ℝ (deriv f) x := by
  have h := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) hs).1 hf
  exact ⟨(h.1 x hx).differentiableAt (hs.mem_nhds hx),
    ((h.2.2.differentiableOn one_ne_zero) x hx).differentiableAt (hs.mem_nhds hx)⟩

/-- For a function that is $C^2$ on an open set, the second derivative is continuous there. -/
theorem contDiffOn_two_continuousOn_deriv2 {f : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) : ContinuousOn (deriv (deriv f)) s := by
  have h := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) hs).1 hf
  have h2 := (contDiffOn_succ_iff_deriv_of_isOpen (n := 0) hs).1 h.2.2
  exact h2.2.2.continuousOn

/-- Maximum principle: if $h$ is continuous on $[a,b]$, $h(a),h(b)\le0$, and $h''>0$ at every
interior point where $h>0$, then $h\le0$ on $[a,b]$. -/
theorem max_principle_aux {h : ℝ → ℝ} {a b : ℝ} (hc : ContinuousOn h (Icc a b))
    (hd : ∀ x ∈ Ioo a b, 0 < h x → 0 < deriv (deriv h) x) (ha : h a ≤ 0) (hb : h b ≤ 0) :
    ∀ x ∈ Icc a b, h x ≤ 0 := by
  intro x hx
  by_contra hpos
  rw [not_le] at hpos
  obtain ⟨c, hcI, hcmax⟩ := isCompact_Icc.exists_isMaxOn ⟨x, hx⟩ hc
  have hcpos : 0 < h c := hpos.trans_le (hcmax hx)
  have hca : c ≠ a := fun e ↦ by rw [e] at hcpos; linarith
  have hcb : c ≠ b := fun e ↦ by rw [e] at hcpos; linarith
  have hcI' : c ∈ Ioo a b := ⟨lt_of_le_of_ne hcI.1 (Ne.symm hca), lt_of_le_of_ne hcI.2 hcb⟩
  have hev : ∀ᶠ t in 𝓝 c, 0 < h t ∧ t ∈ Ioo a b :=
    ((hc.continuousAt (Icc_mem_nhds hcI'.1 hcI'.2)).eventually (lt_mem_nhds hcpos)).and
      (Ioo_mem_nhds hcI'.1 hcI'.2)
  obtain ⟨ε, hε, hεP⟩ := Metric.eventually_nhds_iff.1 hev
  have hP : ∀ t ∈ Icc (c - ε / 2) (c + ε / 2), 0 < h t ∧ t ∈ Ioo a b := by
    intro t ht
    apply hεP
    rw [Real.dist_eq, abs_lt]
    constructor <;> linarith [ht.1, ht.2]
  have hsub : Icc (c - ε / 2) (c + ε / 2) ⊆ Icc a b := fun t ht ↦ Ioo_subset_Icc_self (hP t ht).2
  have hconv : StrictConvexOn ℝ (Icc (c - ε / 2) (c + ε / 2)) h := by
    refine strictConvexOn_of_deriv2_pos (convex_Icc _ _) (hc.mono hsub) ?_
    intro t ht
    rw [interior_Icc] at ht
    have := hP t (Ioo_subset_Icc_self ht)
    simpa using hd t this.2 this.1
  have h1 : c - ε / 2 ∈ Icc (c - ε / 2) (c + ε / 2) := ⟨le_rfl, by linarith⟩
  have h2 : c + ε / 2 ∈ Icc (c - ε / 2) (c + ε / 2) := ⟨by linarith, le_rfl⟩
  have key := hconv.2 h1 h2 (by linarith) (by norm_num : (0 : ℝ) < 2⁻¹)
    (by norm_num : (0 : ℝ) < 2⁻¹)
    (by norm_num)
  have hmid : (2⁻¹ : ℝ) • (c - ε / 2) + (2⁻¹ : ℝ) • (c + ε / 2) = c := by
    simp only [smul_eq_mul]; ring
  rw [hmid] at key
  have m1 : h (c - ε / 2) ≤ h c := hcmax (hsub h1)
  have m2 : h (c + ε / 2) ≤ h c := hcmax (hsub h2)
  simp only [smul_eq_mul] at key
  linarith

/-! ### The standard Gaussian density and distribution function -/

/-- The standard Gaussian density $\varphi(t)=(2\pi)^{-1/2}e^{-t^2/2}$ (definitionally equal to
`Auto.DIR.φ`). -/
noncomputable def gDens (t : ℝ) : ℝ := (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-t ^ 2 / 2)

/-- The standard Gaussian distribution function $\Phi(t)=\int_{-\infty}^t\varphi$ (definitionally
equal to `Auto.DIR.Φ`). -/
noncomputable def gCDF (t : ℝ) : ℝ := ∫ s in Iic t, gDens s

/-- The inverse $\Phi^{-1}$ of the Gaussian distribution function (as `Function.invFun`). -/
noncomputable def gInv (x : ℝ) : ℝ := Function.invFun gCDF x

/-- The Gaussian isoperimetric profile $I=\varphi\circ\Phi^{-1}$ on $(0,1)$, $0$ elsewhere
(definitionally equal to `Auto.DIR.I`). -/
noncomputable def gProf (x : ℝ) : ℝ := if 0 < x ∧ x < 1 then gDens (gInv x) else 0

/-- The normalizing constant: $(2\pi)^{-1/2}=1/\sqrt{2\pi}$. -/
theorem gConst_eq : (2 * π) ^ (-(2⁻¹ : ℝ)) = (√(2 * π))⁻¹ := by
  rw [rpow_neg (by positivity), sqrt_eq_rpow, inv_eq_one_div 2]

/-- The normalizing constant is positive. -/
theorem gConst_pos : 0 < (2 * π) ^ (-(2⁻¹ : ℝ)) := by positivity

/-- $\varphi>0$. -/
theorem gDens_pos (t : ℝ) : 0 < gDens t := by unfold gDens; positivity

/-- $\varphi$ is even. -/
theorem gDens_neg (t : ℝ) : gDens (-t) = gDens t := by simp [gDens]

/-- $\varphi(0)=(2\pi)^{-1/2}$. -/
theorem gDens_zero : gDens 0 = (2 * π) ^ (-(2⁻¹ : ℝ)) := by simp [gDens]

/-- $\varphi$ is smooth. -/
theorem contDiff_gDens : ContDiff ℝ ∞ gDens := by
  unfold gDens; fun_prop

/-- $\varphi$ is continuous. -/
theorem continuous_gDens : Continuous gDens := contDiff_gDens.continuous

/-- $\varphi'(t)=-t\varphi(t)$. -/
theorem hasDerivAt_gDens (t : ℝ) : HasDerivAt gDens (-t * gDens t) t := by
  unfold gDens
  have h : HasDerivAt (fun s : ℝ ↦ -s ^ 2 / 2) (-t) t := by
    have := ((hasDerivAt_pow 2 t).neg).div_const 2
    convert this using 1; push_cast; ring
  convert (h.exp).const_mul ((2 * π) ^ (-(2⁻¹ : ℝ))) using 1
  ring

/-- $\varphi$ is antitone on $[0,\infty)$. -/
theorem gDens_antitoneOn : AntitoneOn gDens (Ici 0) := by
  intro a ha b hb hab
  unfold gDens
  gcongr

/-- $\varphi$ is strictly antitone on $[0,\infty)$. -/
theorem gDens_strictAntiOn : StrictAntiOn gDens (Ici 0) := by
  intro a ha b hb hab
  unfold gDens
  have : -b ^ 2 / 2 < -a ^ 2 / 2 := by simp only [mem_Ici] at ha; nlinarith
  exact mul_lt_mul_of_pos_left (exp_lt_exp.2 this) gConst_pos

/-- $\varphi$ is integrable. -/
theorem integrable_gDens : Integrable gDens := by
  have h := (integrable_exp_neg_mul_sq (b := 2⁻¹) (by norm_num)).const_mul
    ((2 * π) ^ (-(2⁻¹ : ℝ)))
  refine h.congr (ae_of_all _ fun t ↦ ?_)
  simp only [gDens]; congr 2; ring

/-- $\int\varphi=1$. -/
theorem integral_gDens : ∫ t, gDens t = 1 := by
  have h : (fun t ↦ gDens t) = fun t ↦ (2 * π) ^ (-(2⁻¹ : ℝ)) * exp (-2⁻¹ * t ^ 2) := by
    funext t; simp only [gDens]; congr 2; ring
  rw [h, integral_const_mul, integral_gaussian, gConst_eq]
  have : π / 2⁻¹ = 2 * π := by ring
  rw [this, inv_mul_cancel₀ (by positivity)]

/-- $\Phi(b)-\Phi(a)=\int_a^b\varphi$. -/
theorem gCDF_sub (a b : ℝ) : gCDF b - gCDF a = ∫ t in a..b, gDens t :=
  intervalIntegral.integral_Iic_sub_Iic integrable_gDens.integrableOn integrable_gDens.integrableOn

/-- $\Phi(t)=\Phi(0)+\int_0^t\varphi$. -/
theorem gCDF_eq (t : ℝ) : gCDF t = gCDF 0 + ∫ s in (0 : ℝ)..t, gDens s := by
  rw [← gCDF_sub]; ring

/-- $\Phi'=\varphi$. -/
theorem hasDerivAt_gCDF (t : ℝ) : HasDerivAt gCDF (gDens t) t := by
  have h := (continuous_gDens.integral_hasStrictDerivAt 0 t).hasDerivAt.const_add (gCDF 0)
  have he : gCDF = fun t ↦ gCDF 0 + ∫ s in (0 : ℝ)..t, gDens s := funext gCDF_eq
  rw [he]; exact h

/-- $\Phi$ is differentiable. -/
theorem differentiable_gCDF : Differentiable ℝ gCDF := fun t ↦ (hasDerivAt_gCDF t).differentiableAt

/-- $\Phi$ is continuous. -/
theorem continuous_gCDF : Continuous gCDF := differentiable_gCDF.continuous

/-- $\Phi'=\varphi$ (with `deriv`). -/
theorem deriv_gCDF : deriv gCDF = gDens := funext fun t ↦ (hasDerivAt_gCDF t).deriv

/-- $\Phi$ is strictly increasing. -/
theorem strictMono_gCDF : StrictMono gCDF :=
  strictMono_of_deriv_pos fun t ↦ by rw [deriv_gCDF]; exact gDens_pos t

/-- $\Phi(-t)=1-\Phi(t)$. -/
theorem gCDF_neg (t : ℝ) : gCDF (-t) = 1 - gCDF t := by
  have h1 : gCDF (-t) = ∫ s in Ioi t, gDens s := by
    rw [gCDF, ← integral_comp_neg_Ioi]; simp only [gDens_neg]
  have h2 := integral_add_compl (measurableSet_Iic (a := t)) integrable_gDens
  rw [compl_Iic, integral_gDens] at h2
  rw [h1, gCDF]; linarith

/-- $\Phi(0)=\frac12$. -/
theorem gCDF_zero : gCDF 0 = 2⁻¹ := by
  have := gCDF_neg 0; rw [neg_zero] at this; linarith

/-- $\Phi(t)\to1$ as $t\to\infty$. -/
theorem tendsto_gCDF_atTop : Tendsto gCDF atTop (𝓝 1) := by
  have h := tendsto_setIntegral_of_monotone (μ := volume) (f := gDens) (s := fun t : ℝ ↦ Iic t)
    (fun _ ↦ measurableSet_Iic) (fun _ _ h ↦ Iic_subset_Iic.2 h)
    (by rw [iUnion_Iic]; exact integrable_gDens.integrableOn)
  rw [iUnion_Iic, setIntegral_univ, integral_gDens] at h
  exact h

/-- $\Phi(t)\to0$ as $t\to-\infty$. -/
theorem tendsto_gCDF_atBot : Tendsto gCDF atBot (𝓝 0) := by
  have h : Tendsto (fun t ↦ 1 - gCDF (-t)) atBot (𝓝 (1 - 1)) :=
    tendsto_const_nhds.sub (tendsto_gCDF_atTop.comp tendsto_neg_atBot_atTop)
  rw [sub_self] at h
  refine h.congr fun t ↦ ?_
  rw [gCDF_neg]; ring

/-- $0<\Phi<1$. -/
theorem gCDF_mem_Ioo (t : ℝ) : gCDF t ∈ Ioo 0 1 := by
  constructor
  · have h := strictMono_gCDF.monotone.le_of_tendsto tendsto_gCDF_atBot (t - 1)
    exact h.trans_lt (strictMono_gCDF (by linarith))
  · have h := strictMono_gCDF.monotone.ge_of_tendsto tendsto_gCDF_atTop (t + 1)
    exact (strictMono_gCDF (by linarith)).trans_le h

/-- $\Phi$ maps onto $(0,1)$. -/
theorem exists_gCDF_eq {x : ℝ} (hx : x ∈ Ioo 0 1) : ∃ t, gCDF t = x := by
  have h1 : ∃ a, gCDF a ≤ x := by
    obtain ⟨a, ha⟩ := (tendsto_gCDF_atBot.eventually (gt_mem_nhds hx.1)).exists
    exact ⟨a, ha.le⟩
  have h2 : ∃ b, x ≤ gCDF b := by
    obtain ⟨b, hb⟩ := (tendsto_gCDF_atTop.eventually (lt_mem_nhds hx.2)).exists
    exact ⟨b, hb.le⟩
  exact mem_range_of_exists_le_of_exists_ge continuous_gCDF h1 h2

/-- $\Phi(\Phi^{-1}(x))=x$ for $x\in(0,1)$. -/
theorem gCDF_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) : gCDF (gInv x) = x :=
  Function.invFun_eq (exists_gCDF_eq hx)

/-- $\Phi^{-1}(\Phi(t))=t$. -/
theorem gInv_gCDF (t : ℝ) : gInv (gCDF t) = t :=
  Function.leftInverse_invFun strictMono_gCDF.injective t

/-- $\Phi^{-1}(x)=t$ iff $\Phi(t)=x$, for $x\in(0,1)$. -/
theorem gInv_eq_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : gInv x = t ↔ gCDF t = x := by
  constructor
  · rintro rfl; exact gCDF_gInv hx
  · rintro rfl; exact gInv_gCDF t

/-- $\Phi^{-1}$ is strictly increasing on $(0,1)$. -/
theorem gInv_strictMonoOn : StrictMonoOn gInv (Ioo 0 1) := by
  intro x hx y hy hxy
  rw [← strictMono_gCDF.lt_iff_lt, gCDF_gInv hx, gCDF_gInv hy]
  exact hxy

/-- $t\le\Phi^{-1}(x)$ iff $\Phi(t)\le x$, for $x\in(0,1)$. -/
theorem le_gInv_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : t ≤ gInv x ↔ gCDF t ≤ x := by
  rw [← strictMono_gCDF.le_iff_le, gCDF_gInv hx]

/-- $\Phi^{-1}(x)\le t$ iff $x\le\Phi(t)$, for $x\in(0,1)$. -/
theorem gInv_le_iff {x t : ℝ} (hx : x ∈ Ioo 0 1) : gInv x ≤ t ↔ x ≤ gCDF t := by
  rw [← strictMono_gCDF.le_iff_le, gCDF_gInv hx]

/-- $\Phi^{-1}(\frac12)=0$. -/
theorem gInv_half : gInv 2⁻¹ = 0 := by
  rw [← gCDF_zero, gInv_gCDF]

/-- $\Phi^{-1}(1-x)=-\Phi^{-1}(x)$ for $x\in(0,1)$. -/
theorem gInv_one_sub {x : ℝ} (hx : x ∈ Ioo 0 1) : gInv (1 - x) = -gInv x := by
  rw [gInv_eq_iff ⟨by linarith [hx.2], by linarith [hx.1]⟩, gCDF_neg, gCDF_gInv hx]

/-- $\Phi^{-1}$ is continuous at every point of $(0,1)$. -/
theorem continuousAt_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) : ContinuousAt gInv x := by
  refine gInv_strictMonoOn.continuousAt_of_image_mem_nhds (Ioo_mem_nhds hx.1 hx.2) ?_
  have : gInv '' Ioo 0 1 = univ := by
    refine eq_univ_of_forall fun t ↦ ⟨gCDF t, gCDF_mem_Ioo t, gInv_gCDF t⟩
  rw [this]; exact univ_mem

/-- $(\Phi^{-1})'(x)=1/\varphi(\Phi^{-1}(x))$ for $x\in(0,1)$. -/
theorem hasDerivAt_gInv {x : ℝ} (hx : x ∈ Ioo 0 1) :
    HasDerivAt gInv (gDens (gInv x))⁻¹ x := by
  refine HasDerivAt.of_local_left_inverse (continuousAt_gInv hx) (hasDerivAt_gCDF _)
    (gDens_pos _).ne' ?_
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using gCDF_gInv hy

/-- $\Phi^{-1}$ is differentiable on $(0,1)$. -/
theorem differentiableOn_gInv : DifferentiableOn ℝ gInv (Ioo 0 1) :=
  fun _ hx ↦ (hasDerivAt_gInv hx).differentiableAt.differentiableWithinAt

/-- $\Phi^{-1}$ is continuous on $(0,1)$. -/
theorem continuousOn_gInv : ContinuousOn gInv (Ioo 0 1) := differentiableOn_gInv.continuousOn

/-- $\Phi^{-1}$ is smooth on $(0,1)$. -/
theorem contDiffOn_gInv : ContDiffOn ℝ ∞ gInv (Ioo 0 1) := by
  have hF : ContDiff ℝ ∞ fun t ↦ (gDens t)⁻¹ :=
    contDiff_gDens.inv fun t ↦ (gDens_pos t).ne'
  have hd : EqOn (deriv gInv) (fun x ↦ (gDens (gInv x))⁻¹) (Ioo 0 1) :=
    fun x hx ↦ (hasDerivAt_gInv hx).deriv
  rw [contDiffOn_infty]
  intro n
  induction n with
  | zero => exact contDiffOn_zero.2 continuousOn_gInv
  | succ n ih =>
    rw [Nat.cast_add, Nat.cast_one, contDiffOn_succ_iff_deriv_of_isOpen isOpen_Ioo]
    refine ⟨differentiableOn_gInv, by simp, ?_⟩
    refine ContDiffOn.congr ?_ hd
    exact (hF.of_le (by exact_mod_cast le_top)).comp_contDiffOn ih

/-- $I(x)=\varphi(\Phi^{-1}(x))$ for $x\in(0,1)$. -/
theorem gProf_of_mem {x : ℝ} (hx : x ∈ Ioo 0 1) : gProf x = gDens (gInv x) := by
  simp [gProf, hx.1, hx.2]

/-- $I(x)=0$ for $x\notin(0,1)$. -/
theorem gProf_of_not_mem {x : ℝ} (hx : x ∉ Ioo 0 1) : gProf x = 0 := by
  unfold gProf
  split_ifs with h
  · exact absurd h hx
  · rfl

/-- $I(0)=0$. -/
theorem gProf_zero : gProf 0 = 0 := gProf_of_not_mem (by simp)

/-- $I(1)=0$. -/
theorem gProf_one : gProf 1 = 0 := gProf_of_not_mem (by simp)

/-- $I>0$ on $(0,1)$. -/
theorem gProf_pos {x : ℝ} (hx : x ∈ Ioo 0 1) : 0 < gProf x := by
  rw [gProf_of_mem hx]; exact gDens_pos _

/-- $I\ge0$. -/
theorem gProf_nonneg (x : ℝ) : 0 ≤ gProf x := by
  by_cases hx : x ∈ Ioo 0 1
  · exact (gProf_pos hx).le
  · rw [gProf_of_not_mem hx]

/-- $I(\Phi(t))=\varphi(t)$. -/
theorem gProf_gCDF (t : ℝ) : gProf (gCDF t) = gDens t := by
  rw [gProf_of_mem (gCDF_mem_Ioo t), gInv_gCDF]

/-- $I(\frac12)=(2\pi)^{-1/2}$. -/
theorem gProf_half : gProf 2⁻¹ = (2 * π) ^ (-(2⁻¹ : ℝ)) := by
  have h := gProf_gCDF 0
  rwa [gCDF_zero, gDens_zero] at h

/-- $I(1-x)=I(x)$. -/
theorem gProf_one_sub (x : ℝ) : gProf (1 - x) = gProf x := by
  by_cases hx : x ∈ Ioo 0 1
  · have hx' : 1 - x ∈ Ioo 0 1 := ⟨by linarith [hx.2], by linarith [hx.1]⟩
    rw [gProf_of_mem hx, gProf_of_mem hx', gInv_one_sub hx, gDens_neg]
  · have hx' : 1 - x ∉ Ioo 0 1 := fun h ↦ hx ⟨by linarith [h.2], by linarith [h.1]⟩
    rw [gProf_of_not_mem hx, gProf_of_not_mem hx']

/-- $I$ agrees with $\varphi\circ\Phi^{-1}$ near each point of $(0,1)$. -/
theorem gProf_eventuallyEq {x : ℝ} (hx : x ∈ Ioo 0 1) :
    gProf =ᶠ[𝓝 x] fun y ↦ gDens (gInv y) := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using gProf_of_mem hy

/-- $I'(x)=-\Phi^{-1}(x)$ for $x\in(0,1)$. -/
theorem hasDerivAt_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : HasDerivAt gProf (-gInv x) x := by
  have h := (hasDerivAt_gDens (gInv x)).comp x (hasDerivAt_gInv hx)
  refine (h.congr_of_eventuallyEq (gProf_eventuallyEq hx)).congr_deriv ?_
  have := (gDens_pos (gInv x)).ne'
  field_simp

/-- $I'=-\Phi^{-1}$ on $(0,1)$. -/
theorem deriv_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : deriv gProf x = -gInv x :=
  (hasDerivAt_gProf hx).deriv

/-- $I'=-\Phi^{-1}$ near each point of $(0,1)$. -/
theorem deriv_gProf_eventuallyEq {x : ℝ} (hx : x ∈ Ioo 0 1) :
    deriv gProf =ᶠ[𝓝 x] fun y ↦ -gInv y := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv_gProf hy

/-- $I''(x)=-1/I(x)$ for $x\in(0,1)$. -/
theorem hasDerivAt_deriv_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) :
    HasDerivAt (deriv gProf) (-(gProf x)⁻¹) x := by
  rw [gProf_of_mem hx]
  exact (hasDerivAt_gInv hx).neg.congr_of_eventuallyEq (deriv_gProf_eventuallyEq hx)

/-- $I''=-1/I$ on $(0,1)$. -/
theorem deriv2_gProf {x : ℝ} (hx : x ∈ Ioo 0 1) : deriv (deriv gProf) x = -(gProf x)⁻¹ :=
  (hasDerivAt_deriv_gProf hx).deriv

/-- $I\cdot I''=-1$ on $(0,1)$. -/
theorem gProf_mul_deriv2 {x : ℝ} (hx : x ∈ Ioo 0 1) : gProf x * deriv (deriv gProf) x = -1 := by
  rw [deriv2_gProf hx]; have := (gProf_pos hx).ne'; field_simp

/-- $I$ is smooth on $(0,1)$. -/
theorem contDiffOn_gProf : ContDiffOn ℝ ∞ gProf (Ioo 0 1) := by
  refine ContDiffOn.congr ?_ fun x hx ↦ gProf_of_mem hx
  exact contDiff_gDens.comp_contDiffOn contDiffOn_gInv

/-- $\Phi^{-1}(x)\to\infty$ as $x\to1^-$. -/
theorem tendsto_gInv_left_one : Tendsto gInv (𝓝[<] 1) atTop := by
  rw [tendsto_atTop]
  intro M
  have hM := (gCDF_mem_Ioo M).2
  filter_upwards [Ioo_mem_nhdsLT hM] with y hy
  have hy' : y ∈ Ioo 0 1 := ⟨(gCDF_mem_Ioo M).1.trans hy.1, hy.2⟩
  exact (le_gInv_iff hy').2 hy.1.le

/-- $\varphi(t)\to0$ as $t\to\infty$. -/
theorem tendsto_gDens_atTop : Tendsto gDens atTop (𝓝 0) := by
  have h : Tendsto (fun t : ℝ ↦ -t ^ 2 / 2) atTop atBot := by
    have h2 := (tendsto_pow_atTop (α := ℝ) two_ne_zero).atTop_div_const (r := 2) (by norm_num)
    refine (tendsto_neg_atTop_atBot.comp h2).congr fun t ↦ ?_
    simp [neg_div]
  have := (tendsto_exp_atBot.comp h).const_mul ((2 * π) ^ (-(2⁻¹ : ℝ)))
  rw [mul_zero] at this
  exact this

/-- $I$ is continuous on $[0,1]$. -/
theorem continuousOn_gProf : ContinuousOn gProf (Icc 0 1) := by
  have h1 : ContinuousWithinAt gProf (Icc 0 1) 1 := by
    have hI : Icc (0 : ℝ) 1 = insert 1 (Ico 0 1) := (Ico_insert_right zero_le_one).symm
    rw [hI, continuousWithinAt_insert_self, ContinuousWithinAt, gProf_one]
    refine Tendsto.mono_left ?_ (nhdsWithin_mono _ Ico_subset_Iio_self)
    refine (tendsto_gDens_atTop.comp tendsto_gInv_left_one).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT (zero_lt_one' ℝ)] with y hy using (gProf_of_mem hy).symm
  have h0 : ContinuousWithinAt gProf (Icc 0 1) 0 := by
    have he : gProf = fun x ↦ gProf (1 - x) := funext fun x ↦ (gProf_one_sub x).symm
    rw [he]
    have hc : ContinuousWithinAt (fun x : ℝ ↦ 1 - x) (Icc 0 1) 0 := by fun_prop
    have hm : MapsTo (fun x : ℝ ↦ 1 - x) (Icc 0 1) (Icc 0 1) :=
      fun x hx ↦ ⟨by linarith [hx.2], by linarith [hx.1]⟩
    have h1' : ContinuousWithinAt gProf (Icc 0 1) ((fun x : ℝ ↦ 1 - x) 0) := by simpa using h1
    exact h1'.comp hc hm
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h | h
  · rw [← h]; exact h0
  rcases eq_or_lt_of_le hx.2 with h' | h'
  · rw [h']; exact h1
  exact (contDiffOn_gProf.continuousOn x ⟨h, h'⟩).mono_of_mem_nhdsWithin
    (mem_nhdsWithin_of_mem_nhds (Ioo_mem_nhds h h')) |>.mono subset_rfl

/-- $I$ is strictly concave on $[0,1]$. -/
theorem strictConcaveOn_gProf : StrictConcaveOn ℝ (Icc 0 1) gProf := by
  refine strictConcaveOn_of_deriv2_neg (convex_Icc 0 1) continuousOn_gProf fun x hx ↦ ?_
  rw [interior_Icc] at hx
  simp only [Function.iterate_succ, Function.iterate_zero, Function.comp_apply, id]
  rw [deriv2_gProf hx, neg_lt_zero]
  exact inv_pos.2 (gProf_pos hx)

/-- $I(u)/u$ is strictly decreasing: $I(u)/u<I(v)/v$ for $0<v<u\le1$. -/
theorem gProf_div_lt {u v : ℝ} (hv : 0 < v) (hvu : v < u) (hu : u ≤ 1) :
    gProf u / u < gProf v / v := by
  have hu0 : 0 < u := hv.trans hvu
  have hθ : 0 < v / u := div_pos hv hu0
  have hθ1 : 0 < 1 - v / u := by rw [sub_pos, div_lt_one hu0]; exact hvu
  have h := strictConcaveOn_gProf.2 (show u ∈ Icc (0 : ℝ) 1 from ⟨hu0.le, hu⟩)
    (show (0 : ℝ) ∈ Icc (0 : ℝ) 1 from ⟨le_rfl, zero_le_one⟩) hu0.ne' hθ hθ1 (by ring)
  simp only [smul_eq_mul, mul_zero, add_zero, gProf_zero] at h
  rw [div_mul_cancel₀ v hu0.ne'] at h
  rw [div_lt_div_iff₀ hu0 hv]
  have : v / u * gProf u * u = v * gProf u := by field_simp
  nlinarith

/-- $\Phi^{-1}>0$ on $(\frac12,1)$. -/
theorem gInv_pos {x : ℝ} (hx : x ∈ Ioo 2⁻¹ 1) : 0 < gInv x := by
  rw [← gInv_half]
  exact gInv_strictMonoOn ⟨by norm_num, by norm_num⟩ ⟨by linarith [hx.1], hx.2⟩ hx.1

/-- $\Phi^{-1}<0$ on $(0,\frac12)$. -/
theorem gInv_neg {x : ℝ} (hx : x ∈ Ioo 0 2⁻¹) : gInv x < 0 := by
  rw [← gInv_half]
  exact gInv_strictMonoOn ⟨hx.1, by linarith [hx.2]⟩ ⟨by norm_num, by norm_num⟩ hx.2

/-- $I$ is strictly decreasing on $[\frac12,1]$. -/
theorem gProf_strictAntiOn : StrictAntiOn gProf (Icc 2⁻¹ 1) := by
  refine strictAntiOn_of_deriv_neg (convex_Icc _ _)
    (continuousOn_gProf.mono (Icc_subset_Icc (by norm_num) le_rfl)) fun x hx ↦ ?_
  rw [interior_Icc] at hx
  rw [deriv_gProf ⟨by linarith [hx.1], hx.2⟩, neg_lt_zero]
  exact gInv_pos hx

/-- $I$ is strictly increasing on $[0,\frac12]$. -/
theorem gProf_strictMonoOn : StrictMonoOn gProf (Icc 0 2⁻¹) := by
  refine strictMonoOn_of_deriv_pos (convex_Icc _ _)
    (continuousOn_gProf.mono (Icc_subset_Icc le_rfl (by norm_num))) fun x hx ↦ ?_
  rw [interior_Icc] at hx
  rw [deriv_gProf ⟨hx.1, by linarith [hx.2]⟩, neg_pos]
  exact gInv_neg hx

/-- $I\le I(\frac12)$. -/
theorem gProf_le_half (x : ℝ) : gProf x ≤ gProf 2⁻¹ := by
  by_cases hx : x ∈ Ioo 0 1
  · rcases le_total x 2⁻¹ with h | h
    · exact gProf_strictMonoOn.monotoneOn ⟨hx.1.le, h⟩ ⟨by norm_num, le_rfl⟩ h
    · exact gProf_strictAntiOn.antitoneOn ⟨le_rfl, by norm_num⟩ ⟨h, hx.2.le⟩ h
  · rw [gProf_of_not_mem hx]; exact gProf_nonneg _

/-- $I(x)<I(\frac12)$ for $x\ne\frac12$. -/
theorem gProf_lt_half {x : ℝ} (hx : x ≠ 2⁻¹) : gProf x < gProf 2⁻¹ := by
  have hpos : 0 < gProf 2⁻¹ := gProf_pos ⟨by norm_num, by norm_num⟩
  by_cases hx' : x ∈ Ioo 0 1
  · rcases lt_or_gt_of_ne hx with h | h
    · exact gProf_strictMonoOn ⟨hx'.1.le, h.le⟩ ⟨by norm_num, le_rfl⟩ h
    · exact gProf_strictAntiOn ⟨le_rfl, by norm_num⟩ ⟨h.le, hx'.2.le⟩ h
  · rw [gProf_of_not_mem hx']; exact hpos

/-! ### Uniqueness for $f\cdot f''=-k$ -/

/-- For $f,g$ $C^2$ on an open set $s$, $(f-g)''=f''-g''$ on $s$. -/
theorem deriv2_sub_of_contDiffOn {f g : ℝ → ℝ} {s : Set ℝ} (hs : IsOpen s)
    (hf : ContDiffOn ℝ 2 f s) (hg : ContDiffOn ℝ 2 g s) {x : ℝ} (hx : x ∈ s) :
    deriv (deriv (fun y ↦ f y - g y)) x = deriv (deriv f) x - deriv (deriv g) x := by
  have he : deriv (fun y ↦ f y - g y) =ᶠ[𝓝 x] fun y ↦ deriv f y - deriv g y := by
    filter_upwards [hs.mem_nhds hx] with y hy
    exact deriv_sub (contDiffOn_two_differentiableAt hs hf hy).1
      (contDiffOn_two_differentiableAt hs hg hy).1
  rw [he.deriv_eq]
  exact deriv_sub (contDiffOn_two_differentiableAt hs hf hx).2
    (contDiffOn_two_differentiableAt hs hg hx).2

/-- One half of the uniqueness for $f\cdot f''=-k$: if $f,g>0$ on $(a,b)$ solve
$ff''=gg''=-k$ ($k>0$) and $f\le g$ at the endpoints, then $f\le g$ on $[a,b]$. -/
theorem le_of_mul_deriv2_eq {f g : ℝ → ℝ} {a b k : ℝ} (hk : 0 < k)
    (hfc : ContinuousOn f (Icc a b)) (hgc : ContinuousOn g (Icc a b))
    (hf : ContDiffOn ℝ 2 f (Ioo a b)) (hg : ContDiffOn ℝ 2 g (Ioo a b))
    (hfp : ∀ x ∈ Ioo a b, 0 < f x) (hgp : ∀ x ∈ Ioo a b, 0 < g x)
    (hff : ∀ x ∈ Ioo a b, f x * deriv (deriv f) x = -k)
    (hgg : ∀ x ∈ Ioo a b, g x * deriv (deriv g) x = -k)
    (ha : f a ≤ g a) (hb : f b ≤ g b) : ∀ x ∈ Icc a b, f x ≤ g x := by
  have key := max_principle_aux (h := fun y ↦ f y - g y) (a := a) (b := b) (hfc.sub hgc)
    (fun x hx hpos ↦ ?_) (by simpa using ha) (by simpa using hb)
  · intro x hx; have := key x hx; linarith
  · rw [deriv2_sub_of_contDiffOn isOpen_Ioo hf hg hx]
    have h1 := hff x hx; have h2 := hgg x hx
    have hf0 := hfp x hx; have hg0 := hgp x hx
    have e1 : deriv (deriv f) x = -k / f x := by field_simp; linarith
    have e2 : deriv (deriv g) x = -k / g x := by field_simp; linarith
    rw [e1, e2]
    have : -k / f x - -k / g x = k * (f x - g x) / (f x * g x) := by field_simp; ring
    rw [this]; positivity

/-- Uniqueness for $f\cdot f''=-k$ ($k>0$) with positive solutions and equal boundary values. -/
theorem eqOn_of_mul_deriv2_eq {f g : ℝ → ℝ} {a b k : ℝ} (hk : 0 < k)
    (hfc : ContinuousOn f (Icc a b)) (hgc : ContinuousOn g (Icc a b))
    (hf : ContDiffOn ℝ 2 f (Ioo a b)) (hg : ContDiffOn ℝ 2 g (Ioo a b))
    (hfp : ∀ x ∈ Ioo a b, 0 < f x) (hgp : ∀ x ∈ Ioo a b, 0 < g x)
    (hff : ∀ x ∈ Ioo a b, f x * deriv (deriv f) x = -k)
    (hgg : ∀ x ∈ Ioo a b, g x * deriv (deriv g) x = -k)
    (ha : f a = g a) (hb : f b = g b) : EqOn f g (Icc a b) := fun x hx ↦
  le_antisymm (le_of_mul_deriv2_eq hk hfc hgc hf hg hfp hgp hff hgg ha.le hb.le x hx)
    (le_of_mul_deriv2_eq hk hgc hfc hg hf hgp hfp hgg hff ha.ge hb.ge x hx)

/-- A function continuous on $[a,b]$, positive at $a$ and without zeros in $(a,b)$ is positive on
$[a,b)$. -/
theorem pos_of_ne_zero_of_continuousOn {f : ℝ → ℝ} {a b : ℝ} (hfc : ContinuousOn f (Icc a b))
    (ha : 0 < f a) (hne : ∀ x ∈ Ioo a b, f x ≠ 0) : ∀ x ∈ Ico a b, 0 < f x := by
  intro x hx
  by_contra hneg
  rw [not_lt] at hneg
  obtain ⟨c, hc, hfc0⟩ := intermediate_value_Icc' hx.1 (hfc.mono (Icc_subset_Icc le_rfl hx.2.le))
    ⟨hneg, ha.le⟩
  have hca : c ≠ a := fun e ↦ by rw [e] at hfc0; linarith
  exact hne c ⟨lt_of_le_of_ne hc.1 (Ne.symm hca), hc.2.trans_lt hx.2⟩ hfc0

/-! ### The functions $J_w$ -/

/-- $J_w(x)=\sqrt2\,w\,I(w^{-1}(1-x))$ (definitionally equal to `Auto.DIR.Jw`). -/
noncomputable def gJw (w x : ℝ) : ℝ := √2 * w * gProf (w⁻¹ * (1 - x))

/-- $w^{-1}(1-x)\in(0,1)$ for $x\in(1-w,1)$. -/
theorem affine_mem_Ioo {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    w⁻¹ * (1 - x) ∈ Ioo 0 1 := by
  rw [← div_eq_inv_mul]
  exact ⟨div_pos (by linarith [hx.2]) hw, (div_lt_one hw).2 (by linarith [hx.1])⟩

/-- $w^{-1}(1-x)\in[0,1]$ for $x\in[1-w,1]$. -/
theorem affine_mem_Icc {w x : ℝ} (hw : 0 < w) (hx : x ∈ Icc (1 - w) 1) :
    w⁻¹ * (1 - x) ∈ Icc 0 1 := by
  rw [← div_eq_inv_mul]
  exact ⟨div_nonneg (by linarith [hx.2]) hw.le, (div_le_one hw).2 (by linarith [hx.1])⟩

/-- $x\mapsto I(w^{-1}(1-x))$ is smooth on $(1-w,1)$. -/
theorem contDiffOn_gProf_affine {w : ℝ} (hw : 0 < w) :
    ContDiffOn ℝ ∞ (fun x ↦ gProf (w⁻¹ * (1 - x))) (Ioo (1 - w) 1) :=
  contDiffOn_gProf.comp (by fun_prop) fun _ hx ↦ affine_mem_Ioo hw hx

/-- $x\mapsto I(w^{-1}(1-x))$ is continuous on $[1-w,1]$. -/
theorem continuousOn_gProf_affine {w : ℝ} (hw : 0 < w) :
    ContinuousOn (fun x ↦ gProf (w⁻¹ * (1 - x))) (Icc (1 - w) 1) :=
  continuousOn_gProf.comp (by fun_prop) fun _ hx ↦ affine_mem_Icc hw hx

/-- $J_w$ is smooth on $(1-w,1)$. -/
theorem contDiffOn_gJw {w : ℝ} (hw : 0 < w) : ContDiffOn ℝ ∞ (gJw w) (Ioo (1 - w) 1) :=
  (contDiffOn_gProf_affine hw).const_smul (√2 * w) |>.congr fun _ _ ↦ rfl

/-- $J_w$ is continuous on $[1-w,1]$. -/
theorem continuousOn_gJw {w : ℝ} (hw : 0 < w) : ContinuousOn (gJw w) (Icc (1 - w) 1) :=
  (continuousOn_gProf_affine hw).const_smul (√2 * w) |>.congr fun _ _ ↦ rfl

/-- $J_w(1)=0$. -/
theorem gJw_one (w : ℝ) : gJw w 1 = 0 := by simp [gJw, gProf_zero]

/-- $J_w>0$ on $(1-w,1)$. -/
theorem gJw_pos {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) : 0 < gJw w x := by
  unfold gJw
  have := gProf_pos (affine_mem_Ioo hw hx)
  positivity

/-- $J_w$ is symmetric about $1-\frac w2$: $J_w(2-w-x)=J_w(x)$. -/
theorem gJw_reflect {w : ℝ} (hw : 0 < w) (x : ℝ) : gJw w (2 - w - x) = gJw w x := by
  unfold gJw
  rw [← gProf_one_sub (w⁻¹ * (1 - x))]
  congr 2
  field_simp
  ring

/-- $J_w'(x)=\sqrt2\,\Phi^{-1}(w^{-1}(1-x))$ on $(1-w,1)$. -/
theorem hasDerivAt_gJw {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    HasDerivAt (gJw w) (√2 * gInv (w⁻¹ * (1 - x))) x := by
  have ha : HasDerivAt (fun x : ℝ ↦ w⁻¹ * (1 - x)) (-w⁻¹) x := by
    simpa using ((hasDerivAt_id x).const_sub 1).const_mul w⁻¹
  have h := ((hasDerivAt_gProf (affine_mem_Ioo hw hx)).comp x ha).const_mul (√2 * w)
  refine HasDerivAt.congr_deriv (f := gJw w) h ?_
  field_simp

/-- $J_w'(x)=\sqrt2\,\Phi^{-1}(w^{-1}(1-x))$ near each point of $(1-w,1)$. -/
theorem deriv_gJw_eventuallyEq {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    deriv (gJw w) =ᶠ[𝓝 x] fun y ↦ √2 * gInv (w⁻¹ * (1 - y)) := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using (hasDerivAt_gJw hw hy).deriv

/-- $J_w''(x)=-\sqrt2/(w\,I(w^{-1}(1-x)))$ on $(1-w,1)$. -/
theorem hasDerivAt_deriv_gJw {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    HasDerivAt (deriv (gJw w)) (-(√2 * w⁻¹ * (gProf (w⁻¹ * (1 - x)))⁻¹)) x := by
  have hu := affine_mem_Ioo hw hx
  have ha : HasDerivAt (fun x : ℝ ↦ w⁻¹ * (1 - x)) (-w⁻¹) x := by
    simpa using ((hasDerivAt_id x).const_sub 1).const_mul w⁻¹
  have h := ((hasDerivAt_gInv hu).comp x ha).const_mul √2
  refine (h.congr_of_eventuallyEq (deriv_gJw_eventuallyEq hw hx)).congr_deriv ?_
  rw [gProf_of_mem hu]
  ring

/-- $J_w''\cdot J_w=-2$ on $(1-w,1)$. -/
theorem gJw_deriv2_mul {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ioo (1 - w) 1) :
    deriv (deriv (gJw w)) x * gJw w x = -2 := by
  rw [(hasDerivAt_deriv_gJw hw hx).deriv]
  have hp := (gProf_pos (affine_mem_Ioo hw hx)).ne'
  unfold gJw
  have h2 : √2 * √2 = 2 := Real.mul_self_sqrt (by norm_num)
  set p := gProf (w⁻¹ * (1 - x))
  calc -(√2 * w⁻¹ * p⁻¹) * (√2 * w * p) = -((√2 * √2) * (w⁻¹ * w) * (p⁻¹ * p)) := by ring
    _ = -2 := by rw [h2, inv_mul_cancel₀ hw.ne', inv_mul_cancel₀ hp]; ring

/-- $J_w'(1-\frac w2)=0$, $J_w'>0$ on $(1-w,1-\frac w2)$ and $J_w'<0$ on $(1-\frac w2,1)$. -/
theorem deriv_gJw_sign {w : ℝ} (hw : 0 < w) :
    deriv (gJw w) (1 - w / 2) = 0 ∧ (∀ x ∈ Ioo (1 - w) (1 - w / 2), deriv (gJw w) x > 0) ∧
    (∀ x ∈ Ioo (1 - w / 2) 1, deriv (gJw w) x < 0) := by
  refine ⟨?_, fun x hx ↦ ?_, fun x hx ↦ ?_⟩
  · rw [(hasDerivAt_gJw hw ⟨by linarith, by linarith⟩).deriv]
    have : w⁻¹ * (1 - (1 - w / 2)) = 2⁻¹ := by field_simp; ring
    rw [this, gInv_half, mul_zero]
  · have hx' : x ∈ Ioo (1 - w) 1 := ⟨hx.1, by linarith [hx.2]⟩
    rw [(hasDerivAt_gJw hw hx').deriv]
    have hu := affine_mem_Ioo hw hx'
    have : 2⁻¹ < w⁻¹ * (1 - x) := by
      rw [← div_eq_inv_mul, lt_div_iff₀ hw]; linarith [hx.2]
    have := gInv_pos ⟨this, hu.2⟩
    positivity
  · have hx' : x ∈ Ioo (1 - w) 1 := ⟨by linarith [hx.1], hx.2⟩
    rw [(hasDerivAt_gJw hw hx').deriv]
    have hu := affine_mem_Ioo hw hx'
    have : w⁻¹ * (1 - x) < 2⁻¹ := by
      rw [← div_eq_inv_mul, div_lt_iff₀ hw]; linarith [hx.1]
    have := gInv_neg ⟨hu.1, this⟩
    have h2 : (0 : ℝ) < √2 := by positivity
    nlinarith

/-- Auxiliary for Remark 3.6: $I(\frac12)\,\Phi^{-1}(\frac12+v)>v$ for $v\in(0,\frac12)$. -/
theorem gProf_half_mul_gInv_gt {v : ℝ} (hv : v ∈ Ioo 0 2⁻¹) :
    v < gProf 2⁻¹ * gInv (2⁻¹ + v) := by
  set b := gProf 2⁻¹
  have hmem : ∀ v ∈ Ico (0 : ℝ) 2⁻¹, 2⁻¹ + v ∈ Ioo (0 : ℝ) 1 :=
    fun v hv ↦ ⟨by linarith [hv.1], by linarith [hv.2]⟩
  have hd : ∀ v ∈ Ico (0 : ℝ) 2⁻¹,
      HasDerivAt (fun v ↦ b * gInv (2⁻¹ + v) - v) (b * (gDens (gInv (2⁻¹ + v)))⁻¹ - 1) v := by
    intro v hv
    have h := (hasDerivAt_gInv (hmem v hv)).comp_const_add 2⁻¹ v
    exact ((h.const_mul b).sub (hasDerivAt_id' v)).congr_deriv (by ring)
  have hmono : StrictMonoOn (fun v ↦ b * gInv (2⁻¹ + v) - v) (Ico 0 2⁻¹) := by
    refine strictMonoOn_of_deriv_pos (convex_Ico 0 2⁻¹)
      (fun v hv ↦ (hd v hv).continuousAt.continuousWithinAt) fun v hv ↦ ?_
    rw [interior_Ico] at hv
    rw [(hd v (Ioo_subset_Ico_self hv)).deriv, sub_pos, ← gProf_of_mem (hmem v
      (Ioo_subset_Ico_self hv))]
    have hp := gProf_pos (hmem v (Ioo_subset_Ico_self hv))
    have hlt := gProf_lt_half (x := 2⁻¹ + v) (by linarith [hv.1])
    rw [← div_eq_mul_inv, one_lt_div hp]
    exact hlt
  have := hmono ⟨le_rfl, by norm_num⟩ (Ioo_subset_Ico_self hv) hv.1
  simp only [add_zero, gInv_half, mul_zero, sub_zero] at this
  linarith

/-- Auxiliary for Remark 3.6: $v^2<2I(\frac12)\,(I(\frac12)-I(\frac12+v))$ for
$v\in(0,\frac12]$. -/
theorem sq_lt_gProf_half {v : ℝ} (hv : v ∈ Ioc 0 2⁻¹) :
    v ^ 2 < 2 * gProf 2⁻¹ * (gProf 2⁻¹ - gProf (2⁻¹ + v)) := by
  set b := gProf 2⁻¹
  have hc : ContinuousOn (fun v ↦ 2 * b * (b - gProf (2⁻¹ + v)) - v ^ 2) (Icc 0 2⁻¹) := by
    have : ContinuousOn (fun v ↦ gProf (2⁻¹ + v)) (Icc 0 2⁻¹) :=
      continuousOn_gProf.comp (by fun_prop) fun v hv ↦ ⟨by linarith [hv.1], by linarith [hv.2]⟩
    fun_prop
  have hmono : StrictMonoOn (fun v ↦ 2 * b * (b - gProf (2⁻¹ + v)) - v ^ 2) (Icc 0 2⁻¹) := by
    refine strictMonoOn_of_deriv_pos (convex_Icc 0 2⁻¹) hc fun v hv ↦ ?_
    rw [interior_Icc] at hv
    have hm : 2⁻¹ + v ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hv.1], by linarith [hv.2]⟩
    have h := (hasDerivAt_gProf hm).comp_const_add 2⁻¹ v
    have h2 := ((h.const_sub b).const_mul (2 * b)).fun_sub (hasDerivAt_pow 2 v)
    rw [h2.deriv]
    have : v < b * gInv (2⁻¹ + v) := gProf_half_mul_gInv_gt hv
    norm_num
    linarith
  have := hmono ⟨le_rfl, by norm_num⟩ ⟨hv.1.le, hv.2⟩ hv.1
  simp only [add_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow,
    sub_zero] at this
  rw [show b - gProf 2⁻¹ = 0 from sub_self _, mul_zero] at this
  linarith

/-- Remark 3.6, failure of Corollary 3.5 for $x<1-\frac w2$: with $y=2-w-x$ (the reflection of
$x$ in $1-\frac w2$),
$\sqrt{(y-x)^2+J_w(y)^2}+J_w(x)<2J_w(\frac{x+y}2)$ for $x\in[1-w,1-\frac w2)$. -/
theorem gJw_reflect_fail {w x : ℝ} (hw : 0 < w) (hx : x ∈ Ico (1 - w) (1 - w / 2)) :
    √((2 - w - x - x) ^ 2 + gJw w (2 - w - x) ^ 2) + gJw w x <
      2 * gJw w ((x + (2 - w - x)) / 2) := by
  rw [gJw_reflect hw]
  set v := w⁻¹ * (1 - x) - 2⁻¹ with hvdef
  have hv : v ∈ Ioc 0 2⁻¹ := by
    constructor
    · rw [hvdef, sub_pos, ← div_eq_inv_mul, lt_div_iff₀ hw]; linarith [hx.2]
    · rw [hvdef, sub_le_iff_le_add, ← div_eq_inv_mul, div_le_iff₀ hw]; linarith [hx.1]
  have key := sq_lt_gProf_half hv
  have hxv : gJw w x = √2 * w * gProf (2⁻¹ + v) := by
    rw [hvdef]; unfold gJw; congr 2; ring
  have hmid : gJw w ((x + (2 - w - x)) / 2) = √2 * w * gProf 2⁻¹ := by
    unfold gJw; congr 2; field_simp; ring
  have hyx : 2 - w - x - x = 2 * w * v := by
    rw [hvdef]; field_simp; ring
  rw [hxv, hmid, hyx]
  set a := gProf (2⁻¹ + v)
  set b := gProf 2⁻¹
  have ha : 0 ≤ a := gProf_nonneg _
  have hab : a ≤ b := gProf_le_half _
  have hb : 0 < b := gProf_pos ⟨by norm_num, by norm_num⟩
  have h2 : √2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have hs : 0 < √2 := by positivity
  have hpos : 0 < √2 * w * (2 * b - a) := by
    have : 0 < 2 * b - a := by linarith
    positivity
  have hlt : √((2 * w * v) ^ 2 + (√2 * w * a) ^ 2) < √2 * w * (2 * b - a) := by
    rw [Real.sqrt_lt' hpos]
    have e : (√2 * w * (2 * b - a)) ^ 2 - ((2 * w * v) ^ 2 + (√2 * w * a) ^ 2) =
        4 * w ^ 2 * (2 * b * (b - a) - v ^ 2) := by
      ring_nf; rw [h2]; ring
    have : 0 < 4 * w ^ 2 * (2 * b * (b - a) - v ^ 2) := by
      have : 0 < 2 * b * (b - a) - v ^ 2 := by linarith
      positivity
    linarith
  linarith

/-! ### The constant $w_0$: $J_w(\frac12)=\frac12$ -/

/-- $J_w(\frac12)=0$ for $w\le\frac12$ (the argument of $I$ lies outside $(0,1)$). -/
theorem gJw_half_of_le {w : ℝ} (hw : w ≤ 2⁻¹) : gJw w 2⁻¹ = 0 := by
  unfold gJw
  rw [gProf_of_not_mem, mul_zero]
  rintro ⟨h1, h2⟩
  rcases le_or_gt w 0 with h | h
  · have : w⁻¹ ≤ 0 := inv_nonpos.2 h
    nlinarith
  · rw [← div_eq_inv_mul, div_lt_one h] at h2
    linarith

/-- $J_w(\frac12)=\frac{\sqrt2}2\cdot I(u)/u$ with $u=w^{-1}/2$. -/
theorem gJw_half_eq {w : ℝ} (hw : w ≠ 0) :
    gJw w 2⁻¹ = √2 / 2 * (gProf (w⁻¹ * (1 - 2⁻¹)) / (w⁻¹ * (1 - 2⁻¹))) := by
  unfold gJw; field_simp; ring

/-- $w\mapsto J_w(\frac12)$ is strictly increasing on $(\frac12,1]$. -/
theorem gJw_half_strictMonoOn : StrictMonoOn (fun w ↦ gJw w 2⁻¹) (Ioc 2⁻¹ 1) := by
  intro w hw w' hw' hww'
  have hw0 : 0 < w := by linarith [hw.1]
  have hw0' : 0 < w' := by linarith [hw'.1]
  simp only
  rw [gJw_half_eq hw0.ne', gJw_half_eq hw0'.ne']
  refine mul_lt_mul_of_pos_left (gProf_div_lt ?_ ?_ ?_) (by positivity)
  · positivity
  · exact mul_lt_mul_of_pos_right ((inv_lt_inv₀ hw0' hw0).2 hww') (by norm_num)
  · rw [← div_eq_inv_mul, div_le_one hw0]; linarith [hw.1]

/-- $w\mapsto J_w(\frac12)$ is continuous on $[\frac12,1]$. -/
theorem gJw_half_continuousOn : ContinuousOn (fun w ↦ gJw w 2⁻¹) (Icc 2⁻¹ 1) := by
  have hinv : ContinuousOn (fun w : ℝ ↦ w⁻¹ * (1 - 2⁻¹)) (Icc 2⁻¹ 1) :=
    (continuousOn_inv₀.mono fun w hw ↦ ne_of_gt (by linarith [hw.1] : (0 : ℝ) < w)).mul
      continuousOn_const
  have hm : MapsTo (fun w : ℝ ↦ w⁻¹ * (1 - 2⁻¹)) (Icc 2⁻¹ 1) (Icc 0 1) := by
    intro w hw
    have hw0 : 0 < w := by linarith [hw.1]
    simp only [mem_Icc]
    rw [← div_eq_inv_mul]
    exact ⟨by positivity, (div_le_one hw0).2 (by linarith [hw.1])⟩
  have := continuousOn_gProf.comp hinv hm
  unfold gJw
  exact (continuousOn_const.mul continuousOn_id).mul this

/-- $J_1(\frac12)=\sqrt2\,I(\frac12)=\pi^{-1/2}>\frac12$. -/
theorem gJw_one_half_gt : 2⁻¹ < gJw 1 2⁻¹ := by
  unfold gJw
  rw [inv_one, one_mul, mul_one, show (1 : ℝ) - 2⁻¹ = 2⁻¹ by norm_num, gProf_half, gConst_eq,
    Real.sqrt_mul (by norm_num),
    mul_inv, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
  have : √π < 2 := by rw [Real.sqrt_lt' (by norm_num)]; linarith [pi_lt_d2]
  rw [inv_lt_inv₀ (by norm_num) (by positivity)]
  linarith

/-- [DIR], §3: there is a unique $w\in(0,1)$ with $J_w(\frac12)=\frac12$. -/
theorem existsUnique_gJw_half : ∃! w : ℝ, w ∈ Ioo 0 1 ∧ gJw w 2⁻¹ = 2⁻¹ := by
  obtain ⟨w, hw, hval⟩ := intermediate_value_Icc (by norm_num : (2⁻¹ : ℝ) ≤ 1)
    gJw_half_continuousOn ⟨by rw [gJw_half_of_le le_rfl]; norm_num, gJw_one_half_gt.le⟩
  simp only at hval
  have hw1 : w ≠ 2⁻¹ := fun e ↦ by rw [e, gJw_half_of_le le_rfl] at hval; norm_num at hval
  have hw2 : w ≠ 1 := fun e ↦ by rw [e] at hval; linarith [gJw_one_half_gt]
  have hwI : w ∈ Ioo 0 1 :=
    ⟨by linarith [hw.1], lt_of_le_of_ne hw.2 hw2⟩
  refine ⟨w, ⟨hwI, hval⟩, fun w' ⟨hw', hval'⟩ ↦ ?_⟩
  have hgt : ∀ w'' ∈ Ioo (0 : ℝ) 1, gJw w'' 2⁻¹ = 2⁻¹ → w'' ∈ Ioc 2⁻¹ 1 := by
    intro w'' hw'' h''
    refine ⟨lt_of_not_ge fun hle ↦ ?_, hw''.2.le⟩
    rw [gJw_half_of_le hle] at h''; norm_num at h''
  exact gJw_half_strictMonoOn.injOn (hgt w' hw' hval') (hgt w hwI hval) (hval'.trans hval.symm)

/-- $\varphi(t)=e^{-t^2/2}/\sqrt{2\pi}$. -/
theorem gDens_eq (t : ℝ) : gDens t = exp (-t ^ 2 / 2) / √(2 * π) := by
  simp only [gDens, gConst_eq]; ring

/-- Numerical bounds $2.50658<\sqrt{2\pi}<2.50664$. -/
theorem sqrt_two_pi_bounds : 2.50658 < √(2 * π) ∧ √(2 * π) < 2.50664 := by
  constructor
  · rw [Real.lt_sqrt (by norm_num)]; nlinarith [pi_gt_d4]
  · rw [Real.sqrt_lt' (by norm_num)]; nlinarith [pi_lt_d4]

/-- $\Phi(t)=\frac12+\int_0^t\varphi$. -/
theorem gCDF_eq_half_add (t : ℝ) : gCDF t = 2⁻¹ + ∫ s in (0 : ℝ)..t, gDens s := by
  rw [gCDF_eq, gCDF_zero]

/-- $\Phi(t)\le\frac12+t/\sqrt{2\pi}$ for $t\ge0$. -/
theorem gCDF_le (t : ℝ) (ht : 0 ≤ t) : gCDF t ≤ 2⁻¹ + t / √(2 * π) := by
  rw [gCDF_eq_half_add]
  have h : ∫ s in (0 : ℝ)..t, gDens s ≤ ∫ s in (0 : ℝ)..t, (1 / √(2 * π)) := by
    refine intervalIntegral.integral_mono_on ht (continuous_gDens.intervalIntegrable _ _)
      intervalIntegrable_const fun s _ ↦ ?_
    rw [gDens_eq]
    gcongr
    rw [exp_le_one_iff]; nlinarith
  simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h
  rw [mul_one_div] at h
  linarith

/-- $\Phi(t)\ge\frac12+(t-t^3/6)/\sqrt{2\pi}$ for $t\ge0$. -/
theorem le_gCDF (t : ℝ) (ht : 0 ≤ t) : 2⁻¹ + (t - t ^ 3 / 6) / √(2 * π) ≤ gCDF t := by
  rw [gCDF_eq_half_add]
  have h : ∫ s in (0 : ℝ)..t, ((1 - s ^ 2 / 2) / √(2 * π)) ≤ ∫ s in (0 : ℝ)..t, gDens s := by
    refine intervalIntegral.integral_mono_on ht
      ((by fun_prop : Continuous fun s : ℝ ↦ (1 - s ^ 2 / 2) / √(2 * π)).intervalIntegrable _ _)
      (continuous_gDens.intervalIntegrable _ _) fun s _ ↦ ?_
    rw [gDens_eq]
    gcongr
    linarith [add_one_le_exp (-s ^ 2 / 2)]
  have e : ∫ s in (0 : ℝ)..t, ((1 - s ^ 2 / 2) / √(2 * π)) = (t - t ^ 3 / 6) / √(2 * π) := by
    rw [intervalIntegral.integral_div, intervalIntegral.integral_sub
      (continuous_const.intervalIntegrable _ _)
      ((by fun_prop : Continuous fun s : ℝ ↦ s ^ 2 / 2).intervalIntegrable _ _),
      intervalIntegral.integral_div]
    simp
    ring
  linarith

/-- Numerical bound: $J_{0.895}(\frac12)<\frac12$. -/
theorem gJw_895_lt : gJw 0.895 2⁻¹ < 2⁻¹ := by
  obtain ⟨hs1, hs2⟩ := sqrt_two_pi_bounds
  have hs0 : 0 < √(2 * π) := by linarith
  set u : ℝ := (0.895 : ℝ)⁻¹ * (1 - 2⁻¹) with hu
  have huI : u ∈ Ioo 0 1 := by rw [hu]; constructor <;> norm_num
  have hcdf : gCDF 0.144 < u := by
    have := gCDF_le 0.144 (by norm_num)
    have h2 : (0.144 : ℝ) / √(2 * π) < 0.0586 := by
      rw [div_lt_iff₀ hs0]; nlinarith
    have h3 : (2⁻¹ : ℝ) + 0.0586 < u := by rw [hu]; norm_num
    linarith
  have hinv : 0.144 < gInv u := by
    by_contra hle
    rw [not_lt, gInv_le_iff huI] at hle
    linarith
  have hprof : gProf u < gDens 0.144 := by
    rw [gProf_of_mem huI]
    exact gDens_strictAntiOn (by norm_num : (0.144 : ℝ) ∈ Ici 0)
      (show (0 : ℝ) ≤ gInv u from le_trans (by norm_num) hinv.le) hinv
  have hdens : gDens 0.144 ≤ 1 / (1.010368 * √(2 * π)) := by
    rw [gDens_eq, div_le_div_iff₀ hs0 (by positivity), one_mul]
    have he : exp (-(0.144 : ℝ) ^ 2 / 2) * 1.010368 ≤ 1 := by
      have := add_one_le_exp ((0.144 : ℝ) ^ 2 / 2)
      rw [show -(0.144 : ℝ) ^ 2 / 2 = -(0.144 ^ 2 / 2) by ring, exp_neg,
        inv_mul_le_iff₀ (exp_pos _)]
      norm_num at this ⊢; linarith
    nlinarith
  have hsq : √2 < 1.41422 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have hsq0 : 0 < √2 := by positivity
  unfold gJw
  rw [← hu]
  have hfin : √2 * 0.895 * (1 / (1.010368 * √(2 * π))) < 2⁻¹ := by
    rw [mul_one_div, div_lt_iff₀ (by positivity)]
    nlinarith
  calc √2 * 0.895 * gProf u < √2 * 0.895 * gDens 0.144 := by gcongr
    _ ≤ √2 * 0.895 * (1 / (1.010368 * √(2 * π))) := by gcongr
    _ < 2⁻¹ := hfin

/-- Numerical bound: $J_{0.896}(\frac12)>\frac12$. -/
theorem gJw_896_gt : 2⁻¹ < gJw 0.896 2⁻¹ := by
  obtain ⟨hs1, hs2⟩ := sqrt_two_pi_bounds
  have hs0 : 0 < √(2 * π) := by linarith
  set u : ℝ := (0.896 : ℝ)⁻¹ * (1 - 2⁻¹) with hu
  have huI : u ∈ Ioo 0 1 := by rw [hu]; constructor <;> norm_num
  have hcdf : u < gCDF 0.147 := by
    have := le_gCDF 0.147 (by norm_num)
    have h2 : (0.0584 : ℝ) < (0.147 - 0.147 ^ 3 / 6) / √(2 * π) := by
      rw [lt_div_iff₀ hs0]; nlinarith
    have h3 : u < (2⁻¹ : ℝ) + 0.0584 := by rw [hu]; norm_num
    linarith
  have hinv : gInv u < 0.147 := by
    by_contra hle
    rw [not_lt, le_gInv_iff huI] at hle
    linarith
  have hinv0 : 0 ≤ gInv u := (gInv_pos ⟨by rw [hu]; norm_num, huI.2⟩).le
  have hprof : gDens 0.147 < gProf u := by
    rw [gProf_of_mem huI]
    exact gDens_strictAntiOn hinv0 (by norm_num : (0.147 : ℝ) ∈ Ici 0) hinv
  have hdens : (1 - 0.0108045) / √(2 * π) ≤ gDens 0.147 := by
    rw [gDens_eq]
    gcongr
    have := add_one_le_exp (-(0.147 : ℝ) ^ 2 / 2)
    norm_num at this ⊢
    linarith
  have hsq : 1.41421 < √2 := by rw [Real.lt_sqrt (by norm_num)]; norm_num
  unfold gJw
  rw [← hu]
  have hfin : 2⁻¹ < √2 * 0.896 * ((1 - 0.0108045) / √(2 * π)) := by
    rw [mul_div_assoc', lt_div_iff₀ hs0]
    nlinarith
  calc 2⁻¹ < √2 * 0.896 * ((1 - 0.0108045) / √(2 * π)) := hfin
    _ ≤ √2 * 0.896 * gDens 0.147 := by gcongr
    _ < √2 * 0.896 * gProf u := by gcongr

/-- [DIR], §3: the solution $w\in(0,1)$ of $J_w(\frac12)=\frac12$ lies in $[0.895,0.896]$. -/
theorem mem_Icc_of_gJw_half_eq {w : ℝ} (hw : w ∈ Ioo 0 1) (h : gJw w 2⁻¹ = 2⁻¹) :
    w ∈ Icc (0.895 : ℝ) 0.896 := by
  have hw1 : 2⁻¹ < w := lt_of_not_ge fun hle ↦ by
    rw [gJw_half_of_le hle] at h; norm_num at h
  have hwI : w ∈ Ioc 2⁻¹ 1 := ⟨hw1, hw.2.le⟩
  constructor
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn hwI ⟨by norm_num, by norm_num⟩ hlt
    simp only at this
    linarith [gJw_895_lt]
  · by_contra hlt
    rw [not_le] at hlt
    have := gJw_half_strictMonoOn ⟨by norm_num, by norm_num⟩ hwI hlt
    simp only at this
    linarith [gJw_896_gt]

/-! ### The function $J$ -/

/-- $C^\infty$ implies $C^2$ (on a set). -/
theorem contDiffOn_two_of_infty {f : ℝ → ℝ} {s : Set ℝ} (hf : ContDiffOn ℝ ∞ f s) :
    ContDiffOn ℝ 2 f s :=
  hf.of_le (by norm_cast)

/-- If $w\in(0,1)$ and $J_w(\frac12)=\frac12$, then $J_w$ satisfies the defining conditions of
$J$ (`Auto.DIR.IsJ`). -/
theorem isJ_gJw {w : ℝ} (hw : w ∈ Ioo 0 1) (h : gJw w 2⁻¹ = 2⁻¹) : IsJ (gJw w) := by
  have hw1 : 2⁻¹ < w := lt_of_not_ge fun hle ↦ by
    rw [gJw_half_of_le hle] at h; norm_num at h
  have hsub : Ioo (2⁻¹ : ℝ) 1 ⊆ Ioo (1 - w) 1 := Ioo_subset_Ioo (by linarith) le_rfl
  refine ⟨(contDiffOn_gJw hw.1).mono hsub,
    (continuousOn_gJw hw.1).mono (Icc_subset_Icc (by linarith) le_rfl),
    fun x hx ↦ gJw_deriv2_mul hw.1 (hsub hx), h, gJw_one w⟩

/-- Uniqueness of $J$: two functions satisfying `Auto.DIR.IsJ` agree on $[\frac12,1]$. -/
theorem isJ_unique {f g : ℝ → ℝ} (hf : IsJ f) (hg : IsJ g) : EqOn f g (Icc 2⁻¹ 1) := by
  have hpos : ∀ f : ℝ → ℝ, IsJ f → ∀ x ∈ Ioo (2⁻¹ : ℝ) 1, 0 < f x := by
    intro f hf x hx
    refine pos_of_ne_zero_of_continuousOn hf.2.1 (by rw [hf.2.2.2.1]; norm_num)
      (fun y hy h0 ↦ ?_) x (Ioo_subset_Ico_self hx)
    have := hf.2.2.1 y hy
    rw [h0, mul_zero] at this; norm_num at this
  have hmul : ∀ f : ℝ → ℝ, IsJ f → ∀ x ∈ Ioo (2⁻¹ : ℝ) 1, f x * deriv (deriv f) x = -2 :=
    fun f hf x hx ↦ by rw [mul_comm]; exact hf.2.2.1 x hx
  exact eqOn_of_mul_deriv2_eq (k := 2) (by norm_num) hf.2.1 hg.2.1 (contDiffOn_two_of_infty hf.1)
    (contDiffOn_two_of_infty hg.1) (hpos f hf) (hpos g hg) (hmul f hf) (hmul g hg)
    (hf.2.2.2.1.trans hg.2.2.2.1.symm) (hf.2.2.2.2.trans hg.2.2.2.2.symm)

/-! ### Proposition 3.3: the function $G_c$ -/

/-- [DIR], proof of Proposition 3.3: derivative of
$G_c(u)=I(c+u)^2-I(c-u)^2+2u^2-4I(c)^2+4I(c)I(c-u)$ (for $c\pm u\in(a,b)$). -/
theorem gc_hasDerivAt (I : ℝ → ℝ) (a b : ℝ) (hI : ContDiffOn ℝ 2 I (Ioo a b)) (c u : ℝ)
    (hcu : c + u ∈ Ioo a b) (hcu' : c - u ∈ Ioo a b) :
    HasDerivAt (fun v ↦ I (c + v) ^ 2 - I (c - v) ^ 2 + 2 * v ^ 2 - 4 * I c ^ 2 +
      4 * I c * I (c - v))
      (2 * deriv I (c + u) * I (c + u) + 2 * deriv I (c - u) * I (c - u) +
        4 * u - 4 * I c * deriv I (c - u)) u := by
  have e1 := HasDerivAt.comp_const_add c u
    (contDiffOn_two_differentiableAt isOpen_Ioo hI hcu).1.hasDerivAt
  have e2 := HasDerivAt.comp_const_sub c u
    (contDiffOn_two_differentiableAt isOpen_Ioo hI hcu').1.hasDerivAt
  have h := (((e1.pow 2).sub (e2.pow 2)).add (((hasDerivAt_id' u).pow 2).const_mul 2)).sub_const
    (4 * I c ^ 2) |>.add (e2.const_mul (4 * I c))
  convert h using 1
  simp; ring

/-- [DIR], proof of Proposition 3.3: near $u$ (with $c\pm u\in(a,b)$), $G_c'$ is given by the
formula of `gc_hasDerivAt`. -/
theorem gc_eventually_deriv (I : ℝ → ℝ) (a b : ℝ) (hI : ContDiffOn ℝ 2 I (Ioo a b)) (c u : ℝ)
    (hcu : c + u ∈ Ioo a b) (hcu' : c - u ∈ Ioo a b) :
    deriv (fun v ↦ I (c + v) ^ 2 - I (c - v) ^ 2 + 2 * v ^ 2 - 4 * I c ^ 2 +
      4 * I c * I (c - v)) =ᶠ[𝓝 u]
      fun v ↦ 2 * deriv I (c + v) * I (c + v) + 2 * deriv I (c - v) * I (c - v) +
        4 * v - 4 * I c * deriv I (c - v) := by
  have h1 : ∀ᶠ v in 𝓝 u, c + v ∈ Ioo a b :=
    (continuous_const.add continuous_id).continuousAt.preimage_mem_nhds (isOpen_Ioo.mem_nhds hcu)
  have h2 : ∀ᶠ v in 𝓝 u, c - v ∈ Ioo a b :=
    (continuous_const.sub continuous_id).continuousAt.preimage_mem_nhds
      (isOpen_Ioo.mem_nhds hcu')
  filter_upwards [h1, h2] with v hv hv'
  exact (gc_hasDerivAt I a b hI c v hv hv').deriv

/-- [DIR], proof of Proposition 3.3: second derivative
$G_c''(u)=2(I'(c+u)^2-I'(c-u)^2)+4(1-\frac{I(c)}{I(c-u)})$, using $I''I=-1$. -/
theorem gc_deriv_hasDerivAt (I : ℝ → ℝ) (a b : ℝ) (hI : ContDiffOn ℝ 2 I (Ioo a b))
    (hII : ∀ x ∈ Ioo a b, deriv (deriv I) x * I x = -1) (c u : ℝ)
    (hcu : c + u ∈ Ioo a b) (hcu' : c - u ∈ Ioo a b) :
    HasDerivAt (deriv (fun v ↦ I (c + v) ^ 2 - I (c - v) ^ 2 + 2 * v ^ 2 - 4 * I c ^ 2 +
      4 * I c * I (c - v)))
      (2 * (deriv I (c + u) ^ 2 - deriv I (c - u) ^ 2) + 4 * (1 - I c / I (c - u))) u := by
  obtain ⟨p1, q1⟩ := contDiffOn_two_differentiableAt isOpen_Ioo hI hcu
  obtain ⟨p2, q2⟩ := contDiffOn_two_differentiableAt isOpen_Ioo hI hcu'
  have a1 := HasDerivAt.comp_const_add c u p1.hasDerivAt
  have a2 := HasDerivAt.comp_const_sub c u p2.hasDerivAt
  have b1 := HasDerivAt.comp_const_add c u q1.hasDerivAt
  have b2 := HasDerivAt.comp_const_sub c u q2.hasDerivAt
  have h := ((((b1.mul a1).const_mul 2).add ((b2.mul a2).const_mul 2)).add
    ((hasDerivAt_id' u).const_mul 4)).sub (b2.const_mul (4 * I c))
  have hne1 : I (c + u) ≠ 0 := fun h0 ↦ by
    have := hII _ hcu; rw [h0, mul_zero] at this; norm_num at this
  have hne2 : I (c - u) ≠ 0 := fun h0 ↦ by
    have := hII _ hcu'; rw [h0, mul_zero] at this; norm_num at this
  have r1 : deriv (deriv I) (c + u) = -(I (c + u))⁻¹ := by
    have := hII _ hcu; field_simp; linarith
  have r2 : deriv (deriv I) (c - u) = -(I (c - u))⁻¹ := by
    have := hII _ hcu'; field_simp; linarith
  have h' : HasDerivAt (fun v ↦ 2 * deriv I (c + v) * I (c + v) + 2 * deriv I (c - v) * I (c - v) +
      4 * v - 4 * I c * deriv I (c - v))
      (2 * (deriv (deriv I) (c + u) * I (c + u) + deriv I (c + u) * deriv I (c + u)) +
        2 * (-deriv (deriv I) (c - u) * I (c - u) + deriv I (c - u) * -deriv I (c - u)) +
        4 * 1 - 4 * I c * -deriv (deriv I) (c - u)) u := by
    convert h using 1
    funext v; simp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply]; ring
  refine (h'.congr_of_eventuallyEq (gc_eventually_deriv I a b hI c u hcu hcu')).congr_deriv ?_
  rw [r1, r2]; field_simp; ring

/-! ### Lemma 3.1: tensorization -/

/-- $\sqrt{\sum_i((f(x)-f(x\oplus e_i))_+)^2}$, i.e. $Mf(x)$ of [DIR], §3 (definitionally equal to
`Auto.DIR.M f x` of the main file). -/
noncomputable def gradPlus {n : ℕ} (f : ({0,1}^n) → ℝ) (x : {0,1}^n) : ℝ :=
  √(∑ i, (max (f x - f (x + e i)) 0) ^ 2)

/-- The two elements of $\mathbb{Z}/2$. -/
theorem tens_zmod2_univ : (Finset.univ : Finset (ZMod 2)) = {0, 1} := by decide

/-- Summing over $\{0,1\}^{n+1}$ by splitting off the first coordinate. -/
theorem tens_cube_sum_cons {n : ℕ} (g : ({0,1}^(n + 1)) → ℝ) :
    ∑ x, g x = ∑ x' : {0,1}^n, g (Fin.cons 0 x') + ∑ x' : {0,1}^n, g (Fin.cons 1 x') := by
  rw [← (Fin.consEquiv fun _ ↦ ZMod 2).sum_comp, Fintype.sum_prod_type, tens_zmod2_univ,
    Finset.sum_pair (by decide)]
  rfl

/-- $\mathbf{E}g=\frac12(\mathbf{E}g(0,\cdot)+\mathbf{E}g(1,\cdot))$ on $\{0,1\}^{n+1}$. -/
theorem tens_expect_cons {n : ℕ} (g : ({0,1}^(n + 1)) → ℝ) :
    𝐄 g = 2⁻¹ * (𝐄 (fun x' : {0,1}^n ↦ g (Fin.cons 0 x')) +
      𝐄 (fun x' : {0,1}^n ↦ g (Fin.cons 1 x'))) := by
  simp only [expect, smul_eq_mul, tens_cube_sum_cons, pow_succ]
  ring

/-- The two points of $\{0,1\}^1$. -/
theorem tens_cube1_univ : (Finset.univ : Finset ({0,1}^1)) = {0, 1} := by decide

/-- $\mathbf{E}g=\frac12(g(0)+g(1))$ on $\{0,1\}^1$. -/
theorem tens_expect_cube1 (g : ({0,1}^1) → ℝ) : 𝐄 g = 2⁻¹ * (g 0 + g 1) := by
  simp only [expect, smul_eq_mul, pow_one, tens_cube1_univ, Finset.sum_pair (show (0 : {0,1}^1) ≠ 1
    by decide)]

/-- $0\oplus e_1=1$ in $\{0,1\}^1$. -/
theorem tens_cube1_e0 : (0 : {0,1}^1) + e 0 = 1 := by decide
/-- $1\oplus e_1=0$ in $\{0,1\}^1$. -/
theorem tens_cube1_e1 : (1 : {0,1}^1) + e 0 = 0 := by decide

/-- $Mf(0)=(f(0)-f(1))_+$ on $\{0,1\}^1$. -/
theorem gradPlus_cube1_zero (g : ({0,1}^1) → ℝ) : gradPlus g 0 = max (g 0 - g 1) 0 := by
  simp only [gradPlus, Fin.sum_univ_one, Fin.isValue, tens_cube1_e0]
  exact Real.sqrt_sq (le_max_right _ _)

/-- $Mf(1)=(f(1)-f(0))_+$ on $\{0,1\}^1$. -/
theorem gradPlus_cube1_one (g : ({0,1}^1) → ℝ) : gradPlus g 1 = max (g 1 - g 0) 0 := by
  simp only [gradPlus, Fin.sum_univ_one, Fin.isValue, tens_cube1_e1]
  exact Real.sqrt_sq (le_max_right _ _)

/-- Flipping the first bit of $(a,x')$. -/
theorem tens_cons_add_e_zero {n : ℕ} (a : ZMod 2) (x' : {0,1}^n) :
    (Fin.cons a x' : {0,1}^(n + 1)) + e 0 = Fin.cons (a + 1) x' := by
  funext i
  refine Fin.cases ?_ (fun k ↦ ?_) i <;> simp [e, Fin.succ_ne_zero]

/-- Flipping bit $j+1$ of $(a,x')$. -/
theorem tens_cons_add_e_succ {n : ℕ} (a : ZMod 2) (x' : {0,1}^n) (j : Fin n) :
    (Fin.cons a x' : {0,1}^(n + 1)) + e j.succ = Fin.cons a (x' + e j) := by
  funext i
  refine Fin.cases ?_ (fun k ↦ ?_) i <;> simp [e, Pi.single_apply, (Fin.succ_ne_zero j).symm]

/-- $(Mf)^2(a,x')=((f(a,x')-f(a+1,x'))_+)^2+(Mf(a,\cdot))^2(x')$. -/
theorem gradPlus_cons_sq {n : ℕ} (f : ({0,1}^(n + 1)) → ℝ) (a : ZMod 2) (x' : {0,1}^n) :
    gradPlus f (Fin.cons a x') ^ 2 = (max (f (Fin.cons a x') - f (Fin.cons (a + 1) x')) 0) ^ 2 +
      gradPlus (fun y ↦ f (Fin.cons a y)) x' ^ 2 := by
  simp only [gradPlus]
  rw [Real.sq_sqrt (Finset.sum_nonneg fun _ _ ↦ sq_nonneg _),
    Real.sq_sqrt (Finset.sum_nonneg fun _ _ ↦ sq_nonneg _), Fin.sum_univ_succ,
    tens_cons_add_e_zero]
  simp only [tens_cons_add_e_succ]

/-- An expectation of an $\mathcal I$-valued function lies in the interval $\mathcal I$. -/
theorem tens_expect_mem {n : ℕ} {𝓘 : Set ℝ} (h𝓘 : 𝓘.OrdConnected) (g : ({0,1}^n) → ℝ)
    (hg : ∀ x, g x ∈ 𝓘) : 𝐄 g ∈ 𝓘 := by
  obtain ⟨x1, hx1⟩ := Finite.exists_min g
  obtain ⟨x2, hx2⟩ := Finite.exists_max g
  have hc : (Fintype.card ({0,1}^n) : ℝ) = 2 ^ n := by simp
  have hpos : (0 : ℝ) < 2⁻¹ ^ n := by positivity
  have e1 : (2⁻¹ : ℝ) ^ n * (2 ^ n) = 1 := by rw [← mul_pow]; norm_num
  refine h𝓘.out (hg x1) (hg x2) ⟨?_, ?_⟩
  · have : ∑ _x : {0,1}^n, g x1 ≤ ∑ x, g x := Finset.sum_le_sum fun x _ ↦ hx1 x
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hc] at this
    simp only [expect, smul_eq_mul]
    calc g x1 = 2⁻¹ ^ n * (2 ^ n * g x1) := by rw [← mul_assoc, e1, one_mul]
      _ ≤ 2⁻¹ ^ n * ∑ x, g x := mul_le_mul_of_nonneg_left this hpos.le
  · have : ∑ x, g x ≤ ∑ _x : {0,1}^n, g x2 := Finset.sum_le_sum fun x _ ↦ hx2 x
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, hc] at this
    simp only [expect, smul_eq_mul]
    calc 2⁻¹ ^ n * ∑ x, g x ≤ 2⁻¹ ^ n * (2 ^ n * g x2) := mul_le_mul_of_nonneg_left this hpos.le
      _ = g x2 := by rw [← mul_assoc, e1, one_mul]

/-- Monotonicity of $\mathbf{E}$. -/
theorem tens_expect_mono {n : ℕ} {g₁ g₂ : ({0,1}^n) → ℝ} (h : ∀ x, g₁ x ≤ g₂ x) : 𝐄 g₁ ≤ 𝐄 g₂ := by
  simp only [expect, smul_eq_mul]
  exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun x _ ↦ h x) (by positivity)

/-- Linearity: $\mathbf{E}(g_1-g_2)=\mathbf{E}g_1-\mathbf{E}g_2$. -/
theorem tens_expect_sub {n : ℕ} (g₁ g₂ : ({0,1}^n) → ℝ) :
    𝐄 (fun x ↦ g₁ x - g₂ x) = 𝐄 g₁ - 𝐄 g₂ := by
  simp only [expect, smul_eq_mul, Finset.sum_sub_distrib]; ring

/-- Minkowski's inequality in $\mathbb{R}^2$:
$\sqrt{(\mathbf{E}u)^2+(\mathbf{E}v)^2}\le\mathbf{E}\sqrt{u^2+v^2}$. -/
theorem tens_sqrt_expect_sq_add_le {n : ℕ} (u v : ({0,1}^n) → ℝ) :
    √((𝐄 u) ^ 2 + (𝐄 v) ^ 2) ≤ 𝐄 (fun x ↦ √(u x ^ 2 + v x ^ 2)) := by
  have key : √((∑ x, u x) ^ 2 + (∑ x, v x) ^ 2) ≤ ∑ x, √(u x ^ 2 + v x ^ 2) := by
    have h := norm_sum_le (Finset.univ : Finset ({0,1}^n)) (fun x ↦ (⟨u x, v x⟩ : ℂ))
    simp only [Complex.norm_def, Complex.normSq_apply, Complex.re_sum, Complex.im_sum] at h
    simpa [sq] using h
  simp only [expect, smul_eq_mul]
  set c : ℝ := 2⁻¹ ^ n
  have hc : 0 ≤ c := by positivity
  have e : (c * ∑ x, u x) ^ 2 + (c * ∑ x, v x) ^ 2 =
      c ^ 2 * ((∑ x, u x) ^ 2 + (∑ x, v x) ^ 2) := by ring
  rw [e, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]
  exact mul_le_mul_of_nonneg_left key hc

/-- [DIR], Lemma 3.1 (tensorization of the two-point inequality (3.1)), with $Mf$ written out
as `gradPlus`. Proof by induction on $n$ ([Bob97, Lemma 1]). -/
theorem tensor_two_point (𝓘 : Set ℝ) (h𝓘 : 𝓘.OrdConnected) (B : ℝ → ℝ)
    (hB : ∀ t ∈ 𝓘, 0 ≤ B t)
    (h1 : ∀ f : ({0,1}^1) → ℝ, (∀ x, f x ∈ 𝓘) →
      B (𝐄 f) ≤ 𝐄 (fun x ↦ √(B (f x) ^ 2 + (gradPlus f x) ^ 2)))
    (n : ℕ) (hn : 1 ≤ n) (f : ({0,1}^n) → ℝ) (hf : ∀ x, f x ∈ 𝓘) :
    B (𝐄 f) ≤ 𝐄 (fun x ↦ √(B (f x) ^ 2 + (gradPlus f x) ^ 2)) := by
  induction n, hn using Nat.le_induction with
  | base => exact h1 f hf
  | succ n hn ih =>
    set F : ZMod 2 → ({0,1}^n) → ℝ := fun a x' ↦ f (Fin.cons a x') with hF
    have hFm : ∀ a, 𝐄 (F a) ∈ 𝓘 := fun a ↦ tens_expect_mem h𝓘 _ fun x' ↦ hf _
    set φ : ({0,1}^1) → ℝ := fun z ↦ 𝐄 (F (z 0)) with hφ
    have hφ0 : φ 0 = 𝐄 (F 0) := rfl
    have hφ1 : φ 1 = 𝐄 (F 1) := rfl
    have hEf : 𝐄 f = 𝐄 φ := by rw [tens_expect_cons, tens_expect_cube1, hφ0, hφ1]
    have hstep := h1 φ fun z ↦ hFm _
    rw [tens_expect_cube1 (fun x ↦ √(B (φ x) ^ 2 + gradPlus φ x ^ 2)), gradPlus_cube1_zero,
      gradPlus_cube1_one, hφ0, hφ1] at hstep
    -- one slice
    have slice : ∀ a : ZMod 2,
        √(B (𝐄 (F a)) ^ 2 + (max (𝐄 (F a) - 𝐄 (F (a + 1))) 0) ^ 2) ≤
          𝐄 (fun x' ↦ √(B (f (Fin.cons a x')) ^ 2 + gradPlus f (Fin.cons a x') ^ 2)) := by
      intro a
      set u : ({0,1}^n) → ℝ := fun x' ↦ √(B (F a x') ^ 2 + gradPlus (F a) x' ^ 2) with hu
      set v : ({0,1}^n) → ℝ := fun x' ↦ max (F a x' - F (a + 1) x') 0 with hv
      have hIH : B (𝐄 (F a)) ≤ 𝐄 u := ih (F a) fun x' ↦ hf _
      have hB0 : 0 ≤ B (𝐄 (F a)) := hB _ (hFm a)
      have hmax : max (𝐄 (F a) - 𝐄 (F (a + 1))) 0 ≤ 𝐄 v := by
        apply max_le
        · rw [← tens_expect_sub]; exact tens_expect_mono fun x' ↦ le_max_left _ _
        · have := tens_expect_mono (g₁ := fun _ ↦ (0 : ℝ)) (g₂ := v) fun x' ↦ le_max_right _ _
          simpa [expect] using this
      have hm0 : 0 ≤ max (𝐄 (F a) - 𝐄 (F (a + 1))) 0 := le_max_right _ _
      calc √(B (𝐄 (F a)) ^ 2 + (max (𝐄 (F a) - 𝐄 (F (a + 1))) 0) ^ 2)
          ≤ √((𝐄 u) ^ 2 + (𝐄 v) ^ 2) := by
            apply Real.sqrt_le_sqrt
            have := pow_le_pow_left₀ hB0 hIH 2
            have := pow_le_pow_left₀ hm0 hmax 2
            linarith
        _ ≤ 𝐄 (fun x' ↦ √(u x' ^ 2 + v x' ^ 2)) := tens_sqrt_expect_sq_add_le u v
        _ = 𝐄 (fun x' ↦ √(B (f (Fin.cons a x')) ^ 2 + gradPlus f (Fin.cons a x') ^ 2)) := by
            congr 1; funext x'
            rw [gradPlus_cons_sq f a x', hu, hv]
            simp only
            rw [Real.sq_sqrt (by positivity)]
            congr 1; ring
    have s0 := slice 0
    have s1 := slice 1
    have e11 : (1 : ZMod 2) + 1 = 0 := by decide
    rw [zero_add] at s0
    rw [e11] at s1
    rw [hEf, tens_expect_cons (fun x ↦ √(B (f x) ^ 2 + gradPlus f x ^ 2))]
    linarith

/-- Linearity: $\mathbf{E}(cg)=c\,\mathbf{E}g$. -/
theorem tens_expect_const_mul {n : ℕ} (c : ℝ) (g : ({0,1}^n) → ℝ) :
    𝐄 (fun x ↦ c * g x) = c * 𝐄 g := by
  simp only [expect, smul_eq_mul, ← Finset.mul_sum]; ring

/-- Linearity: $\mathbf{E}(g_1+g_2)=\mathbf{E}g_1+\mathbf{E}g_2$. -/
theorem tens_expect_add {n : ℕ} (g₁ g₂ : ({0,1}^n) → ℝ) :
    𝐄 (fun x ↦ g₁ x + g₂ x) = 𝐄 g₁ + 𝐄 g₂ := by
  simp only [expect, smul_eq_mul, Finset.sum_add_distrib]; ring

/-- $M(cg)=c\,Mg$ for $c\ge0$. -/
theorem gradPlus_const_mul {n : ℕ} {c : ℝ} (hc : 0 ≤ c) (g : ({0,1}^n) → ℝ) (x : {0,1}^n) :
    gradPlus (fun y ↦ c * g y) x = c * gradPlus g x := by
  simp only [gradPlus]
  have e : ∀ i, (max (c * g x - c * g (x + e i)) 0) ^ 2 =
      c ^ 2 * (max (g x - g (x + e i)) 0) ^ 2 := fun i ↦ by
    have hm : max (c * g x - c * g (x + e i)) 0 = c * max (g x - g (x + e i)) 0 := by
      rw [mul_max_of_nonneg _ _ hc, mul_sub, mul_zero]
    rw [hm, mul_pow]
  simp only [e, ← Finset.mul_sum]
  rw [Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq hc]

/-! ### [BIM23], Lemmas 2.2 and 2.3 -/

/-- [BIM23], proof of Lemma 2.2, (logar1): $-\ln(1-s)\ge s+\frac{s^2}2$ for $0\le s<1$. -/
theorem bim_log_one_sub_le {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s < 1) :
    s + s ^ 2 / 2 ≤ -log (1 - s) := by
  have h := Real.hasSum_pow_div_log_of_abs_lt_one (x := s)
    (by rw [abs_lt]; constructor <;> linarith)
  have := sum_le_hasSum (Finset.range 2) (fun i _ ↦ by positivity) h
  norm_num [Finset.sum_range_succ] at this
  linarith

/-- The quartic $v(s)$ of [BIM23], proof of Lemma 2.2 (with $\ell=\ln2$). -/
noncomputable def bimV (ℓ s : ℝ) : ℝ :=
  4 * (ℓ - 1) ^ 2 * s ^ 4 + 12 * (1 - ℓ) * (2 * ℓ - 1) * s ^ 3 -
    (17 - 18 * ℓ) * (2 * ℓ - 1) * s ^ 2 - (12 - 24 * ℓ + 16 * ℓ ^ 2) * s +
      32 * ℓ ^ 2 - 32 * ℓ + 4

/-- [BIM23], proof of Lemma 2.2: $v(s)<0$ on $[0,1]$ (the paper uses Descartes' rule of signs;
here the sign pattern of the coefficients is used directly). -/
theorem bimV_neg {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) : bimV (log 2) s < 0 := by
  have h1 := Real.log_two_gt_d9
  have h2 := Real.log_two_lt_d9
  unfold bimV
  set ℓ := log 2
  have hs2 : s ^ 2 ≤ s := by nlinarith
  have hs3 : s ^ 3 ≤ s ^ 2 := by nlinarith
  have hs4 : s ^ 4 ≤ s ^ 3 := by nlinarith
  have k4 : 0 ≤ 4 * (ℓ - 1) ^ 2 := by positivity
  have k3 : 0 ≤ 12 * (1 - ℓ) * (2 * ℓ - 1) := by nlinarith
  nlinarith [mul_le_mul_of_nonneg_left hs4 k4, mul_le_mul_of_nonneg_left hs3 k3,
    pow_nonneg hs0 2, pow_nonneg hs0 3, mul_nonneg hs0 (sub_nonneg.2 hs1)]

/-- [BIM23], proof of Lemma 2.2: after replacing the logarithms by (logar1), (logar2) and
squaring twice, the difference of the two sides is $-\frac{s^2(1-s)^2}{4\ell^2}v(s)$. -/
theorem bim_poly_identity (ℓ s : ℝ) (hℓ : ℓ ≠ 0) :
    4 * (1 - s) ^ 2 * (1 + s ^ 2) * (1 + s / ℓ + s ^ 2 / (2 * ℓ)) -
      ((2 - s) ^ 2 * (1 + s / (2 * ℓ) + (1 - 1 / (2 * ℓ)) * s ^ 2) -
        (1 - s) ^ 2 * (1 + s / ℓ + s ^ 2 / (2 * ℓ)) - 1 - s ^ 2) ^ 2 =
      -(s ^ 2 * (1 - s) ^ 2 * bimV ℓ s) / (4 * ℓ ^ 2) := by
  unfold bimV
  field_simp
  ring

/-- (logar2): $\ln\frac2{2-s}\le\frac s2+(\ln2-\frac12)s^2$ on $[0,1]$. -/
theorem bim_log_two_div_le {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    log (2 / (2 - s)) ≤ s / 2 + (log 2 - 2⁻¹) * s ^ 2 := by
  have l1 := Real.log_two_gt_d9
  have l2 := Real.log_two_lt_d9
  set ℓ := log 2 with hℓ
  set g : ℝ → ℝ := fun s ↦ s / 2 + (ℓ - 2⁻¹) * s ^ 2 - ℓ + log (2 - s) with hg
  have hgd : ∀ s, s < 2 → HasDerivAt g (2⁻¹ + (ℓ - 2⁻¹) * (2 * s) - 1 / (2 - s)) s := by
    intro s hs
    have hl := ((hasDerivAt_id' s).const_sub 2).log (by linarith)
    have h := ((((hasDerivAt_id' s).div_const 2).add
      (((hasDerivAt_id' s).pow 2).const_mul (ℓ - 2⁻¹))).sub_const ℓ).add hl
    convert h using 1
    simp; ring
  have hcont : ContinuousOn g (Icc 0 1) := fun s hs ↦
    (hgd s (by linarith [hs.2])).continuousAt.continuousWithinAt
  have hdiff : ∀ s ∈ Ioo (0 : ℝ) 1, DifferentiableWithinAt ℝ g (Ioo 0 1) s := fun s hs ↦
    (hgd s (by linarith [hs.2])).differentiableAt.differentiableWithinAt
  set sst := (4 * ℓ - 5 / 2) / (2 * ℓ - 1) with hsst
  have hden : 0 < 2 * ℓ - 1 := by linarith
  have hsst0 : 0 < sst := div_pos (by linarith) hden
  have hsst1 : sst < 1 := (div_lt_one hden).2 (by linarith)
  have key : ∀ s, s < 2 → 2⁻¹ + (ℓ - 2⁻¹) * (2 * s) - 1 / (2 - s) =
      s * ((4 * ℓ - 5 / 2) - (2 * ℓ - 1) * s) / (2 - s) := by
    intro s hs
    have : (2 - s) ≠ 0 := by linarith
    field_simp
    ring
  have g0 : g 0 = 0 := by simp only [hg]; norm_num [hℓ]
  have g1 : g 1 = 0 := by
    simp only [hg]; norm_num [hℓ]
  have gs : g s = s / 2 + (ℓ - 2⁻¹) * s ^ 2 - (log (2 / (2 - s))) := by
    simp only [hg]
    rw [Real.log_div (by norm_num) (by linarith)]; ring
  suffices 0 ≤ g s by linarith
  rcases le_total s sst with hss | hss
  · have hmono : MonotoneOn g (Icc 0 sst) := by
      refine monotoneOn_of_deriv_nonneg (convex_Icc 0 sst)
        (hcont.mono (Icc_subset_Icc le_rfl hsst1.le)) ?_ ?_
      · rw [interior_Icc]; intro u hu
        exact (hgd u (by linarith [hu.2])).differentiableAt.differentiableWithinAt
      · rw [interior_Icc]; intro u hu
        rw [(hgd u (by linarith [hu.2])).deriv, key u (by linarith [hu.2])]
        apply div_nonneg _ (by linarith [hu.2])
        apply mul_nonneg hu.1.le
        have : (2 * ℓ - 1) * u ≤ (2 * ℓ - 1) * sst := by nlinarith [hu.2]
        have e : (2 * ℓ - 1) * sst = 4 * ℓ - 5 / 2 := by
          rw [hsst]; field_simp
        linarith
    have := hmono ⟨le_rfl, hsst0.le⟩ ⟨hs0, hss⟩ hs0
    linarith
  · have hanti : AntitoneOn g (Icc sst 1) := by
      refine antitoneOn_of_deriv_nonpos (convex_Icc sst 1)
        (hcont.mono (Icc_subset_Icc hsst0.le le_rfl)) ?_ ?_
      · rw [interior_Icc]; intro u hu
        exact (hgd u (by linarith [hu.2])).differentiableAt.differentiableWithinAt
      · rw [interior_Icc]; intro u hu
        rw [(hgd u (by linarith [hu.2])).deriv, key u (by linarith [hu.2])]
        apply div_nonpos_of_nonpos_of_nonneg _ (by linarith [hu.2])
        apply mul_nonpos_of_nonneg_of_nonpos (by linarith [hu.1])
        have : (2 * ℓ - 1) * sst ≤ (2 * ℓ - 1) * u := by nlinarith [hu.1]
        have e : (2 * ℓ - 1) * sst = 4 * ℓ - 5 / 2 := by
          rw [hsst]; field_simp
        linarith
    have := hanti ⟨hss, hs1⟩ ⟨hsst1.le, le_rfl⟩ hs1
    linarith

/-- [BIM23], proof of Lemma 2.2, Step 3: the inequality (22point). -/
theorem bim_step3 {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    (1 + t) * √(1 + logb 2 (2 / (1 + t))) ≤
      √(1 + (1 - t) ^ 2) + t * √(1 + logb 2 t⁻¹) := by
  have l1 := Real.log_two_gt_d9
  have l2 := Real.log_two_lt_d9
  have hℓ : 0 < log 2 := by linarith
  set ℓ := log 2 with hℓdef
  set s := 1 - t with hsdef
  have hs0 : 0 ≤ s := by linarith
  have hs1 : s ≤ 1 := by linarith
  set A := 1 + s / ℓ + s ^ 2 / (2 * ℓ) with hA
  set Bq := 1 + s / (2 * ℓ) + (1 - 1 / (2 * ℓ)) * s ^ 2 with hBq
  have hA0 : 0 ≤ A := by positivity
  have hc : 0 < 1 - 1 / (2 * ℓ) := by
    rw [sub_pos, div_lt_one (by linarith)]; linarith
  have hB0 : 0 ≤ Bq := by positivity
  -- lower bound (logar1)
  have hlow : t * √A ≤ t * √(1 + logb 2 t⁻¹) := by
    rcases ht0.lt_or_eq with htp | htz
    · apply mul_le_mul_of_nonneg_left _ ht0
      apply Real.sqrt_le_sqrt
      have h1 := bim_log_one_sub_le hs0 (by linarith : s < 1)
      have e1 : 1 - s = t := by rw [hsdef]; ring
      rw [e1] at h1
      have e2 : logb 2 t⁻¹ = -log t / ℓ := by
        rw [Real.logb, Real.log_inv]
      rw [e2, hA]
      have : (s + s ^ 2 / 2) / ℓ ≤ -log t / ℓ := div_le_div_of_nonneg_right h1 hℓ.le
      have e3 : s / ℓ + s ^ 2 / (2 * ℓ) = (s + s ^ 2 / 2) / ℓ := by field_simp
      linarith
    · rw [← htz]; simp
  -- upper bound (logar2)
  have hup : √(1 + logb 2 (2 / (1 + t))) ≤ √Bq := by
    apply Real.sqrt_le_sqrt
    have h2 := bim_log_two_div_le hs0 hs1
    have e1 : 2 - s = 1 + t := by rw [hsdef]; ring
    rw [e1] at h2
    have : log (2 / (1 + t)) / ℓ ≤ (s / 2 + (ℓ - 2⁻¹) * s ^ 2) / ℓ :=
      div_le_div_of_nonneg_right h2 hℓ.le
    have e3 : (s / 2 + (ℓ - 2⁻¹) * s ^ 2) / ℓ = s / (2 * ℓ) + (1 - 1 / (2 * ℓ)) * s ^ 2 := by
      field_simp
    rw [Real.logb]
    rw [hBq]; linarith
  -- the squared polynomial inequality
  have hmain : (2 - s) * √Bq ≤ √(1 + s ^ 2) + (1 - s) * √A := by
    have hP := Real.sqrt_nonneg (1 + s ^ 2)
    have hQ := Real.sqrt_nonneg A
    have hP2 := Real.sq_sqrt (by positivity : (0 : ℝ) ≤ 1 + s ^ 2)
    have hQ2 := Real.sq_sqrt hA0
    have hB2 := Real.sq_sqrt hB0
    have hBn := Real.sqrt_nonneg Bq
    set R := (2 - s) ^ 2 * Bq - (1 - s) ^ 2 * A - 1 - s ^ 2 with hR
    have hRle : R ≤ 2 * (1 - s) * (√(1 + s ^ 2) * √A) := by
      rcases le_or_gt R 0 with hR0 | hR0
      · have : 0 ≤ 2 * (1 - s) * (√(1 + s ^ 2) * √A) := by positivity
        linarith
      · have hpoly := bim_poly_identity ℓ s hℓ.ne'
        have hv := bimV_neg hs0 hs1
        have hnn : 0 ≤ -(s ^ 2 * (1 - s) ^ 2 * bimV ℓ s) / (4 * ℓ ^ 2) := by
          apply div_nonneg _ (by positivity)
          have : 0 ≤ s ^ 2 * (1 - s) ^ 2 := by positivity
          nlinarith
        have hsq : R ^ 2 ≤ (2 * (1 - s) * (√(1 + s ^ 2) * √A)) ^ 2 := by
          have : (2 * (1 - s) * (√(1 + s ^ 2) * √A)) ^ 2 =
              4 * (1 - s) ^ 2 * (1 + s ^ 2) * A := by
            rw [mul_pow, mul_pow, mul_pow, hP2, hQ2]; ring
          rw [this]; rw [hR]; linarith
        exact (pow_le_pow_iff_left₀ hR0.le (by positivity) two_ne_zero).1 hsq
    have hsq : ((2 - s) * √Bq) ^ 2 ≤ (√(1 + s ^ 2) + (1 - s) * √A) ^ 2 := by
      have e1 : ((2 - s) * √Bq) ^ 2 = (2 - s) ^ 2 * Bq := by rw [mul_pow, hB2]
      have e2 : (√(1 + s ^ 2) + (1 - s) * √A) ^ 2 =
          (1 + s ^ 2) + (1 - s) ^ 2 * A + 2 * (1 - s) * (√(1 + s ^ 2) * √A) := by
        ring_nf; rw [hP2, hQ2]; ring
      rw [e1, e2]; rw [hR] at hRle; linarith
    exact (pow_le_pow_iff_left₀ (by nlinarith) (by positivity) two_ne_zero).1 hsq
  have e2 : 1 + t = 2 - s := by rw [hsdef]; ring
  have e3 : t = 1 - s := by rw [hsdef]; ring
  calc (1 + t) * √(1 + logb 2 (2 / (1 + t))) ≤ (1 + t) * √Bq :=
        mul_le_mul_of_nonneg_left hup (by linarith)
    _ = (2 - s) * √Bq := by rw [e2]
    _ ≤ √(1 + s ^ 2) + (1 - s) * √A := hmain
    _ = √(1 + s ^ 2) + t * √A := by rw [← e3]
    _ ≤ √(1 + s ^ 2) + t * √(1 + logb 2 t⁻¹) := by linarith

/-- AM–GM step of [BIM23], Step 2: $\sqrt{(p^2+s)(q^2+s)}\ge s+pq$ for $s\ge0$. -/
theorem bim_sqrt_prod_ge {p q s : ℝ} (hs : 0 ≤ s) :
    s + p * q ≤ √((p ^ 2 + s) * (q ^ 2 + s)) := by
  apply Real.le_sqrt_of_sq_le
  nlinarith [mul_nonneg hs (sq_nonneg (p - q))]

/-- [BIM23], proof of Lemma 2.2, Steps 2–3 ($\beta=\frac12$), in the variables $t=x/y$,
$a=\log_2(1/y)\ge1$. -/
theorem bim_half_t {t a : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (ha : 1 ≤ a) :
    (1 + t) * √(a + logb 2 (2 / (1 + t))) ≤
      √(a + (1 - t) ^ 2) + t * √(a + logb 2 t⁻¹) := by
  set X := (1 - t) ^ 2 with hX
  set lam := logb 2 t⁻¹ with hlam
  set μ := logb 2 (2 / (1 + t)) with hμ
  have hlam0 : 0 ≤ lam := by
    rcases ht0.lt_or_eq with htp | htz
    · exact Real.logb_nonneg (by norm_num) (one_le_inv₀ htp |>.2 ht1)
    · rw [hlam, ← htz]; simp
  have hμ0 : 0 ≤ μ := Real.logb_nonneg (by norm_num) ((one_le_div (by linarith)).2 (by linarith))
  have h3 := bim_step3 ht0 ht1
  rw [← hμ, ← hlam] at h3
  rw [show (1 - t) ^ 2 = X from rfl] at h3
  set P1 := √(1 + X)
  set Q1 := √(1 + lam)
  set Pa := √(a + X)
  set Qa := √(a + lam)
  have hX0 : 0 ≤ X := sq_nonneg _
  have hP1 : P1 ^ 2 = 1 + X := Real.sq_sqrt (by linarith)
  have hQ1 : Q1 ^ 2 = 1 + lam := Real.sq_sqrt (by linarith)
  have hPa : Pa ^ 2 = a + X := Real.sq_sqrt (by linarith)
  have hQa : Qa ^ 2 = a + lam := Real.sq_sqrt (by linarith)
  have hC : √(a + μ) ^ 2 = a + μ := Real.sq_sqrt (by linarith)
  have hC1 : √(1 + μ) ^ 2 = 1 + μ := Real.sq_sqrt (by linarith)
  have hP1n : 0 ≤ P1 := Real.sqrt_nonneg _
  have hQ1n : 0 ≤ Q1 := Real.sqrt_nonneg _
  have hPan : 0 ≤ Pa := Real.sqrt_nonneg _
  have hQan : 0 ≤ Qa := Real.sqrt_nonneg _
  -- monotonicity in `a`: `Pa * Qa ≥ (a - 1) + P1 * Q1`
  have hmono : (a - 1) + P1 * Q1 ≤ Pa * Qa := by
    have := bim_sqrt_prod_ge (p := P1) (q := Q1) (by linarith : 0 ≤ a - 1)
    rw [hP1, hQ1] at this
    have e : (1 + X + (a - 1)) * (1 + lam + (a - 1)) = (a + X) * (a + lam) := by ring
    rw [e, Real.sqrt_mul (by linarith)] at this
    exact this
  -- squared Step 3
  have h3sq : ((1 + t) * √(1 + μ)) ^ 2 ≤ (P1 + t * Q1) ^ 2 :=
    pow_le_pow_left₀ (by positivity) h3 2
  have hsq : ((1 + t) * √(a + μ)) ^ 2 ≤ (Pa + t * Qa) ^ 2 := by
    have e1 : ((1 + t) * √(a + μ)) ^ 2 = (1 + t) ^ 2 * (a + μ) := by rw [mul_pow, hC]
    have e2 : ((1 + t) * √(1 + μ)) ^ 2 = (1 + t) ^ 2 * (1 + μ) := by rw [mul_pow, hC1]
    have e3 : (P1 + t * Q1) ^ 2 = 1 + X + t ^ 2 * (1 + lam) + 2 * t * (P1 * Q1) := by
      ring_nf; rw [hP1, hQ1]; ring
    have e4 : (Pa + t * Qa) ^ 2 = a + X + t ^ 2 * (a + lam) + 2 * t * (Pa * Qa) := by
      ring_nf; rw [hPa, hQa]; ring
    rw [e2, e3] at h3sq
    rw [e1, e4]
    nlinarith [mul_le_mul_of_nonneg_left hmono (by linarith : 0 ≤ 2 * t)]
  exact (pow_le_pow_iff_left₀ (by positivity) (by positivity) two_ne_zero).1 hsq

/-- $(\sqrt z)^{2\beta}=z^\beta$ for $z\ge0$. -/
theorem sqrt_rpow_two_mul {z : ℝ} (hz : 0 ≤ z) (β : ℝ) : √z ^ (2 * β) = z ^ β := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hz]; congr 1; ring

/-- [BIM23], proof of Lemma 2.2, Step 1 (power means), in the variables $t$, $a$. -/
theorem bim_beta_t {β : ℝ} (hβ : 2⁻¹ ≤ β) {t a : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (ha : 1 ≤ a) :
    (1 + t) * (a + logb 2 (2 / (1 + t))) ^ β ≤
      (a + (1 - t) ^ β⁻¹) ^ β + t * (a + logb 2 t⁻¹) ^ β := by
  have hβ0 : 0 < β := by linarith
  set lam := logb 2 t⁻¹ with hlam
  set μ := logb 2 (2 / (1 + t)) with hμ
  have hlam0 : 0 ≤ lam := by
    rcases ht0.lt_or_eq with htp | htz
    · exact Real.logb_nonneg (by norm_num) (one_le_inv₀ htp |>.2 ht1)
    · rw [hlam, ← htz]; simp
  have hμ0 : 0 ≤ μ := Real.logb_nonneg (by norm_num) ((one_le_div (by linarith)).2 (by linarith))
  have hX : (1 - t) ^ 2 ≤ (1 - t) ^ β⁻¹ := by
    have hinv : β⁻¹ ≤ 2 := by rw [inv_le_comm₀ hβ0 two_pos]; exact hβ
    rcases (sub_nonneg.2 ht1).lt_or_eq with hp | hz
    · rw [← Real.rpow_two]
      exact Real.rpow_le_rpow_of_exponent_ge hp (by linarith) hinv
    · rw [← hz, Real.zero_rpow (inv_ne_zero hβ0.ne')]; simp
  have h := bim_half_t ht0 ht1 ha
  rw [← hμ, ← hlam] at h
  set A := a + (1 - t) ^ 2
  set B := a + lam
  set C := a + μ
  have hA : 0 ≤ A := by positivity
  have hB : 0 ≤ B := by linarith
  have hC : 0 ≤ C := by linarith
  have hpq : 0 < 1 + t := by linarith
  set p := 1 / (1 + t) with hpdef
  set q := t / (1 + t) with hqdef
  have hp : 0 ≤ p := by positivity
  have hq : 0 ≤ q := by positivity
  have hpq1 : p + q = 1 := by rw [hpdef, hqdef]; field_simp
  have hmean : √C ≤ p * √A + q * √B := by
    have : p * √A + q * √B = (√A + t * √B) / (1 + t) := by rw [hpdef, hqdef]; field_simp
    rw [this, le_div_iff₀ hpq]; linarith
  have hconv := (convexOn_rpow (by linarith : (1 : ℝ) ≤ 2 * β)).2
    (Real.sqrt_nonneg A) (Real.sqrt_nonneg B) hp hq hpq1
  simp only [smul_eq_mul] at hconv
  have hmon := Real.rpow_le_rpow (Real.sqrt_nonneg C) hmean (by linarith : 0 ≤ 2 * β)
  rw [sqrt_rpow_two_mul hA, sqrt_rpow_two_mul hB] at hconv
  rw [sqrt_rpow_two_mul hC] at hmon
  have h1 : C ^ β ≤ p * A ^ β + q * B ^ β := hmon.trans hconv
  have h2 : (1 + t) * C ^ β ≤ A ^ β + t * B ^ β := by
    have : (1 + t) * (p * A ^ β + q * B ^ β) = A ^ β + t * B ^ β := by
      rw [hpdef, hqdef]; field_simp
    nlinarith
  have h3 : A ^ β ≤ (a + (1 - t) ^ β⁻¹) ^ β :=
    Real.rpow_le_rpow hA (by linarith) hβ0.le
  linarith

/-- **[BIM23], Lemma 2.2.** For $\beta\in[\frac12,1]$ and $0\le x\le y\le\frac12$,
$((y-x)^{1/\beta}+L_\beta(y)^{1/\beta})^\beta+L_\beta(x)\ge2L_\beta(\frac{x+y}2)$. -/
theorem bim_lemma_2_2 (β : ℝ) (hβ : 2⁻¹ ≤ β) (x y : ℝ) (hx : 0 ≤ x) (hxy : x ≤ y)
    (hy : y ≤ 2⁻¹) : ((y - x) ^ β⁻¹ + L β y ^ β⁻¹) ^ β + L β x ≥ 2 * L β ((x + y) / 2) := by
  have hβ0 : 0 < β := by linarith
  rcases (hx.trans hxy).lt_or_eq with hyp | hy0
  · set t := x / y with ht
    set a := logb 2 y⁻¹ with ha
    have ht0 : 0 ≤ t := div_nonneg hx hyp.le
    have ht1 : t ≤ 1 := (div_le_one hyp).2 hxy
    have ha1 : 1 ≤ a := by
      rw [ha, ← Real.logb_self_eq_one (by norm_num : (1 : ℝ) < 2)]
      exact Real.logb_le_logb_of_le (by norm_num) (by norm_num)
        (by rw [le_inv_comm₀ (by norm_num) hyp]; exact hy)
    have hxt : x = y * t := by rw [ht]; field_simp
    have hB := bim_beta_t hβ ht0 ht1 ha1
    have ha0 : 0 ≤ a := by linarith
    -- the first term
    have eLy : L β y ^ β⁻¹ = y ^ β⁻¹ * a := by
      rw [L, ← ha, Real.mul_rpow hyp.le (Real.rpow_nonneg ha0 _),
        Real.rpow_rpow_inv ha0 hβ0.ne']
    have eyx : (y - x) ^ β⁻¹ = y ^ β⁻¹ * (1 - t) ^ β⁻¹ := by
      rw [← Real.mul_rpow hyp.le (by linarith), hxt]; ring_nf
    have e1 : ((y - x) ^ β⁻¹ + L β y ^ β⁻¹) ^ β = y * (a + (1 - t) ^ β⁻¹) ^ β := by
      rw [eLy, eyx, ← mul_add, Real.mul_rpow (by positivity)
        (by have := Real.rpow_nonneg (sub_nonneg.2 ht1) β⁻¹; positivity),
        Real.rpow_inv_rpow hyp.le hβ0.ne', add_comm]
    -- the term `L β x`
    have e2 : L β x = y * (t * (a + logb 2 t⁻¹) ^ β) := by
      rcases ht0.lt_or_eq with htp | htz
      · rw [L, hxt, mul_inv, Real.logb_mul (inv_ne_zero hyp.ne') (inv_ne_zero htp.ne'), ← ha]
        ring
      · rw [← htz] at hxt ⊢; rw [hxt]; simp [L]
    -- the right-hand side
    have e3 : 2 * L β ((x + y) / 2) = y * ((1 + t) * (a + logb 2 (2 / (1 + t))) ^ β) := by
      have hm : (x + y) / 2 = y * ((1 + t) / 2) := by rw [hxt]; ring
      rw [L, hm, mul_inv, Real.logb_mul (inv_ne_zero hyp.ne') (by positivity), ← ha,
        inv_div]
      ring
    rw [e1, e2, e3, ge_iff_le, ← mul_add]
    exact mul_le_mul_of_nonneg_left hB hyp.le
  · have hy' : y = 0 := hy0.symm
    subst hy'
    have hx0 : x = 0 := by linarith
    subst hx0
    simp [L, Real.zero_rpow (inv_ne_zero hβ0.ne'), Real.zero_rpow hβ0.ne']

/-- $L_\beta\ge0$ on $[0,1]$. -/
theorem L_nonneg_of_mem {β x : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1) : 0 ≤ L β x := by
  unfold L
  rcases hx0.lt_or_eq with hp | hz
  · have : 0 ≤ logb 2 x⁻¹ := Real.logb_nonneg (by norm_num) (one_le_inv₀ hp |>.2 hx1)
    have := Real.rpow_nonneg this β
    positivity
  · rw [← hz]; simp

/-- [BIM23], proof of Lemma 2.3: $L_\beta$ is non-decreasing on $[0,\frac12]$ for
$\beta\le\ln2$. -/
theorem L_mono_half {β : ℝ} (hβ0 : 0 < β) (hβ : β ≤ log 2) {x y : ℝ} (hx : 0 ≤ x)
    (hxy : x ≤ y) (hy : y ≤ 2⁻¹) : L β x ≤ L β y := by
  have l1 := Real.log_two_gt_d9
  rcases hx.lt_or_eq with hxp | hx0
  · set f : ℝ → ℝ := fun z ↦ -log z / log 2 with hf
    have hLf : ∀ z, L β z = z * f z ^ β := fun z ↦ by
      simp only [L, hf, Real.logb, Real.log_inv]
    have hf1 : ∀ z, 0 < z → z ≤ 2⁻¹ → 1 ≤ f z := fun z hz hz2 ↦ by
      simp only [hf]
      rw [le_div_iff₀ (by linarith), one_mul, ← Real.log_inv]
      exact Real.log_le_log (by norm_num) ((le_inv_comm₀ (by norm_num) hz).2 hz2)
    have hd : ∀ z, 0 < z → z ≤ 2⁻¹ → HasDerivAt (L β)
        (f z ^ β + z * (-(1 / z) / log 2 * β * f z ^ (β - 1))) z := by
      intro z hz hz2
      have hfz : HasDerivAt f (-(1 / z) / log 2) z := by
        have := ((Real.hasDerivAt_log hz.ne').neg).div_const (log 2)
        simpa [hf, one_div] using this
      have hr := hfz.rpow_const (p := β) (Or.inl (by linarith [hf1 z hz hz2]))
      have := (hasDerivAt_id' z).mul hr
      simp only [one_mul] at this
      refine this.congr_of_eventuallyEq ?_
      exact Filter.Eventually.of_forall fun w ↦ hLf w
    have hmono : MonotoneOn (L β) (Icc x 2⁻¹) := by
      refine monotoneOn_of_deriv_nonneg (convex_Icc x 2⁻¹) ?_ ?_ ?_
      · intro z hz
        exact (hd z (by linarith [hz.1]) hz.2).continuousAt.continuousWithinAt
      · rw [interior_Icc]; intro z hz
        exact (hd z (by linarith [hz.1]) hz.2.le).differentiableAt.differentiableWithinAt
      · rw [interior_Icc]; intro z hz
        have hz0 : 0 < z := by linarith [hz.1]
        have hfz := hf1 z hz0 hz.2.le
        rw [(hd z hz0 hz.2.le).deriv]
        have hfpos : 0 < f z := by linarith
        have e : f z ^ β = f z ^ (β - 1) * f z := by
          rw [← Real.rpow_add_one hfpos.ne']; ring_nf
        rw [e]
        have hr := Real.rpow_pos_of_pos hfpos (β - 1)
        have : β / log 2 ≤ 1 := (div_le_one (by linarith)).2 hβ
        have e2 : z * (-(1 / z) / log 2 * β * f z ^ (β - 1)) =
            -(f z ^ (β - 1) * (β / log 2)) := by field_simp
        rw [e2]
        nlinarith
    exact hmono ⟨le_rfl, hxy.trans hy⟩ ⟨hxy, hy⟩ hxy
  · rw [← hx0]
    simp only [L, zero_mul]
    exact L_nonneg_of_mem (hx0 ▸ hxy) (by linarith)

/-- [BIM23], proof of Lemma 2.3: $\psi(t)=(d^{1/\beta}+t^{1/\beta})^\beta-t$ is non-increasing
on $[0,\infty)$ for $\beta\in(0,1]$ (Minkowski's inequality in $\ell^{1/\beta}$). -/
theorem bim_psi_anti {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) {d s s' : ℝ} (hd : 0 ≤ d)
    (hs : 0 ≤ s) (hss : s ≤ s') :
    (d ^ β⁻¹ + s' ^ β⁻¹) ^ β - s' ≤ (d ^ β⁻¹ + s ^ β⁻¹) ^ β - s := by
  have hp : 1 ≤ β⁻¹ := (one_le_inv₀ hβ0).2 hβ1
  have h := Real.Lp_add_le Finset.univ ![d, s] ![0, s' - s] hp
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    one_div, inv_inv] at h
  have hp0 : β⁻¹ ≠ 0 := inv_ne_zero hβ0.ne'
  rw [add_zero, abs_zero, Real.zero_rpow hp0, zero_add, abs_of_nonneg hd, abs_of_nonneg hs,
    abs_of_nonneg (by linarith : 0 ≤ s' - s), Real.rpow_inv_rpow (by linarith) hβ0.ne',
    abs_of_nonneg (by linarith : 0 ≤ s + (s' - s)), add_sub_cancel] at h
  linarith

/-- **[BIM23], Lemma 2.3.** For $\beta\in[\frac12,\ln2]$ and $0\le a\le b\le\frac12$,
$((b-a)^{1/\beta}+L_\beta(a)^{1/\beta})^\beta+L_\beta(b)\ge2L_\beta(\frac{a+b}2)$. -/
theorem bim_lemma_2_3 (β : ℝ) (hβ : 2⁻¹ ≤ β) (hβ2 : β ≤ Real.log 2) (a b : ℝ) (ha : 0 ≤ a)
    (hab : a ≤ b) (hb : b ≤ 2⁻¹) :
    ((b - a) ^ β⁻¹ + L β a ^ β⁻¹) ^ β + L β b ≥ 2 * L β ((a + b) / 2) := by
  have l2 := Real.log_two_lt_d9
  have hβ0 : 0 < β := by linarith
  have h22 := bim_lemma_2_2 β hβ a b ha hab hb
  have hLa := L_nonneg_of_mem (β := β) ha (by linarith)
  have hmon := L_mono_half hβ0 hβ2 ha hab hb
  have hψ := bim_psi_anti hβ0 (by linarith) (sub_nonneg.2 hab) hLa hmon
  linarith

end Auto.DIR

/-!
## Auxiliary lemmas for [DIR] §4.1 Dyadic partitioning

Auxiliary material for `4_1_Dyadic_Partitioning.lean`:

* `dyadicChild`, definitionally equal to `Auto.DIR.child` of the main file, and its elementary
  properties (the $2^n$ children of a rectangle partition it);
* `IsBoxPartition`, definitionally equal to `Auto.DIR.IsRectanglePartition` of the main file;
* `DyadicGood`: success of the dyadic bisection procedure within a given number of levels, and a
  Cousin-type lemma (by bisection) showing that it holds for some number of levels if the lower
  bound is locally positive;
* a characterization of `List.mapM` in the `Option` monad.
-/

namespace Auto.DIR

open Set Filter Topology

/-- `List.mapM` in the `Option` monad succeeds with result `L` iff `f` succeeds on each entry with
the corresponding entry of `L`. -/
theorem list_mapM_option_eq_some {α β : Type*} (f : α → Option β) :
    ∀ (l : List α) (L : List β), l.mapM f = some L ↔ List.Forall₂ (fun a b ↦ f a = some b) l L
  | [], L => by cases L <;> simp
  | a :: l, L => by
    cases L with
    | nil =>
      simp only [List.mapM_cons, List.forall₂_nil_right_iff, reduceCtorEq, iff_false]
      cases f a <;> simp
      cases l.mapM f <;> simp
    | cons b L =>
      rw [List.forall₂_cons, ← list_mapM_option_eq_some f l L]
      simp only [List.mapM_cons]
      cases f a <;> simp
      cases l.mapM f <;> simp [eq_comm]

/-- If `List.mapM` in the `Option` monad succeeds with result `L`, then `f` succeeds on every entry
and `L` is the list of the results. -/
theorem list_mapM_option_eq_some_map {α β : Type*} (f : α → Option β) (d : β) {l : List α}
    {L : List β} (h : l.mapM f = some L) :
    L = l.map (fun a ↦ (f a).getD d) ∧ ∀ a ∈ l, (f a).isSome := by
  rw [list_mapM_option_eq_some] at h
  induction h with
  | nil => simp
  | cons hab _ ih => exact ⟨by simp [hab, ih.1], by simpa [hab] using ih.2⟩

/-- `List.mapM` in the `Option` monad succeeds if `f` succeeds on every entry. -/
theorem list_mapM_option_isSome {α β : Type*} (f : α → Option β) :
    ∀ (l : List α), (∀ a ∈ l, (f a).isSome) → (l.mapM f).isSome
  | [], _ => by simp
  | a :: l, h => by
    obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp (h a (by simp))
    obtain ⟨L, hL⟩ := Option.isSome_iff_exists.mp
      (list_mapM_option_isSome f l fun x hx ↦ h x (by simp [hx]))
    simp [List.mapM_cons, hb, hL]

/-- The child of $[a,b]$ indexed by $s\in\{0,1\}^n$ (same formula as `Auto.DIR.child`). -/
noncomputable def dyadicChild {n : ℕ} (a b : Fin n → ℝ) (s : Fin n → Bool) :
    (Fin n → ℝ) × (Fin n → ℝ) :=
  (fun i ↦ if s i then (a i + b i) / 2 else a i, fun i ↦ if s i then b i else (a i + b i) / 2)

/-- The coordinatewise width of a child is half the width of the parent. -/
theorem dyadicChild_width {n : ℕ} (a b : Fin n → ℝ) (s : Fin n → Bool) (i : Fin n) :
    (dyadicChild a b s).2 i - (dyadicChild a b s).1 i = (b i - a i) / 2 := by
  simp only [dyadicChild]; split_ifs <;> ring

/-- A child of $[a,b]$ lies in $[a,b]$ (lower corner). -/
theorem le_dyadicChild_fst {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) (s : Fin n → Bool) :
    a ≤ (dyadicChild a b s).1 := fun i ↦ by
  have := hab i; simp only [dyadicChild]; split_ifs <;> linarith

/-- A child of $[a,b]$ lies in $[a,b]$ (upper corner). -/
theorem dyadicChild_snd_le {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) (s : Fin n → Bool) :
    (dyadicChild a b s).2 ≤ b := fun i ↦ by
  have := hab i; simp only [dyadicChild]; split_ifs <;> linarith

/-- A child of a rectangle is a rectangle. -/
theorem dyadicChild_lt {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i) (s : Fin n → Bool)
    (i : Fin n) : (dyadicChild a b s).1 i < (dyadicChild a b s).2 i := by
  have := dyadicChild_width a b s i; have := hab i; linarith

/-- The children of $[a,b]$ cover $[a,b]$. -/
theorem iUnion_dyadicChild {n : ℕ} {a b : Fin n → ℝ} (hab : a ≤ b) :
    (⋃ s, Icc (dyadicChild a b s).1 (dyadicChild a b s).2) = Icc a b := by
  apply Subset.antisymm
  · exact iUnion_subset fun s ↦
      Icc_subset_Icc (le_dyadicChild_fst hab s) (dyadicChild_snd_le hab s)
  · intro x hx
    refine mem_iUnion.mpr ⟨fun i ↦ decide ((a i + b i) / 2 ≤ x i), fun i ↦ ?_, fun i ↦ ?_⟩ <;>
    · have h1 := hx.1 i; have h2 := hx.2 i
      by_cases h : (a i + b i) / 2 ≤ x i <;> simp [dyadicChild, h] <;> linarith

/-- Distinct children have disjoint interiors. -/
theorem disjoint_dyadicChild {n : ℕ} (a b : Fin n → ℝ) {s t : Fin n → Bool} (hst : s ≠ t) :
    Disjoint (Set.pi univ fun i ↦ Ioo ((dyadicChild a b s).1 i) ((dyadicChild a b s).2 i))
      (Set.pi univ fun i ↦ Ioo ((dyadicChild a b t).1 i) ((dyadicChild a b t).2 i)) := by
  obtain ⟨i, hi⟩ : ∃ i, s i ≠ t i := Function.ne_iff.mp hst
  rw [Set.disjoint_left]
  intro z hz hz'
  have h1 := hz i (mem_univ _); have h2 := hz' i (mem_univ _)
  simp only [dyadicChild, mem_Ioo] at h1 h2
  cases hs : s i <;> cases ht : t i <;> simp_all <;> linarith

/-- A finite partition of $[a,b]$ into rectangles (same formula as
`Auto.DIR.IsRectanglePartition`). -/
def IsBoxPartition {n : ℕ} (a b : Fin n → ℝ) (P : Finset ((Fin n → ℝ) × (Fin n → ℝ))) : Prop :=
  (∀ p ∈ P, (∀ i, p.1 i < p.2 i) ∧ a ≤ p.1 ∧ p.2 ≤ b) ∧ (⋃ p ∈ P, Icc p.1 p.2) = Icc a b ∧
    (P : Set ((Fin n → ℝ) × (Fin n → ℝ))).PairwiseDisjoint
      (fun p ↦ Set.pi univ fun i ↦ Ioo (p.1 i) (p.2 i))

/-- A rectangle is partitioned by itself. -/
theorem isBoxPartition_singleton {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i) :
    IsBoxPartition a b {(a, b)} := by
  refine ⟨?_, by simp, by simp⟩
  intro p hp
  rw [Finset.mem_singleton] at hp
  subst hp
  exact ⟨hab, le_rfl, le_rfl⟩

/-- Partitions of the children of a rectangle combine to a partition of the rectangle. -/
theorem isBoxPartition_biUnion {n : ℕ} {a b : Fin n → ℝ} (hab : ∀ i, a i < b i)
    (Q : (Fin n → Bool) → Finset ((Fin n → ℝ) × (Fin n → ℝ)))
    (hQ : ∀ s, IsBoxPartition (dyadicChild a b s).1 (dyadicChild a b s).2 (Q s)) :
    IsBoxPartition a b (Finset.univ.biUnion Q) := by
  have hab' : a ≤ b := fun i ↦ (hab i).le
  refine ⟨?_, ?_, ?_⟩
  · intro p hp
    obtain ⟨s, -, hs⟩ := Finset.mem_biUnion.mp hp
    obtain ⟨h1, h2, h3⟩ := (hQ s).1 p hs
    exact ⟨h1, (le_dyadicChild_fst hab' s).trans h2, h3.trans (dyadicChild_snd_le hab' s)⟩
  · rw [← iUnion_dyadicChild hab']
    ext x
    simp only [mem_iUnion, Finset.mem_biUnion, Finset.mem_univ, true_and, exists_prop]
    constructor
    · rintro ⟨p, ⟨s, hs⟩, hx⟩
      refine ⟨s, ?_⟩
      rw [← (hQ s).2.1]
      exact mem_biUnion hs hx
    · rintro ⟨s, hx⟩
      rw [← (hQ s).2.1] at hx
      obtain ⟨p, hp, hx⟩ := mem_iUnion₂.mp hx
      exact ⟨p, ⟨s, hp⟩, hx⟩
  · intro p hp q hq hpq
    simp only [Finset.coe_biUnion, Finset.coe_univ, mem_univ, iUnion_true, mem_iUnion,
      Finset.mem_coe] at hp hq
    obtain ⟨s, hs⟩ := hp
    obtain ⟨t, ht⟩ := hq
    by_cases hst : s = t
    · subst hst
      exact (hQ s).2.2 hs ht hpq
    · refine (disjoint_dyadicChild a b hst).mono ?_ ?_
      · obtain ⟨-, h2, h3⟩ := (hQ s).1 p hs
        exact Set.pi_mono fun i _ ↦ Ioo_subset_Ioo (h2 i) (h3 i)
      · obtain ⟨-, h2, h3⟩ := (hQ t).1 q ht
        exact Set.pi_mono fun i _ ↦ Ioo_subset_Ioo (h2 i) (h3 i)

/-- Success of dyadic bisection within `K` levels: either $\underline f(a,b)>0$, or `K > 0` and
every child succeeds within `K - 1` levels. -/
def DyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) :
    ℕ → (Fin n → ℝ) → (Fin n → ℝ) → Prop
  | 0, a, b => 0 < fl a b
  | K + 1, a, b => 0 < fl a b ∨ ∀ s, DyadicGood fl K (dyadicChild a b s).1 (dyadicChild a b s).2

/-- `DyadicGood` is monotone in the number of levels (one step). -/
theorem DyadicGood.succ {n : ℕ} {fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ} :
    ∀ {K : ℕ} {a b : Fin n → ℝ}, DyadicGood fl K a b → DyadicGood fl (K + 1) a b
  | 0, _, _, h => Or.inl h
  | _ + 1, _, _, h => h.imp_right fun h' s ↦ DyadicGood.succ (h' s)

/-- `DyadicGood` is monotone in the number of levels. -/
theorem DyadicGood.mono {n : ℕ} {fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ} {K L : ℕ} (hKL : K ≤ L)
    {a b : Fin n → ℝ} (h : DyadicGood fl K a b) : DyadicGood fl L a b := by
  induction hKL with
  | refl => exact h
  | step _ ih => exact ih.succ

/-- If bisection does not succeed for any number of levels, then the same holds for some
child. -/
theorem exists_dyadicChild_not_good {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    {a b : Fin n → ℝ} (h : ∀ K, ¬ DyadicGood fl K a b) :
    ∃ s, ∀ K, ¬ DyadicGood fl K (dyadicChild a b s).1 (dyadicChild a b s).2 := by
  by_contra hc
  push Not at hc
  choose K hK using hc
  exact h (Finset.univ.sup K + 1)
    (Or.inr fun s ↦ (hK s).mono (Finset.le_sup (Finset.mem_univ s)))

/-- Cousin-type lemma (by bisection): if $\underline f(\underline x,\overline x)>0$ for all small
boxes around each point of $[a,b]$, then bisection of $[a,b]$ succeeds within finitely many
levels. -/
theorem exists_dyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) {a b : Fin n → ℝ}
    (hab : a ≤ b)
    (H : ∀ x ∈ Icc a b, ∃ εx > 0, ∀ xl xu, a ≤ xl → xu ≤ b → x ∈ Icc xl xu →
      dist xl xu ≤ εx → 0 < fl xl xu) :
    ∃ K, DyadicGood fl K a b := by
  by_contra hc
  push Not at hc
  let Bad := {p : (Fin n → ℝ) × (Fin n → ℝ) // ∀ K, ¬ DyadicGood fl K p.1 p.2}
  have step : ∀ p : Bad, ∃ s, ∀ K, ¬ DyadicGood fl K (dyadicChild p.1.1 p.1.2 s).1
      (dyadicChild p.1.1 p.1.2 s).2 := fun p ↦ exists_dyadicChild_not_good fl p.2
  choose g hg using step
  let seq : ℕ → Bad := fun k ↦ Nat.rec ⟨(a, b), hc⟩
    (fun _ p ↦ ⟨dyadicChild p.1.1 p.1.2 (g p), hg p⟩) k
  have seq_zero : (seq 0).1 = (a, b) := rfl
  have seq_succ : ∀ k, (seq (k + 1)).1 = dyadicChild (seq k).1.1 (seq k).1.2 (g (seq k)) :=
    fun _ ↦ rfl
  set lo : ℕ → Fin n → ℝ := fun k ↦ (seq k).1.1 with hlo
  set hi : ℕ → Fin n → ℝ := fun k ↦ (seq k).1.2 with hhi
  have width : ∀ k i, hi k i - lo k i = (b i - a i) / 2 ^ k := by
    intro k i
    induction k with
    | zero => simp [hlo, hhi, seq_zero]
    | succ k ih =>
      simp only [hlo, hhi, seq_succ, dyadicChild_width] at ih ⊢
      rw [ih, pow_succ]; ring
  have lohi : ∀ k, lo k ≤ hi k := fun k i ↦ by
    have := width k i; have := hab i
    have : 0 ≤ (b i - a i) / 2 ^ k := div_nonneg (by linarith) (by positivity)
    linarith
  have lo_mono : Monotone lo := monotone_nat_of_le_succ fun k ↦ by
    simp only [hlo, seq_succ]; exact le_dyadicChild_fst (lohi k) _
  have hi_anti : Antitone hi := antitone_nat_of_succ_le fun k ↦ by
    simp only [hhi, seq_succ]; exact dyadicChild_snd_le (lohi k) _
  have lo_le_hi : ∀ k m, lo k ≤ hi m := fun k m ↦
    (lo_mono (le_max_left k m)).trans ((lohi _).trans (hi_anti (le_max_right k m)))
  let x : Fin n → ℝ := fun i ↦ ⨆ k, lo k i
  have hbdd : ∀ i, BddAbove (range fun k ↦ lo k i) :=
    fun i ↦ ⟨hi 0 i, by rintro _ ⟨k, rfl⟩; exact lo_le_hi k 0 i⟩
  have hx : ∀ k, x ∈ Icc (lo k) (hi k) := fun k ↦
    ⟨fun i ↦ le_ciSup (hbdd i) k, fun i ↦ ciSup_le fun m ↦ lo_le_hi m k i⟩
  have ha : lo 0 = a := rfl
  have hb : hi 0 = b := rfl
  obtain ⟨ε, hε, hH⟩ := H x (by rw [← ha, ← hb]; exact hx 0)
  set D : ℝ := ∑ i, (b i - a i) with hD
  obtain ⟨N, hN⟩ := exists_nat_gt (D / ε)
  have h2N : (N : ℝ) < 2 ^ N := by exact_mod_cast Nat.lt_two_pow_self
  refine (seq N).2 0 (hH (lo N) (hi N) (ha ▸ lo_mono (Nat.zero_le N))
    (hb ▸ hi_anti (Nat.zero_le N)) (hx N) ((dist_pi_le_iff hε.le).mpr fun i ↦ ?_))
  rw [Real.dist_eq, abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr (lohi N i)), width]
  have hDi : b i - a i ≤ D :=
    Finset.single_le_sum (f := fun i ↦ b i - a i) (fun j _ ↦ sub_nonneg.mpr (hab j))
      (Finset.mem_univ i)
  rw [div_le_iff₀ (by positivity)]
  have : D < ε * 2 ^ N := by
    rw [div_lt_iff₀ hε] at hN; nlinarith
  linarith

/-- Successful bisection within `K` levels yields an admissible partition. -/
theorem exists_isBoxPartition_of_dyadicGood {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) :
    ∀ (K : ℕ) {a b : Fin n → ℝ}, (∀ i, a i < b i) → DyadicGood fl K a b →
      ∃ P, IsBoxPartition a b P ∧ ∀ p ∈ P, 0 < fl p.1 p.2
  | 0, a, b, hab, h => ⟨{(a, b)}, isBoxPartition_singleton hab, by
    rintro p hp; rw [Finset.mem_singleton.mp hp]; exact h⟩
  | K + 1, a, b, hab, h => by
    rcases h with h | h
    · exact ⟨{(a, b)}, isBoxPartition_singleton hab, by
    rintro p hp; rw [Finset.mem_singleton.mp hp]; exact h⟩
    · have := fun s ↦ exists_isBoxPartition_of_dyadicGood fl K (dyadicChild_lt hab s) (h s)
      choose Q hQ hQpos using this
      refine ⟨Finset.univ.biUnion Q, isBoxPartition_biUnion hab Q hQ, fun p hp ↦ ?_⟩
      obtain ⟨s, -, hs⟩ := Finset.mem_biUnion.mp hp
      exact hQpos s p hs

/-- The list of the $2^n$ children of $[a,b]$ (same formula as `Auto.DIR.children`). -/
noncomputable def dyadicChildren {n : ℕ} (a b : Fin n → ℝ) : List ((Fin n → ℝ) × (Fin n → ℝ)) :=
  (Finset.univ : Finset (Fin n → Bool)).toList.map (dyadicChild a b)

/-- The members of the list of children of $[a,b]$. -/
theorem mem_dyadicChildren {n : ℕ} {a b : Fin n → ℝ} {c : (Fin n → ℝ) × (Fin n → ℝ)} :
    c ∈ dyadicChildren a b ↔ ∃ s, dyadicChild a b s = c := by
  simp [dyadicChildren]

/-- Let `F` satisfy the recursion of $\textsc{Partition}_n$ (`Auto.DIR.partitionN fl maxDepth`).
If `F a b depth` (with `maxDepth - depth ≤ k`) succeeds on a rectangle, then its result is a
partition of $[a,b]$ into rectangles $[c,d]$ with $\underline f(c,d)>0$. -/
theorem partitionN_spec_aux {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ) (maxDepth : ℕ)
    (F : (Fin n → ℝ) → (Fin n → ℝ) → ℕ → Option (List ((Fin n → ℝ) × (Fin n → ℝ))))
    (hF : ∀ a b depth, F a b depth = if 0 < fl a b then some [(a, b)]
      else if maxDepth ≤ depth then none
      else ((dyadicChildren a b).attach.mapM fun c ↦ F c.1.1 c.1.2 (depth + 1)).map
        List.flatten) :
    ∀ (k depth : ℕ) (a b : Fin n → ℝ) (P : List ((Fin n → ℝ) × (Fin n → ℝ))),
      maxDepth - depth ≤ k → (∀ i, a i < b i) → F a b depth = some P →
      IsBoxPartition a b P.toFinset ∧ ∀ p ∈ P, 0 < fl p.1 p.2 := by
  intro k
  induction k with
  | zero =>
    intro depth a b P hk hab h
    rw [hF] at h
    split_ifs at h with h1 h2
    · cases h
      exact ⟨by simpa using isBoxPartition_singleton hab, by simpa using h1⟩
    · omega
  | succ k ih =>
    intro depth a b P hk hab h
    rw [hF] at h
    split_ifs at h with h1 h2
    · cases h
      exact ⟨by simpa using isBoxPartition_singleton hab, by simpa using h1⟩
    · obtain ⟨Ls, hLs, rfl⟩ := Option.map_eq_some_iff.mp h
      obtain ⟨rfl, hsome⟩ := list_mapM_option_eq_some_map _ [] hLs
      set g : (Fin n → ℝ) × (Fin n → ℝ) → Option (List ((Fin n → ℝ) × (Fin n → ℝ))) :=
        fun c ↦ F c.1 c.2 (depth + 1) with hg
      have hchild : ∀ s, g (dyadicChild a b s) = some ((g (dyadicChild a b s)).getD []) :=
        fun s ↦ by
          have := hsome ⟨dyadicChild a b s, mem_dyadicChildren.mpr ⟨s, rfl⟩⟩ (List.mem_attach _ _)
          have this' : (F (dyadicChild a b s).1 (dyadicChild a b s).2
              (depth + 1)).isSome := this
          obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp this'
          simp [hg, hv]
      have hrec := fun s ↦ ih (depth + 1) _ _ _ (by omega)
        (dyadicChild_lt hab s) (hchild s)
      have hmem : ∀ p, p ∈ ((dyadicChildren a b).attach.map
          (fun c ↦ (F c.1.1 c.1.2 (depth + 1)).getD [])).flatten ↔
          ∃ s, p ∈ (g (dyadicChild a b s)).getD [] := by
        intro p
        simp only [List.mem_flatten, List.mem_map, List.mem_attach, true_and, Subtype.exists]
        constructor
        · rintro ⟨_, ⟨c, hc, rfl⟩, hp⟩
          obtain ⟨s, rfl⟩ := mem_dyadicChildren.mp hc
          exact ⟨s, hp⟩
        · rintro ⟨s, hp⟩
          exact ⟨_, ⟨dyadicChild a b s, mem_dyadicChildren.mpr ⟨s, rfl⟩, rfl⟩, hp⟩
      have hset : ((dyadicChildren a b).attach.map
          (fun c ↦ (F c.1.1 c.1.2 (depth + 1)).getD [])).flatten.toFinset =
          Finset.univ.biUnion fun s ↦ ((g (dyadicChild a b s)).getD []).toFinset := by
        ext p
        simp only [List.mem_toFinset, hmem, Finset.mem_biUnion, Finset.mem_univ, true_and]
      refine ⟨?_, fun p hp ↦ ?_⟩
      · rw [hset]
        exact isBoxPartition_biUnion hab _ fun s ↦ (hrec s).1
      · obtain ⟨s, hs⟩ := (hmem p).mp hp
        exact (hrec s).2 p hs

/-- Let `F` satisfy the recursion of $\textsc{Partition}_n$ (`Auto.DIR.partitionN fl maxDepth`).
If dyadic bisection succeeds within `K` levels and `K ≤ maxDepth - depth`, then `F a b depth`
succeeds. -/
theorem partitionN_isSome_of_dyadicGood_aux {n : ℕ} (fl : (Fin n → ℝ) → (Fin n → ℝ) → ℝ)
    (maxDepth : ℕ)
    (F : (Fin n → ℝ) → (Fin n → ℝ) → ℕ → Option (List ((Fin n → ℝ) × (Fin n → ℝ))))
    (hF : ∀ a b depth, F a b depth = if 0 < fl a b then some [(a, b)]
      else if maxDepth ≤ depth then none
      else ((dyadicChildren a b).attach.mapM fun c ↦ F c.1.1 c.1.2 (depth + 1)).map
        List.flatten) :
    ∀ (K depth : ℕ) (a b : Fin n → ℝ), DyadicGood fl K a b → K ≤ maxDepth - depth →
      (F a b depth).isSome := by
  intro K
  induction K with
  | zero =>
    intro depth a b h _
    rw [hF]
    simp [show 0 < fl a b from h]
  | succ K ih =>
    intro depth a b h hK
    by_cases h1 : 0 < fl a b
    · rw [hF]
      simp [h1]
    · rw [hF, ite_eq_right h1, ite_eq_right (by omega), Option.isSome_map]
      refine list_mapM_option_isSome _ _ fun c _ ↦ ?_
      obtain ⟨s, hs⟩ := mem_dyadicChildren.mp c.2
      rw [← hs]
      exact ih (depth + 1) _ _ ((h.resolve_left h1) s) (by omega)

end Auto.DIR

/-!
## Auxiliary lemmas for [DIR] §4.2 Interval arithmetic

Auxiliary material for `4_2_Interval_Arithmetic.lean`: the product of two numbers in intervals
$[a,b]$, $[c,d]$ lies between the minimum and the maximum of the four products of endpoints.
-/

namespace Auto.DIR

open Set

/-- If $u\in[a,b]$, then $uv$ lies between $av$ and $bv$. -/
theorem mul_mem_minmax_left {a b u v : ℝ} (hu : u ∈ Icc a b) :
    min (a * v) (b * v) ≤ u * v ∧ u * v ≤ max (a * v) (b * v) := by
  rcases le_total 0 v with h | h
  · exact ⟨(min_le_left _ _).trans (mul_le_mul_of_nonneg_right hu.1 h),
      (mul_le_mul_of_nonneg_right hu.2 h).trans (le_max_right _ _)⟩
  · exact ⟨(min_le_right _ _).trans (mul_le_mul_of_nonpos_right hu.2 h),
      (mul_le_mul_of_nonpos_right hu.1 h).trans (le_max_left _ _)⟩

/-- If $u\in[a,b]$ and $v\in[c,d]$, then $uv$ lies between the minimum and the maximum of
$ac,ad,bc,bd$. -/
theorem mul_mem_minmax {a b c d u v : ℝ} (hu : u ∈ Icc a b) (hv : v ∈ Icc c d) :
    min (min (a * c) (a * d)) (min (b * c) (b * d)) ≤ u * v ∧
      u * v ≤ max (max (a * c) (a * d)) (max (b * c) (b * d)) := by
  have h1 := mul_mem_minmax_left (v := v) hu
  have h2 := mul_mem_minmax_left (v := a) hv
  have h3 := mul_mem_minmax_left (v := b) hv
  simp only [mul_comm _ a, mul_comm _ b] at h2 h3
  exact ⟨(min_le_min h2.1 h3.1).trans h1.1, h1.2.trans (max_le_max h2.2 h3.2)⟩

end Auto.DIR

/-!
## [DIR] §5.2 Two-point inequalities: auxiliary lemmas

Auxiliary results for the proofs in `5_2_Two_Point_Inequalities.lean`: Taylor's theorem with
Lagrange remainder of order two for $a\mapsto(1+a)^\beta$ (used for Lemma 5.4 of [DIR]).
-/

namespace Auto.DIR

open Real Set

/-- Taylor's theorem with Lagrange remainder for $(1+a)^\beta$ at $0$ (any real $\beta$, $a\ge0$):
$(1+a)^\beta=1+\beta a-\frac12\beta(1-\beta)(1+\tilde a)^{\beta-2}a^2$ for some
$\tilde a\in[0,a]$. Proved by applying Rolle's theorem twice to
$t\mapsto(1+t)^\beta-1-\beta t-Kt^2$, with $K$ chosen so that this vanishes at $t=a$. -/
theorem one_add_rpow_taylor (β : ℝ) (a : ℝ) (ha : 0 ≤ a) :
    ∃ ã ∈ Icc 0 a, (1 + a) ^ β = 1 + β * a - 2⁻¹ * β * (1 - β) * (1 + ã) ^ (β - 2) * a ^ 2 := by
  rcases ha.eq_or_lt with rfl | ha
  · exact ⟨0, ⟨le_rfl, le_rfl⟩, by simp⟩
  set K : ℝ := ((1 + a) ^ β - 1 - β * a) / a ^ 2 with hK
  have hd1 : ∀ t : ℝ, -1 < t → HasDerivAt (fun t : ℝ => (1 + t) ^ β - 1 - β * t - K * t ^ 2)
      (β * (1 + t) ^ (β - 1) - β - K * (2 * t)) t := by
    intro t ht
    have h1 : HasDerivAt (fun t : ℝ => (1 + t) ^ β) (1 * β * (1 + t) ^ (β - 1)) t :=
      ((hasDerivAt_id' t).const_add 1).rpow_const (Or.inl (by linarith))
    have h2 := (hasDerivAt_pow 2 t).const_mul K
    have h3 := (hasDerivAt_id' t).const_mul β
    convert ((h1.sub_const 1).sub h3).sub h2 using 1
    simp
  have hd2 : ∀ t : ℝ, -1 < t → HasDerivAt (fun t : ℝ => β * (1 + t) ^ (β - 1) - β - K * (2 * t))
      (β * (β - 1) * (1 + t) ^ (β - 2) - 2 * K) t := by
    intro t ht
    have h1 : HasDerivAt (fun t : ℝ => (1 + t) ^ (β - 1))
        (1 * (β - 1) * (1 + t) ^ (β - 1 - 1)) t :=
      ((hasDerivAt_id' t).const_add 1).rpow_const (Or.inl (by linarith))
    have h3 := ((hasDerivAt_id' t).const_mul 2).const_mul K
    convert ((h1.const_mul β).sub_const β).sub h3 using 1
    rw [show β - 1 - 1 = β - 2 by ring]; ring
  obtain ⟨ξ, hξ, hξ0⟩ := exists_hasDerivAt_eq_zero ha
    (fun t ht => (hd1 t (by linarith [ht.1])).continuousAt.continuousWithinAt)
    (by simp only [hK]; field_simp; simp) (fun t ht => hd1 t (by linarith [ht.1]))
  obtain ⟨η, hη, hη0⟩ := exists_hasDerivAt_eq_zero hξ.1
    (fun t ht => (hd2 t (by linarith [ht.1])).continuousAt.continuousWithinAt)
    (by simp; linarith) (fun t ht => hd2 t (by linarith [ht.1]))
  refine ⟨η, ⟨hη.1.le, (hη.2.trans hξ.2).le⟩, ?_⟩
  have hK' : (1 + a) ^ β = 1 + β * a + K * a ^ 2 := by
    simp only [hK]; field_simp; ring
  rw [hK']
  have : K = 2⁻¹ * β * (β - 1) * (1 + η) ^ (β - 2) := by linarith
  rw [this]; ring

end Auto.DIR

/-!
## [DIR] §5.3 Properties of $L_\beta$ and $Q_\beta$: auxiliary lemmas

Auxiliary lemmas for `5_3_Properties_L_Q.lean`: explicit formulas for the derivatives
$L_\beta',\dots,L_\beta^{(4)}$ on $(0,1)$ (the functions `L1f`, …, `L4f`), continuity of
$L_\beta$ on $[0,1]$, and the elementary calculus of the cubic $Q_\beta$.

## Notation introduced here

* `L1f β x`, `L2f β x`, `L3f β x`, `L4f β x` : the explicit right-hand sides of (5.2), (5.3),
  (5.4) and of the formula for $L^{(4)}_\beta$ in the proof of Lemma 5.6 (4).
-/

namespace Auto.DIR

open Real Set Filter Topology

/-- The right-hand side of (5.2):
$(\log2)^{-\beta}(\log\frac1x)^{-1+\beta}(-\beta+\log\frac1x)$. -/
noncomputable def L1f (β x : ℝ) : ℝ :=
  (log 2) ^ (-β) * (log x⁻¹) ^ (-1 + β) * (-β + log x⁻¹)

/-- The right-hand side of (5.3):
$-\beta(\log2)^{-\beta}x^{-1}(\log\frac1x)^{-2+\beta}(1-\beta+\log\frac1x)$. -/
noncomputable def L2f (β x : ℝ) : ℝ :=
  -β * (log 2) ^ (-β) * x⁻¹ * (log x⁻¹) ^ (-2 + β) * (1 - β + log x⁻¹)

/-- The right-hand side of (5.4):
$\beta(\log2)^{-\beta}x^{-2}(\log\frac1x)^{-3+\beta}(\beta(3-\beta)-2+(\log\frac1x)^2)$. -/
noncomputable def L3f (β x : ℝ) : ℝ :=
  β * (log 2) ^ (-β) * x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 + β) *
    (β * (3 - β) - 2 + (log x⁻¹) ^ 2)

/-- The formula for $L^{(4)}_\beta(x)$ of the proof of Lemma 5.6 (4):
$x^{-3}\beta(\log2)^{-\beta}(\log\frac1x)^{\beta-4}f_\beta(x)$. -/
noncomputable def L4f (β x : ℝ) : ℝ :=
  x ^ (-3 : ℤ) * β * (log 2) ^ (-β) * (log x⁻¹) ^ (β - 4) *
    (-(3 - β) * (2 - β) * (1 - β) + (1 - β - 2 * log x⁻¹) * (log x⁻¹) ^ 2 +
      2 * (2 - β) * (1 - β) * log x⁻¹)

/-- The derivative of $x\mapsto\log\frac1x$ is $-x^{-1}$ (for $x\ne0$). -/
theorem hasDerivAt_log_inv' {x : ℝ} (hx : x ≠ 0) :
    HasDerivAt (fun x ↦ log x⁻¹) (-x⁻¹) x := by
  have : (fun x : ℝ ↦ log x⁻¹) = fun x ↦ -log x := funext fun x ↦ log_inv x
  rw [this]
  exact (hasDerivAt_log hx).neg

/-- Splitting a real power with exponent $\beta+n$, $n\in\mathbb Z$, for a positive base. -/
theorem rpow_eq_rpow_mul_zpow {u : ℝ} (hu : 0 < u) (e β : ℝ) (n : ℤ) (h : e = β + n) :
    u ^ e = u ^ β * u ^ n := by
  rw [h, rpow_add hu, rpow_intCast]

/-- On $(0,1)$, $L_\beta(x)=(\log2)^{-\beta}x(\log\frac1x)^\beta$. -/
theorem L_eq_of_mem {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    L β x = (log 2) ^ (-β) * (x * (log x⁻¹) ^ β) := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L, logb, div_rpow hu.le hl.le, rpow_neg hl.le]
  ring

/-- $L_\beta'=$ `L1f` on $(0,1)$. -/
theorem hasDerivAt_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) : HasDerivAt (L β) (L1f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have h := (((hasDerivAt_id' x).mul ((hasDerivAt_log_inv' hx.1.ne').rpow_const
    (p := β) (Or.inl hu.ne'))).const_mul ((log 2) ^ (-β)))
  have heq : (fun y ↦ (log 2) ^ (-β) * (y * (log y⁻¹) ^ β)) =ᶠ[𝓝 x] L β := by
    filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy
    exact (L_eq_of_mem hy).symm
  refine (h.congr_of_eventuallyEq heq.symm).congr_deriv ?_
  rw [L1f, rpow_eq_rpow_mul_zpow hu (-1 + β) β (-1) (by push_cast; ring),
    rpow_eq_rpow_mul_zpow hu (β - 1) β (-1) (by push_cast; ring)]
  have hx0 : x ≠ 0 := hx.1.ne'
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_one]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- Splitting a real power with exponent $\beta-n$, $n\in\mathbb N$, for a positive base. -/
theorem rpow_eq_rpow_div_pow {u : ℝ} (hu : 0 < u) (e β : ℝ) (n : ℕ) (h : e = β - n) :
    u ^ e = u ^ β / u ^ n := by
  rw [h, rpow_sub hu, rpow_natCast]

/-- `L1f` has derivative `L2f` on $(0,1)$. -/
theorem hasDerivAt_L1f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L1f β) (L2f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hd := hasDerivAt_log_inv' hx.1.ne'
  have h := ((hd.rpow_const (p := -1 + β) (Or.inl hu.ne')).const_mul ((log 2) ^ (-β))).mul
    (hd.const_add (-β))
  refine h.congr_deriv ?_
  rw [L2f, rpow_eq_rpow_div_pow hu (-1 + β - 1) β 2 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-1 + β) β 1 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-2 + β) β 2 (by push_cast; ring)]
  have hx0 : x ≠ 0 := hx.1.ne'
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- `L2f` has derivative `L3f` on $(0,1)$. -/
theorem hasDerivAt_L2f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L2f β) (L3f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hx0 : x ≠ 0 := hx.1.ne'
  have hd := hasDerivAt_log_inv' hx0
  have h := ((((hasDerivAt_inv hx0).const_mul (-β * (log 2) ^ (-β))).mul
    (hd.rpow_const (p := -2 + β) (Or.inl hu.ne'))).mul (hd.const_add (1 - β)))
  have hf : L2f β = fun y ↦ -β * (log 2) ^ (-β) * y⁻¹ * (log y⁻¹) ^ (-2 + β) *
      (1 - β + log y⁻¹) := rfl
  rw [hf]
  refine h.congr_deriv ?_
  simp only [Pi.mul_apply]
  rw [L3f, rpow_eq_rpow_div_pow hu (-2 + β - 1) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-3 + β) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-2 + β) β 2 (by push_cast; ring)]
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_ofNat]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- `L3f` has derivative `L4f` on $(0,1)$. -/
theorem hasDerivAt_L3f {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (L3f β) (L4f β x) x := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hx0 : x ≠ 0 := hx.1.ne'
  have hd := hasDerivAt_log_inv' hx0
  have h := (((((hasDerivAt_pow 2 x).inv (pow_ne_zero 2 hx0)).const_mul
    (β * (log 2) ^ (-β))).mul (hd.rpow_const (p := -3 + β) (Or.inl hu.ne'))).mul
    ((hd.pow 2).const_add (β * (3 - β) - 2)))
  have hf : L3f β = fun y ↦ β * (log 2) ^ (-β) * (y ^ 2)⁻¹ * (log y⁻¹) ^ (-3 + β) *
      (β * (3 - β) - 2 + (log y⁻¹) ^ 2) := by
    funext y; simp only [L3f, zpow_neg, zpow_ofNat]
  rw [hf]
  refine h.congr_deriv ?_
  simp only [Pi.mul_apply, Pi.pow_apply, Pi.inv_apply]
  rw [L4f, rpow_eq_rpow_div_pow hu (-3 + β - 1) β 4 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (-3 + β) β 3 (by push_cast; ring),
    rpow_eq_rpow_div_pow hu (β - 4) β 4 (by push_cast; ring)]
  have hu0 : log x⁻¹ ≠ 0 := hu.ne'
  simp only [zpow_neg, zpow_ofNat]
  generalize log x⁻¹ = u at hu0 ⊢
  field_simp
  ring

/-- $L_\beta'(x)$ is given by (5.2) on $(0,1)$. -/
theorem deriv_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) : deriv (L β) x = L1f β x :=
  (hasDerivAt_L hx).deriv

/-- `deriv (L β)` agrees with `L1f β` near any point of $(0,1)$. -/
theorem deriv_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (L β) =ᶠ[𝓝 x] L1f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv_L_eq hy

/-- $L_\beta''$ has the form (5.3) on $(0,1)$ (as a derivative of $L_\beta'$). -/
theorem hasDerivAt_deriv_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (L β)) (L2f β x) x :=
  (hasDerivAt_L1f hx).congr_of_eventuallyEq (deriv_L_eventuallyEq hx)

/-- $L_\beta''(x)$ is given by (5.3) on $(0,1)$. -/
theorem deriv2_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (L β)) x = L2f β x :=
  (hasDerivAt_deriv_L hx).deriv

/-- `deriv (deriv (L β))` agrees with `L2f β` near any point of $(0,1)$. -/
theorem deriv2_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (L β)) =ᶠ[𝓝 x] L2f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv2_L_eq hy

/-- $L_\beta'''$ has the form (5.4) on $(0,1)$ (as a derivative of $L_\beta''$). -/
theorem hasDerivAt_deriv2_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (deriv (L β))) (L3f β x) x :=
  (hasDerivAt_L2f hx).congr_of_eventuallyEq (deriv2_L_eventuallyEq hx)

/-- $L_\beta'''(x)$ is given by (5.4) on $(0,1)$. -/
theorem deriv3_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (L β))) x = L3f β x :=
  (hasDerivAt_deriv2_L hx).deriv

/-- `deriv (deriv (deriv (L β)))` agrees with `L3f β` near any point of $(0,1)$. -/
theorem deriv3_L_eventuallyEq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (L β))) =ᶠ[𝓝 x] L3f β := by
  filter_upwards [Ioo_mem_nhds hx.1 hx.2] with y hy using deriv3_L_eq hy

/-- $L_\beta^{(4)}$ is `L4f` on $(0,1)$ (as a derivative of $L_\beta'''$). -/
theorem hasDerivAt_deriv3_L {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    HasDerivAt (deriv (deriv (deriv (L β)))) (L4f β x) x :=
  (hasDerivAt_L3f hx).congr_of_eventuallyEq (deriv3_L_eventuallyEq hx)

/-- $L_\beta^{(4)}(x)$ is given by `L4f` on $(0,1)$. -/
theorem deriv4_L_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    deriv (deriv (deriv (deriv (L β)))) x = L4f β x :=
  (hasDerivAt_deriv3_L hx).deriv

/-- $L_\beta$ is continuous at every $x\ne0$ (for $\beta>0$). -/
theorem continuousAt_L {β x : ℝ} (hβ : 0 < β) (hx : x ≠ 0) : ContinuousAt (L β) x := by
  have h1 : ContinuousAt (fun y : ℝ ↦ log y⁻¹ / log 2) x :=
    (((continuousAt_inv₀ hx).log (inv_ne_zero hx))).div_const _
  exact continuousAt_id.mul (h1.rpow_const (Or.inr hβ.le))

/-- $L_\beta\ge0$ on $[0,1]$. -/
theorem L_nonneg {β x : ℝ} (hx : x ∈ Icc (0 : ℝ) 1) : 0 ≤ L β x := by
  rcases eq_or_lt_of_le hx.1 with h0 | hpos
  · simp [L, ← h0]
  · refine mul_nonneg hx.1 (rpow_nonneg ?_ _)
    exact logb_nonneg one_lt_two ((one_le_inv₀ hpos).2 hx.2)

/-- $L_\beta(0)=0$. -/
theorem L_zero (β : ℝ) : L β 0 = 0 := by simp [L]

/-- $L_\beta$ is continuous on $[0,1]$ for $0<\beta\le1$. -/
theorem continuousOn_L {β : ℝ} (hβ0 : 0 < β) (hβ1 : β ≤ 1) :
    ContinuousOn (L β) (Icc 0 1) := by
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h0 | hpos
  · subst h0
    have hl : 0 < log 2 := log_pos one_lt_two
    have hg : Tendsto (fun y ↦ y - y * log y / log 2) (𝓝[Icc 0 1] 0) (𝓝 0) := by
      have hc : Continuous (fun y ↦ y - y * log y / log 2) :=
        continuous_id.sub (continuous_mul_log.div_const _)
      simpa using (hc.tendsto 0).mono_left nhdsWithin_le_nhds
    show Tendsto (L β) (𝓝[Icc 0 1] 0) (𝓝 (L β 0))
    rw [L_zero]
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hg ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with y hy using L_nonneg hy
    · filter_upwards [self_mem_nhdsWithin] with y hy
      rcases eq_or_lt_of_le hy.1 with h0 | hypos
      · simp [L, ← h0]
      have hv : 0 ≤ log y⁻¹ / log 2 :=
        div_nonneg (log_nonneg ((one_le_inv₀ hypos).2 hy.2)) hl.le
      have hb : (log y⁻¹ / log 2) ^ β ≤ 1 + log y⁻¹ / log 2 := by
        rcases le_or_gt 1 (log y⁻¹ / log 2) with h1 | h1
        · calc (log y⁻¹ / log 2) ^ β ≤ (log y⁻¹ / log 2) ^ (1 : ℝ) :=
                rpow_le_rpow_of_exponent_le h1 hβ1
            _ ≤ 1 + log y⁻¹ / log 2 := by rw [rpow_one]; linarith
        · linarith [rpow_le_one hv h1.le hβ0.le]
      have hLy : L β y = y * (log y⁻¹ / log 2) ^ β := rfl
      rw [hLy]
      calc y * (log y⁻¹ / log 2) ^ β ≤ y * (1 + log y⁻¹ / log 2) :=
            mul_le_mul_of_nonneg_left hb hy.1
        _ = y - y * log y / log 2 := by rw [log_inv]; ring
  · exact (continuousAt_L hβ0 hpos.ne').continuousWithinAt

/-- The right-hand side of (5.6) with $\alpha_0,\alpha_1$ written out:
$\frac23(2^{2+\beta}-3)-4(2^{2+\beta}-5)x-8(3-2^{1+\beta})x^2$. -/
noncomputable def Q1f (β x : ℝ) : ℝ :=
  2 / 3 * (2 ^ (2 + β) - 3) - 4 * (2 ^ (2 + β) - 5) * x - 8 * (3 - 2 ^ (1 + β)) * x ^ 2

/-- The right-hand side of (5.7) with $\alpha_0,\alpha_1$ written out:
$-4(2^{2+\beta}-5)-16(3-2^{1+\beta})x$. -/
noncomputable def Q2f (β x : ℝ) : ℝ := -4 * (2 ^ (2 + β) - 5) - 16 * (3 - 2 ^ (1 + β)) * x

/-- $2^{\beta+c}=2^c2^\beta$. -/
theorem two_rpow_add' (β c : ℝ) : (2 : ℝ) ^ (β + c) = 2 ^ c * 2 ^ β := by
  rw [rpow_add two_pos, mul_comm]

/-- $2^{c+\beta}=2^c2^\beta$. -/
theorem two_rpow_add'' (β c : ℝ) : (2 : ℝ) ^ (c + β) = 2 ^ c * 2 ^ β := by
  rw [rpow_add two_pos]

/-- $Q_\beta(x)$ is affine in $2^\beta$. -/
theorem Q_eq_affine (β x : ℝ) :
    Q β x = 2 / 3 * x * (1 - x) * (-3 + 12 * x) + 2 / 3 * x * (1 - x) * (4 - 8 * x) * 2 ^ β := by
  rw [Q, two_rpow_add', two_rpow_add']; norm_num; ring

/-- $Q_\beta'(x)$ (as `Q1f`) is affine in $2^\beta$. -/
theorem Q1f_eq_affine (β x : ℝ) :
    Q1f β x = (-2 + 20 * x - 24 * x ^ 2) + (8 / 3 - 16 * x + 16 * x ^ 2) * 2 ^ β := by
  rw [Q1f, two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- $Q_\beta''(x)$ (as `Q2f`) is affine in $2^\beta$. -/
theorem Q2f_eq_affine (β x : ℝ) :
    Q2f β x = (20 - 48 * x) + (-16 + 32 * x) * 2 ^ β := by
  rw [Q2f, two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- Derivative of $\beta\mapsto p+q2^\beta$. -/
theorem hasDerivAt_two_rpow_affine (p q β : ℝ) :
    HasDerivAt (fun β' ↦ p + q * (2 : ℝ) ^ β') (q * log 2 * 2 ^ β) β := by
  have h := ((hasDerivAt_id' β).const_rpow two_pos).const_mul q |>.const_add p
  convert h using 1; ring

/-- $Q_\beta'=$ `Q1f`. -/
theorem hasDerivAt_Q (β x : ℝ) : HasDerivAt (Q β) (Q1f β x) x := by
  have h := ((((hasDerivAt_id' x).const_mul (2 / 3)).mul ((hasDerivAt_id' x).const_sub 1)).mul
    (((hasDerivAt_id' x).const_mul (4 * (3 - (2 : ℝ) ^ (β + 1)))).const_add
      ((2 : ℝ) ^ (β + 2) - 3)))
  refine h.congr_deriv ?_
  rw [Q1f, two_rpow_add', two_rpow_add', two_rpow_add'', two_rpow_add'']; norm_num; ring

/-- $Q_\beta''=$ `Q2f`. -/
theorem hasDerivAt_Q1f (β x : ℝ) : HasDerivAt (Q1f β) (Q2f β x) x := by
  have h := (((hasDerivAt_id' x).const_mul (4 * ((2 : ℝ) ^ (2 + β) - 5))).const_sub
    (2 / 3 * ((2 : ℝ) ^ (2 + β) - 3))).sub
    ((hasDerivAt_pow 2 x).const_mul (8 * (3 - (2 : ℝ) ^ (1 + β))))
  refine h.congr_deriv ?_
  rw [Q2f]; push_cast; ring

/-- $Q_\beta'''=-16(3-2^{1+\beta})$. -/
theorem hasDerivAt_Q2f (β x : ℝ) : HasDerivAt (Q2f β) (-16 * (3 - 2 ^ (1 + β))) x := by
  have h := ((hasDerivAt_id' x).const_mul (16 * (3 - (2 : ℝ) ^ (1 + β)))).const_sub
    (-4 * ((2 : ℝ) ^ (2 + β) - 5))
  refine h.congr_deriv ?_
  ring

/-- `deriv (Q β) = Q1f β`. -/
theorem deriv_Q_eq (β : ℝ) : deriv (Q β) = Q1f β := funext fun x ↦ (hasDerivAt_Q β x).deriv

/-- `deriv (deriv (Q β)) = Q2f β`. -/
theorem deriv2_Q_eq (β : ℝ) : deriv (deriv (Q β)) = Q2f β := by
  rw [deriv_Q_eq]; exact funext fun x ↦ (hasDerivAt_Q1f β x).deriv

/-- $Q_\beta'''=-16(3-2^{1+\beta})$. -/
theorem deriv3_Q_eq (β : ℝ) :
    deriv (deriv (deriv (Q β))) = fun _ ↦ -16 * (3 - (2 : ℝ) ^ (1 + β)) := by
  rw [deriv2_Q_eq]; exact funext fun x ↦ (hasDerivAt_Q2f β x).deriv

/-- $Q_\beta$ is continuous. -/
theorem continuous_Q (β : ℝ) : Continuous (Q β) := by
  unfold Q; fun_prop

/-- For $x\in(0,e^{-1})$, $\log\frac1x>1$. -/
theorem one_lt_log_inv_of_mem {x : ℝ} (hx : x ∈ Ioo 0 (exp (-1))) : 1 < log x⁻¹ := by
  have := log_lt_log hx.1 hx.2
  rw [log_exp] at this
  rw [log_inv]; linarith

/-- $\log\frac1{\log2}>0$. -/
theorem log_inv_log_two_pos : 0 < log (log 2)⁻¹ := by
  have hl : 0 < log 2 := log_pos one_lt_two
  have hl1 : log 2 < 1 := by linarith [log_two_lt_d9]
  exact log_pos ((one_lt_inv₀ hl).2 hl1)

/-- The $\beta$-derivative of $\log(-L''_\beta(x))$, with $L''_\beta$ written as `L2f`:
$\beta^{-1}-\log\log2+\log\log\frac1x-(1-\beta+\log\frac1x)^{-1}$. -/
theorem hasDerivAt_log_neg_L2f {x β : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hβ : 0 < β)
    (hβu : 0 < 1 - β + log x⁻¹) :
    HasDerivAt (fun β' ↦ log (-L2f β' x))
      (β⁻¹ - log (log 2) + log (log x⁻¹) - (1 - β + log x⁻¹)⁻¹) β := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  have hx0 : x ≠ 0 := hx.1.ne'
  have hf : (fun β' ↦ log (-L2f β' x)) = fun β' ↦
      log (β' * (log 2) ^ (-β') * x⁻¹ * (log x⁻¹) ^ (-2 + β') * (1 - β' + log x⁻¹)) := by
    funext β'; congr 1; simp only [L2f]; ring
  rw [hf]
  have h1 := (hasDerivAt_id' β).neg.const_rpow hl
  have h2 := ((hasDerivAt_id' β).const_add (-2)).const_rpow hu
  have h := (((((hasDerivAt_id' β).mul h1).mul_const x⁻¹).mul h2).mul
    ((hasDerivAt_id' β).const_sub (1 + log x⁻¹)))
  have hP : 0 < β * (log 2) ^ (-β) * x⁻¹ * (log x⁻¹) ^ (-2 + β) * (1 - β + log x⁻¹) := by
    have := rpow_pos_of_pos hl (-β)
    have := rpow_pos_of_pos hu (-2 + β)
    have := inv_pos.2 hx.1
    positivity
  have h' := h.log (by
    simp only [Pi.mul_apply, Pi.neg_apply]
    rw [show 1 + log x⁻¹ - β = 1 - β + log x⁻¹ by ring]; exact hP.ne')
  refine (h'.congr_of_eventuallyEq (Eventually.of_forall fun b ↦ ?_)).congr_deriv ?_
  · simp only [Pi.mul_apply, Pi.neg_apply]; congr 1; ring
  have hA : (log 2) ^ (-β) ≠ 0 := (rpow_pos_of_pos hl _).ne'
  have hB : (log x⁻¹) ^ (-2 + β) ≠ 0 := (rpow_pos_of_pos hu _).ne'
  have hC : 1 + log x⁻¹ - β ≠ 0 := by linarith
  have hC' : 1 - β + log x⁻¹ ≠ 0 := hβu.ne'
  simp only [Pi.mul_apply, Pi.neg_apply]
  generalize (log 2) ^ (-β) = A at hA ⊢
  generalize (log x⁻¹) ^ (-2 + β) = B at hB ⊢
  generalize log x⁻¹ = u at hC hC' ⊢
  have hβ0 : β ≠ 0 := hβ.ne'
  have hD : 1 - β + u = 1 + u - β := by ring
  rw [hD] at hC' ⊢
  field_simp
  ring

/-- $-L''_\beta(x)=\beta(1-\beta+\log\frac1x)\,x^{-1}(\log\frac1x)^{-2}(\log\frac1x/\log2)^\beta$
on $(0,1)$ (with $L''_\beta$ written as `L2f`). -/
theorem neg_L2f_eq {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    -L2f β x = β * (1 - β + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) *
      (log x⁻¹ / log 2) ^ β := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L2f, div_rpow hu.le hl.le, rpow_neg hl.le, rpow_add hu]
  ring

/-- $L'''_\beta(x)=\beta(\log\frac1x/\log2)^\beta\,x^{-2}(\log\frac1x)^{-3}
(\beta(3-\beta)-2+(\log\frac1x)^2)$ on $(0,1)$ (with $L'''_\beta$ written as `L3f`). -/
theorem L3f_eq_alt {β x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    L3f β x = β * (log x⁻¹ / log 2) ^ β * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) *
      (β * (3 - β) - 2 + (log x⁻¹) ^ 2) := by
  have hu : 0 < log x⁻¹ := log_pos ((one_lt_inv₀ hx.1).2 hx.2)
  have hl : 0 < log 2 := log_pos one_lt_two
  rw [L3f, div_rpow hu.le hl.le, rpow_neg hl.le, rpow_add hu]
  ring

/-- For $\log2\le\log\frac1x$, $\beta\mapsto(\log\frac1x/\log2)^\beta$ is monotone. -/
theorem ratio_rpow_mono {x b₁ b₂ : ℝ} (hlu : log 2 ≤ log x⁻¹) (hle : b₁ ≤ b₂) :
    (log x⁻¹ / log 2) ^ b₁ ≤ (log x⁻¹ / log 2) ^ b₂ := by
  have hl : 0 < log 2 := log_pos one_lt_two
  exact rpow_le_rpow_of_exponent_le ((one_le_div hl).2 hlu) hle

/-- For $x\in(0,e^{-1})$, $\beta\mapsto L''_\beta(x)$ (as `L2f`) is antitone on $[\frac12,1]$. -/
theorem L2f_antitoneOn {x : ℝ} (hx : x ∈ Ioo 0 (exp (-1))) :
    AntitoneOn (fun β ↦ L2f β x) (Icc 2⁻¹ 1) := by
  have he : exp (-1) < 1 := by rw [exp_lt_one_iff]; norm_num
  have hx1 : x ∈ Ioo (0 : ℝ) 1 := ⟨hx.1, hx.2.trans he⟩
  have hu1 : 1 < log x⁻¹ := one_lt_log_inv_of_mem hx
  have hl1 : log 2 < 1 := by linarith [log_two_lt_d9]
  have hu : 0 < log x⁻¹ := by linarith
  intro b₁ hb₁ b₂ hb₂ hle
  have h1 := neg_L2f_eq (β := b₁) hx1
  have h2 := neg_L2f_eq (β := b₂) hx1
  have hr := ratio_rpow_mono (x := x) (by linarith) hle
  have hK : 0 < x⁻¹ * (log x⁻¹) ^ (-2 : ℝ) :=
    mul_pos (inv_pos.2 hx.1) (rpow_pos_of_pos hu _)
  have hp : b₁ * (1 - b₁ + log x⁻¹) ≤ b₂ * (1 - b₂ + log x⁻¹) := by
    nlinarith [hb₁.1, hb₂.2]
  have hp0 : 0 ≤ b₁ * (1 - b₁ + log x⁻¹) := by
    have : (0 : ℝ) ≤ b₁ := by linarith [hb₁.1]
    have : (0 : ℝ) ≤ 1 - b₁ + log x⁻¹ := by linarith [hb₁.2]
    positivity
  have hr0 : 0 ≤ (log x⁻¹ / log 2) ^ b₁ := rpow_nonneg (by positivity) _
  show L2f b₂ x ≤ L2f b₁ x
  have : b₁ * (1 - b₁ + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) * (log x⁻¹ / log 2) ^ b₁ ≤
      b₂ * (1 - b₂ + log x⁻¹) * (x⁻¹ * (log x⁻¹) ^ (-2 : ℝ)) * (log x⁻¹ / log 2) ^ b₂ := by
    apply mul_le_mul _ hr hr0 (by nlinarith)
    exact mul_le_mul_of_nonneg_right hp hK.le
  linarith

/-- For $x\in(0,1)$ with $\log2\le\log\frac1x$ and $\beta(3-\beta)-2+(\log\frac1x)^2>0$ on
$[\frac12,1]$, $\beta\mapsto L'''_\beta(x)$ (as `L3f`) is monotone on $[\frac12,1]$. -/
theorem L3f_monotoneOn {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) (hlu : log 2 ≤ log x⁻¹)
    (hpos : ∀ β ∈ Icc (2⁻¹ : ℝ) 1, 0 < β * (3 - β) - 2 + (log x⁻¹) ^ 2) :
    MonotoneOn (fun β ↦ L3f β x) (Icc 2⁻¹ 1) := by
  have hl : 0 < log 2 := log_pos one_lt_two
  have hu : 0 < log x⁻¹ := by linarith
  intro b₁ hb₁ b₂ hb₂ hle
  show L3f b₁ x ≤ L3f b₂ x
  rw [L3f_eq_alt hx, L3f_eq_alt hx]
  have hr := ratio_rpow_mono (x := x) hlu hle
  have hK : 0 < x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ) :=
    mul_pos (zpow_pos hx.1 _) (rpow_pos_of_pos hu _)
  have hr0 : 0 ≤ (log x⁻¹ / log 2) ^ b₁ := rpow_nonneg (by positivity) _
  have hk : b₁ * (3 - b₁) - 2 + (log x⁻¹) ^ 2 ≤ b₂ * (3 - b₂) - 2 + (log x⁻¹) ^ 2 := by
    nlinarith [hb₁.1, hb₂.2]
  have hk0 := hpos b₁ hb₁
  have hb0 : (0 : ℝ) ≤ b₁ := by linarith [hb₁.1]
  have h1 : b₁ * (log x⁻¹ / log 2) ^ b₁ ≤ b₂ * (log x⁻¹ / log 2) ^ b₂ :=
    mul_le_mul hle hr hr0 (by linarith)
  have h2 : b₁ * (log x⁻¹ / log 2) ^ b₁ * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) ≤
      b₂ * (log x⁻¹ / log 2) ^ b₂ * (x ^ (-2 : ℤ) * (log x⁻¹) ^ (-3 : ℝ)) :=
    mul_le_mul_of_nonneg_right h1 hK.le
  exact mul_le_mul h2 hk hk0.le (mul_nonneg (mul_nonneg (by linarith)
    (rpow_nonneg (by positivity) _)) hK.le)

/-- Powers of two: $2^{1+\beta}=2\cdot2^\beta$. -/
theorem two_rpow_one_add (β : ℝ) : (2 : ℝ) ^ (1 + β) = 2 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{\beta+1}=2\cdot2^\beta$. -/
theorem two_rpow_add_one' (β : ℝ) : (2 : ℝ) ^ (β + 1) = 2 * 2 ^ β := by
  rw [two_rpow_add']; norm_num

/-- Powers of two: $2^{2+\beta}=4\cdot2^\beta$. -/
theorem two_rpow_two_add (β : ℝ) : (2 : ℝ) ^ (2 + β) = 4 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{\beta+2}=4\cdot2^\beta$. -/
theorem two_rpow_add_two (β : ℝ) : (2 : ℝ) ^ (β + 2) = 4 * 2 ^ β := by
  rw [two_rpow_add']; norm_num

/-- Powers of two: $2^{3+\beta}=8\cdot2^\beta$. -/
theorem two_rpow_three_add (β : ℝ) : (2 : ℝ) ^ (3 + β) = 8 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- Powers of two: $2^{4+\beta}=16\cdot2^\beta$. -/
theorem two_rpow_four_add (β : ℝ) : (2 : ℝ) ^ (4 + β) = 16 * 2 ^ β := by
  rw [two_rpow_add'']; norm_num

/-- For $\beta\ge\frac12$, $2^\beta>1.414$. -/
theorem two_rpow_gt_of_half_le {β : ℝ} (hβ : 2⁻¹ ≤ β) : (1.414 : ℝ) < 2 ^ β := by
  have h1 : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le one_le_two hβ
  have h2 : (2 : ℝ) ^ (2⁻¹ : ℝ) = √2 := by rw [sqrt_eq_rpow]; norm_num
  have h3 : (1.414 : ℝ) < √2 := by rw [lt_sqrt (by norm_num)]; norm_num
  linarith

/-- For $\beta\le1$, $2^\beta\le2$. -/
theorem two_rpow_le_two_of_le_one {β : ℝ} (hβ : β ≤ 1) : (2 : ℝ) ^ β ≤ 2 := by
  have := rpow_le_rpow_of_exponent_le one_le_two hβ
  simpa using this

end Auto.DIR

/-!
## [DIR] §6.5 Case $QJQ$: auxiliary lemmas

Auxiliary results for `6_5_Case_QJQ.lean`: elementary identities for powers of $2$ and
numerical bounds for $2^\beta$, $\beta\in[\frac12,\beta_1]$, used for the polynomial $p_\beta$.
-/

namespace Auto.DIR

open Real Set

/-- Bounds for $2^\beta$ on $[\frac12,\beta_1]$ (with $\beta_1=\frac12+\frac{31}{1024}$, see
`Auto.DIR.β₁`): $1.414\le2^\beta\le1.44421$. The upper bound uses
$(2^{\beta_1})^{1024}=2^{543}\le1.44421^{1024}$, checked by kernel evaluation of natural
numbers. -/
theorem two_rpow_bounds (β : ℝ) (hβ : β ∈ Icc (2⁻¹ : ℝ) (2⁻¹ + 31 / 1024)) :
    (1414 / 1000 : ℝ) ≤ 2 ^ β ∧ (2 : ℝ) ^ β ≤ 144421 / 100000 := by
  constructor
  · have h1 : (2 : ℝ) ^ (2⁻¹ : ℝ) ≤ 2 ^ β := rpow_le_rpow_of_exponent_le (by norm_num) hβ.1
    have h2 : ((2 : ℝ) ^ (2⁻¹ : ℝ)) ^ (2 : ℕ) = 2 := by
      rw [← rpow_natCast, ← rpow_mul (by norm_num)]; norm_num
    have h3 : 0 ≤ (2 : ℝ) ^ (2⁻¹ : ℝ) := by positivity
    nlinarith
  · have h1 : (2 : ℝ) ^ β ≤ 2 ^ ((2⁻¹ : ℝ) + 31 / 1024) :=
      rpow_le_rpow_of_exponent_le (by norm_num) hβ.2
    refine h1.trans ?_
    have h : ((2:ℝ) ^ ((2⁻¹ : ℝ) + 31 / 1024)) ^ (1024:ℕ) = 2 ^ (543:ℕ) := by
      rw [← rpow_natCast, ← rpow_mul (by norm_num)]; norm_num
    rw [← pow_le_pow_iff_left₀ (by positivity) (by norm_num) (by norm_num : (1024:ℕ) ≠ 0), h,
      div_pow, le_div_iff₀ (by positivity)]
    have : (2:ℕ) ^ 543 * 100000 ^ 1024 ≤ 144421 ^ 1024 := by decide +kernel
    exact_mod_cast this

/-- $2^{c+\beta}=2^c\,2^\beta$. -/
theorem two_rpow_add (c β : ℝ) : (2 : ℝ) ^ (c + β) = 2 ^ c * 2 ^ β :=
  rpow_add two_pos c β

/-- $2^{2\beta}=(2^\beta)^2$. -/
theorem two_rpow_two_mul (β : ℝ) : (2 : ℝ) ^ (2 * β) = (2 ^ β) ^ 2 := by
  rw [mul_comm 2 β, rpow_mul (by norm_num)]; norm_num

end Auto.DIR
