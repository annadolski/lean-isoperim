/-- For $c\ge\frac12$ and $1\le u\le v$: $\frac{\frac12\log v+c}{v}\le\frac{\frac12\log u+c}{u}$
(the error term $\varepsilon$ is decreasing in $u=\log(w/x)$). -/
theorem eps_antitone_aux {c u v : ℝ} (hc : 2⁻¹ ≤ c) (hu : 1 ≤ u) (huv : u ≤ v) :
    (2⁻¹ * log v + c) / v ≤ (2⁻¹ * log u + c) / u := by
  have hu0 : 0 < u := by linarith
  have hv0 : 0 < v := by linarith
  rw [div_le_div_iff₀ hv0 hu0]
  have h1 : log v ≤ log u + (v - u) / u := by
    have := log_le_sub_one_of_pos (div_pos hv0 hu0)
    rw [log_div hv0.ne' hu0.ne'] at this
    have e : v / u - 1 = (v - u) / u := by field_simp
    linarith
  have h2 : 0 ≤ log u := log_nonneg hu
  have h3 : u * log v ≤ u * log u + (v - u) := by
    have := mul_le_mul_of_nonneg_left h1 hu0.le
    rwa [mul_add, mul_div_cancel₀ _ hu0.ne'] at this
  have h4 : 0 ≤ (v - u) * (2⁻¹ * log u + c - 2⁻¹) :=
    mul_nonneg (sub_nonneg.2 huv) (by linarith)
  nlinarith

/-- If $e^u\ge57$, then $4\pi u<e^u$. -/
theorem four_pi_mul_lt_exp {u : ℝ} (hu : 57 ≤ exp u) : 4 * π * u < exp u := by
  have hπ := pi_lt_d2
  have hπ0 := pi_pos
  rcases le_or_gt u 4.1 with h | h
  · nlinarith
  · have he4 : (60 : ℝ) ≤ exp 4.1 := by
      have e1 : exp (4.1 : ℝ) = exp 1 ^ 4 * exp 0.1 := by
        rw [← exp_nat_mul, ← exp_add]; norm_num
      have he := exp_one_gt_d9
      have h1 : (2.7182818283 : ℝ) ^ 4 < exp 1 ^ 4 := by gcongr
      have h2 := add_one_le_exp (0.1 : ℝ)
      rw [e1]
      have h3 : (0 : ℝ) < exp 1 ^ 4 := by positivity
      nlinarith
    have h1 : exp u = exp 4.1 * exp (u - 4.1) := by rw [← exp_add]; ring_nf
    have h2 := add_one_le_exp (u - 4.1)
    have h3 : 0 < exp (u - 4.1) := exp_pos _
    rw [h1]
    nlinarith

/-- If $e^u\ge57$, then $\frac{\frac12\log u+\log(2\pi^{1/2})}{u}<\frac12$. -/
theorem eps_lt_half_aux {u : ℝ} (hu : 57 ≤ exp u) :
    (2⁻¹ * log u + log (2 * π ^ (2⁻¹ : ℝ))) / u < 2⁻¹ := by
  have hu0 : 0 < u := by
    by_contra h
    have := exp_le_one_iff.2 (not_lt.1 h)
    linarith
  have hπ : π ^ (2⁻¹ : ℝ) = √π := by rw [sqrt_eq_rpow, one_div]
  have hk := four_pi_mul_lt_exp hu
  have hl : log (4 * π * u) < u := by
    rw [log_lt_iff_lt_exp (by positivity)]; exact hk
  have hl2 : log (4 * π * u) = 2 * log (2 * π ^ (2⁻¹ : ℝ)) + log u := by
    have h4 : (4 : ℝ) * π = (2 * √π) ^ 2 := by rw [mul_pow, sq_sqrt pi_pos.le]; norm_num
    rw [hπ, log_mul (by positivity) hu0.ne', h4, log_pow]
    push_cast; ring
  rw [div_lt_iff₀ hu0]
  linarith

/-- Certified rational bounds $a\le\log q\le b$ from the enclosure `Checker.logIv` of the
verified checker (one kernel evaluation of the Boolean side condition). -/
theorem log_mem_of_logIv (P : Checker.Params) (q a b : ℚ)
    (h : (match Checker.logIv P q with
      | some I => decide (a ≤ I.1 ∧ I.2 ≤ b)
      | none => false) = true) :
    (a : ℝ) ≤ log q ∧ log q ≤ b := by
  rcases hI : Checker.logIv P q with _ | I
  · rw [hI] at h; cases h
  · rw [hI] at h
    obtain ⟨h1, h2⟩ := of_decide_eq_true h
    obtain ⟨-, m1, m2⟩ := Checker.logIv_sound P hI
    exact ⟨(by exact_mod_cast h1 : (a : ℝ) ≤ I.1).trans m1,
      m2.trans (by exact_mod_cast h2 : (I.2 : ℝ) ≤ b)⟩

