/-- $s\mapsto e^{-s^2/2}$ is integrable. -/
theorem integrable_exp_neg_sq_half : Integrable (fun s : ℝ ↦ exp (-s ^ 2 / 2)) := by
  have := integrable_exp_neg_mul_sq (b := 2⁻¹) (by norm_num)
  refine this.congr (ae_of_all _ fun s ↦ ?_)
  simp only
  congr 1
  ring

/-- For $t<0$, $s\mapsto s^{-2}e^{-s^2/2}$ is integrable on $(-\infty,t]$. -/
theorem integrableOn_zpow_mul_exp {t : ℝ} (ht : t < 0) :
    IntegrableOn (fun s : ℝ ↦ s ^ (-2 : ℤ) * exp (-s ^ 2 / 2)) (Iic t) := by
  refine Integrable.mono' (integrable_exp_neg_sq_half.integrableOn.const_mul (t ^ (-2 : ℤ)))
    ?_ ?_
  · refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Iic
    refine ContinuousOn.mul ?_ (by fun_prop)
    exact continuousOn_id.zpow₀ _ fun s hs ↦ Or.inl (by simp at hs ⊢; linarith)
  · refine ae_restrict_of_forall_mem measurableSet_Iic fun s hs ↦ ?_
    simp only [mem_Iic] at hs
    have hs0 : s < 0 := hs.trans_lt ht
    rw [Real.norm_eq_abs, abs_mul, abs_of_pos (exp_pos _)]
    refine mul_le_mul_of_nonneg_right ?_ (exp_pos _).le
    simp only [zpow_neg, zpow_two]
    rw [abs_inv, abs_mul]
    rw [abs_of_neg hs0]
    exact inv_anti₀ (mul_pos_of_neg_of_neg ht ht) (by nlinarith)

/-- $e^{-s^2/2}\to0$ as $s\to-\infty$. -/
theorem tendsto_exp_neg_sq_half_atBot :
    Tendsto (fun s : ℝ ↦ exp (-s ^ 2 / 2)) atBot (𝓝 0) := by
  refine tendsto_exp_atBot.comp (tendsto_atBot_mono' atBot ?_ tendsto_id)
  filter_upwards [eventually_le_atBot (-2 : ℝ)] with s hs
  simp only [id]
  nlinarith

/-- [DIR], proof of Proposition 5.11: integration by parts. -/
theorem integral_Iic_exp_ibp (t : ℝ) (ht : t < 0) :
    ∫ s in Iic t, exp (-s ^ 2 / 2) = -t⁻¹ * exp (-t ^ 2 / 2) - ∫ s in Iic t, s ^ (-2 : ℤ) *
        exp (-s ^ 2 / 2) := by
  have hF : ∀ s ∈ Iio t, HasDerivAt (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2))
      (exp (-s ^ 2 / 2) + s ^ (-2 : ℤ) * exp (-s ^ 2 / 2)) s := by
    intro s hs
    have hs0 : s ≠ 0 := by simp at hs; linarith
    have h1 : HasDerivAt (fun s : ℝ ↦ -s⁻¹) ((s ^ 2)⁻¹) s := by
      simpa using (hasDerivAt_inv hs0).fun_neg
    have h3 : HasDerivAt (fun s : ℝ ↦ -s ^ 2 / 2) (-s) s := by
      have := (hasDerivAt_pow 2 s).const_mul (-1 / 2 : ℝ)
      convert this using 1
      · ext y; ring
      · push_cast; ring
    have h2 : HasDerivAt (fun s : ℝ ↦ exp (-s ^ 2 / 2)) (exp (-s ^ 2 / 2) * (-s)) s :=
      h3.exp
    convert h1.mul h2 using 1
    simp only [zpow_neg, zpow_two]
    field_simp
    ring
  have hint := (integrable_exp_neg_sq_half.integrableOn (s := Iic t)).add
    (integrableOn_zpow_mul_exp ht)
  have hlim : Tendsto (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2)) atBot (𝓝 0) := by
    have := (tendsto_inv_atBot_zero.neg).mul tendsto_exp_neg_sq_half_atBot
    simpa using this
  have hcont : ContinuousWithinAt (fun s : ℝ ↦ -s⁻¹ * exp (-s ^ 2 / 2)) (Iic t) t := by
    refine ContinuousAt.continuousWithinAt ?_
    exact ((continuousAt_inv₀ ht.ne).neg).mul (by fun_prop)
  have h := integral_Iic_of_hasDerivAt_of_tendsto hcont hF hint hlim
  rw [integral_add integrable_exp_neg_sq_half.integrableOn (integrableOn_zpow_mul_exp ht)] at h
  linarith


/-- $\exp(1.6)<5$, i.e. $\log5>1.6$. -/
theorem log_five_gt : (1.6 : ℝ) < log 5 := by
  rw [lt_log_iff_exp_lt (by norm_num)]
  have h8 : exp (1.6 : ℝ) ^ 5 = exp 1 ^ 8 := by
    rw [← exp_nat_mul, ← exp_nat_mul]; norm_num
  have he := exp_one_lt_d9
  have h1 : exp 1 ^ 8 < (2.7182818286 : ℝ) ^ 8 := by gcongr
  have h2 : exp (1.6 : ℝ) ^ 5 < 5 ^ 5 := by
    rw [h8]; linarith [h1, show (2.7182818286 : ℝ) ^ 8 < 5 ^ 5 by norm_num]
  exact lt_of_pow_lt_pow_left₀ 5 (by norm_num) h2

/-- $\exp(3.2)>24$. -/
theorem exp_three_two_gt : (24 : ℝ) < exp 3.2 := by
  have h : exp (3.2 : ℝ) = exp 1 ^ 3 * exp 0.2 := by
    rw [← exp_nat_mul, ← exp_add]; norm_num
  have he := exp_one_gt_d9
  have h1 : (2.7182818283 : ℝ) ^ 3 < exp 1 ^ 3 := by gcongr
  have h2 := quadratic_le_exp_of_nonneg (x := (0.2 : ℝ)) (by norm_num)
  rw [h]
  have h3 : (0 : ℝ) < exp 1 ^ 3 := by positivity
  nlinarith

/-- For $y\ge1.6$: $\frac{\log(2\pi^{1/2})}{y}+\frac12\frac{\log y}{y}<1$ (the bound
$\varepsilon<1$ in the proof of Proposition 5.11). -/
theorem eps_lt_one_of_ge {y : ℝ} (hy : 1.6 ≤ y) :
    log (2 * π ^ (2⁻¹ : ℝ)) / y + 2⁻¹ * (log y / y) < 1 := by
  have hy0 : 0 < y := by linarith
  have hπ : π ^ (2⁻¹ : ℝ) = √π := by rw [sqrt_eq_rpow, one_div]
  rw [hπ]
  have hkey : log (2 * √π) + 2⁻¹ * log y < y := by
    have heq : log (2 * √π) + 2⁻¹ * log y = log (2 * √π * √y) := by
      rw [log_mul (x := 2 * √π) (y := √y) (by positivity) (by positivity), log_sqrt hy0.le]
      ring
    rw [heq, log_lt_iff_lt_exp (by positivity)]
    refine lt_of_pow_lt_pow_left₀ 2 (exp_pos y).le ?_
    have hl : (2 * √π * √y) ^ 2 = 4 * π * y := by
      rw [mul_pow, mul_pow, sq_sqrt pi_pos.le, sq_sqrt hy0.le]; ring
    have hr : exp y ^ 2 = exp 3.2 * exp (2 * y - 3.2) := by
      rw [← exp_nat_mul, ← exp_add]; norm_num
    rw [hl, hr]
    have h1 := add_one_le_exp (2 * y - 3.2)
    have h2 := exp_three_two_gt
    have h3 := pi_lt_d2
    nlinarith
  have : log (2 * √π) / y + 2⁻¹ * (log y / y) = (log (2 * √π) + 2⁻¹ * log y) / y := by
    ring
  rw [this, div_lt_one hy0]
  exact hkey

/-- The cubic Taylor lower bound $e^{-v}\ge1-v+v^2/2-v^3/6$ for $v\ge0$. -/
theorem exp_neg_ge_cubic {v : ℝ} (hv : 0 ≤ v) : 1 - v + v ^ 2 / 2 - v ^ 3 / 6 ≤ exp (-v) := by
  have h := expNegTaylor_le_exp_neg 1 hv
  simp only [expNegTaylor, Finset.sum_range_succ, Finset.sum_range_zero] at h
  norm_num [Nat.factorial] at h
  linarith

