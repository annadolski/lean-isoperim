/-- For $0<x\le\frac15$ there is $t<0$ with $|t|^{-1}\varphi(t)=x$ (intermediate value
theorem; implicit in [DIR], proof of Proposition 5.11). -/
theorem exists_neg_abs_inv_mul_gDens (x : ℝ) (hx : x ∈ Ioc (0 : ℝ) 5⁻¹) :
    ∃ t < 0, |t|⁻¹ * gDens t = x := by
  obtain ⟨hx0, hx1⟩ := hx
  have hc : ContinuousOn (fun t : ℝ ↦ |t|⁻¹ * gDens t) (Icc (-x⁻¹) (-1)) := by
    refine ContinuousOn.mul ?_ continuous_gDens.continuousOn
    refine (continuous_abs.continuousOn).inv₀ fun t ht ↦ ?_
    have := ht.2
    rw [abs_ne_zero]; linarith
  have hab : -x⁻¹ ≤ -1 := by
    rw [neg_le_neg_iff, one_le_inv₀ hx0]; linarith
  have ha : |-x⁻¹|⁻¹ * gDens (-x⁻¹) ≤ x := by
    rw [abs_neg, abs_of_pos (inv_pos.2 hx0), inv_inv]
    have : gDens (-x⁻¹) ≤ 1 := by
      unfold gDens
      have h1 : exp (-(-x⁻¹) ^ 2 / 2) ≤ 1 := exp_le_one_iff.2 (by nlinarith [sq_nonneg x⁻¹])
      nlinarith [gConst_lt_one, gConst_pos, exp_pos (-(-x⁻¹) ^ 2 / 2)]
    nlinarith
  have hb : x ≤ (fun t : ℝ ↦ |t|⁻¹ * gDens t) (-1) := by
    simp only
    have h1 := exp_neg_ge_cubic (v := 2⁻¹) (by norm_num)
    have h2 := gConst_gt
    simp only [abs_neg, abs_one, inv_one, one_mul, gDens]
    have h3 : -(-1 : ℝ) ^ 2 / 2 = -2⁻¹ := by norm_num
    rw [h3]
    nlinarith
  obtain ⟨t, ht, hte⟩ := intermediate_value_Icc hab hc ⟨ha, hb⟩
  exact ⟨t, by linarith [ht.2], hte⟩

/-- $\log(2\pi^{1/2})\ge\frac12$. -/
theorem half_le_log_two_mul_sqrt_pi : 2⁻¹ ≤ log (2 * π ^ (2⁻¹ : ℝ)) := by
