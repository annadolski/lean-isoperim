  have ha := gJw_antitoneOn_right
  have hxI : x ∈ Icc (2⁻¹ : ℝ) 1 := ⟨hxl.trans hx.1, hx.2.trans hxu⟩
  have hx0I : x₀ ∈ Icc (2⁻¹ : ℝ) 1 := ⟨by linarith [hx0.1], by linarith [hx0.2]⟩
